    <Style x:Key="NavigationIconStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SelectedNavigationIconStyle" TargetType="Path" BasedOn="{StaticResource NavigationIconStyle}">
        <Setter Property="Fill" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>
