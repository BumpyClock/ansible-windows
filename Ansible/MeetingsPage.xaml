<Page x:Class="Ansible.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <local:PageCanvas Scrollable="False" Title="Meetings"
                      Subtitle="Your conversations, transcribed on this device.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="NewMeetingButton" Content="Start meeting" MinHeight="40" Padding="20,8"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="NewMeetingClicked" AutomationProperties.AutomationId="StartMeeting" />
        </local:PageCanvas.HeaderActions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="ErrorBar" Grid.Row="0" Margin="{StaticResource PageSectionBottomMargin}" Severity="Error" IsOpen="False" IsClosable="True"
                 Visibility="Collapsed" Closing="ErrorBarClosing"/>
            <TextBlock Grid.Row="1" Text="Transcripts save automatically. Audio is never saved."
                       Style="{StaticResource CaptionSecondaryStyle}" Margin="0,0,0,12" />
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                <StackPanel x:Name="UnreadableMeetings" Padding="{StaticResource HistoryListPadding}" Spacing="12" Visibility="Collapsed"/>
            </ScrollViewer>
            <ListView x:Name="MeetingList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MeetingClicked"
                      Visibility="Collapsed" HorizontalContentAlignment="Stretch" Padding="{StaticResource HistoryListPadding}"
                      AutomationProperties.Name="Saved meetings">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MeetingHistoryRow">
                        <StackPanel Spacing="6" Padding="12,16">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionSecondaryStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="CornerRadius" Value="{StaticResource HistoryRowCornerRadius}"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="380">
                <FontIcon Glyph="&#xE8F2;" FontSize="32" Foreground="{ThemeResource AccentGraphicBrush}"/>
                <TextBlock Text="A place for your meetings" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Start a meeting to capture your microphone and meeting audio. Saved transcripts appear here." TextAlignment="Center" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
        </Grid>
        </Border>
        </Grid>
    </local:PageCanvas>
</Page>
