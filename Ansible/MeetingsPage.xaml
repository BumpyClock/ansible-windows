<Page x:Class="Ansible.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <DataTemplate x:Key="MeetingDayTemplate" x:DataType="local:MeetingDayHeader">
            <Grid Margin="0,12,0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource HistoryGroupLabelStyle}"
                           AutomationProperties.HeadingLevel="Level2"/>
                <Border Grid.Column="1" Style="{StaticResource HistoryDividerStyle}"/>
            </Grid>
        </DataTemplate>
        <!-- Every row has the same two text lines, so a status badge never changes its height. The row's hover fill
             extends 12 DIP left of the list so its text lines up with the day labels and the page heading. The row
             opens the meeting; the options button sits over the row's right padding as a sibling, never inside it,
             so the row stays the first button under MeetingGroups and each control keeps its own focus and name. -->
        <DataTemplate x:Key="MeetingRowTemplate" x:DataType="local:MeetingHistoryRow">
            <Grid>
                <Button Tag="{x:Bind Summary.Id}" Click="MeetingClicked" Style="{StaticResource SubtleButtonStyle}"
                        Margin="-12,0,0,0" Padding="12,8,44,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind AccessibleName}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- A finished meeting with nothing to read shows its title in the secondary colour, so
                             meetings with transcripts stand out. -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind local:MeetingsPage.VisibleIf(HasReadableTitle)}"/>
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind local:MeetingsPage.VisibleIf(IsEmpty)}"/>
                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionSecondaryStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- A badge appears only when the detail line does not already name the state: a failure that
                             kept saved text (critical icon), or a live or interrupted meeting with speech. -->
                        <local:Badge Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center"
                                     Visibility="{x:Bind local:MeetingsPage.VisibleIf(IsCriticalFailure)}">
                            <local:Badge.Icon>
                                <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </local:Badge.Icon>
                        </local:Badge>
                        <local:Badge Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center"
                                     Visibility="{x:Bind local:MeetingsPage.VisibleIf(HasNeutralStatus)}"/>
                    </Grid>
                </Button>
                <Button Tag="{x:Bind Summary.Id}" Click="MeetingOptionsClicked" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTipService.ToolTip="More options" AutomationProperties.Name="{x:Bind OptionsName}">
                    <FontIcon Glyph="&#xE712;" FontSize="16"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <local:PageCanvas Title="Meetings"
                      Subtitle="Transcribed on this device. Audio is never saved.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="NewMeetingButton" Click="NewMeetingClicked" Height="40" Padding="16,0"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    AutomationProperties.Name="Start meeting" AutomationProperties.AutomationId="StartMeeting">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="NewMeetingLabel" Text="Start meeting" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <!-- The overflow sits after the primary action, at the far edge above the row menus. Shown only while two or more finished meetings hold no speech (MeetingList.Empty); one empty meeting
                 is deleted from its row. -->
            <Button x:Name="MoreOptionsButton" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                    Visibility="Collapsed" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem x:Name="DeleteEmptyMenuItem" Text="Delete empty meetings…" Click="DeleteEmptyClicked">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout></Button.Flyout>
            </Button>
        </local:PageCanvas.HeaderActions>
        <!-- The list spans the page's content width, so the row options sit under the header actions. With no
             meetings, the shared empty state centres in the space under the heading. -->
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel x:Name="UnreadableMeetings" Spacing="12" Margin="0,0,0,8" Visibility="Collapsed"/>
            <!-- One flat list of day headers and rows: nested x:Bind item lists do not marshal to WinRT. -->
            <ItemsControl x:Name="MeetingGroups" Grid.Row="1" VerticalAlignment="Top" Visibility="Collapsed"
                          AutomationProperties.Name="Saved meetings">
                <ItemsControl.ItemTemplateSelector>
                    <local:MeetingListTemplateSelector DayTemplate="{StaticResource MeetingDayTemplate}"
                                                       RowTemplate="{StaticResource MeetingRowTemplate}" />
                </ItemsControl.ItemTemplateSelector>
            </ItemsControl>
            <!-- Top-aligned like every page empty state: the backplate sits 64 DIP under the header. -->
            <local:EmptyState x:Name="NoMeetings" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE8F2;"
                              VerticalAlignment="Top" Margin="0,20,0,0"
                              Title="No meetings yet"
                              Detail="Start a meeting to transcribe it on this device. When Teams starts using your microphone, Ansible offers to take notes."/>
        </Grid>
    </local:PageCanvas>
</Page>
