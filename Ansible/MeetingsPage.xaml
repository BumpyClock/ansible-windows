<Page x:Class="Ansible.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <DataTemplate x:Key="MeetingDayTemplate" x:DataType="local:MeetingDayHeader">
            <Grid Margin="0,12,0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource HistoryGroupLabelStyle}"
                           AutomationProperties.HeadingLevel="Level2"/>
                <Border Grid.Column="1" Style="{StaticResource HistoryDividerStyle}"/>
            </Grid>
        </DataTemplate>
        <!-- Every row has the same two text lines, so a status badge never changes its height. The row's hover fill
             extends 12 DIP left of the list so its text lines up with the day labels and the page heading. -->
        <DataTemplate x:Key="MeetingRowTemplate" x:DataType="local:MeetingHistoryRow">
            <Button Tag="{x:Bind Summary.Id}" Click="MeetingClicked" Style="{StaticResource SubtleButtonStyle}"
                    Margin="-12,0,0,0" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionSecondaryStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <local:Badge Grid.Column="1" Text="{x:Bind Status}"
                                 Visibility="{x:Bind local:MeetingsPage.VisibleIf(IsFailed)}">
                        <local:Badge.Icon>
                            <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </local:Badge.Icon>
                    </local:Badge>
                    <local:Badge Grid.Column="1" Text="{x:Bind Status}"
                                 Visibility="{x:Bind local:MeetingsPage.VisibleIf(HasNeutralStatus)}"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>
    <local:PageCanvas Title="Meetings"
                      Subtitle="Transcribed on this device. Audio is never saved.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="NewMeetingButton" Content="Start meeting" MinHeight="40" Padding="20,8"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="NewMeetingClicked" AutomationProperties.AutomationId="StartMeeting" />
        </local:PageCanvas.HeaderActions>
        <StackPanel>
            <!-- A reading measure, left-aligned with the heading: on a wide window a title stays near its status. -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="UnreadableMeetings" Spacing="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                <!-- One flat list of day headers and rows: nested x:Bind item lists do not marshal to WinRT. -->
                <ItemsControl x:Name="MeetingGroups" Grid.Row="1" Visibility="Collapsed" AutomationProperties.Name="Saved meetings">
                    <ItemsControl.ItemTemplateSelector>
                        <local:MeetingListTemplateSelector DayTemplate="{StaticResource MeetingDayTemplate}"
                                                           RowTemplate="{StaticResource MeetingRowTemplate}" />
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
            </Grid>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Spacing="4" MaxWidth="380" Padding="0,48" Visibility="Collapsed">
                <TextBlock Text="No meetings yet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Start a meeting to transcribe it on this device. When Teams starts using your microphone, Ansible offers to take notes."
                           TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>
        </StackPanel>
    </local:PageCanvas>
</Page>
