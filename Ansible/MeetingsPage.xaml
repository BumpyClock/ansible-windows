<Page x:Class="Ansible.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <DataTemplate x:Key="MeetingDayTemplate" x:DataType="local:MeetingDayHeader">
            <Grid Margin="0,12,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource HistoryGroupLabelStyle}"
                           AutomationProperties.HeadingLevel="Level2"/>
                <Border Grid.Column="1" Style="{StaticResource HistoryDividerStyle}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MeetingRowTemplate" x:DataType="local:MeetingHistoryRow">
            <Button Tag="{x:Bind Summary.Id}" Click="MeetingClicked"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="12,8"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionSecondaryStyle}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SectionBadgeStyle}"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{x:Bind local:MeetingsPage.VisibleIf(IsFailed)}">
                                <TextBlock Text="Failed" Style="{StaticResource CaptionSecondaryStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>
    <local:PageCanvas Title="Meetings"
                      Subtitle="Transcribed on this device. Audio is never saved.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="NewMeetingButton" Content="Start meeting" MinHeight="40" Padding="20,8"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="NewMeetingClicked" AutomationProperties.AutomationId="StartMeeting" />
        </local:PageCanvas.HeaderActions>
        <StackPanel>
            <StackPanel x:Name="UnreadableMeetings" Spacing="12" Margin="0,0,0,8" Visibility="Collapsed"/>
            <!-- One flat list of day headers and rows: nested x:Bind item lists do not marshal to WinRT. -->
            <ItemsControl x:Name="MeetingGroups" Visibility="Collapsed" AutomationProperties.Name="Saved meetings">
                <ItemsControl.ItemTemplateSelector>
                    <local:MeetingListTemplateSelector DayTemplate="{StaticResource MeetingDayTemplate}"
                                                       RowTemplate="{StaticResource MeetingRowTemplate}" />
                </ItemsControl.ItemTemplateSelector>
            </ItemsControl>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Spacing="4" MaxWidth="380" Padding="0,48" Visibility="Collapsed">
                <TextBlock Text="No meetings yet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Start a meeting to transcribe it locally. Ansible suggests notes when Teams uses your microphone."
                           TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>
        </StackPanel>
    </local:PageCanvas>
</Page>
