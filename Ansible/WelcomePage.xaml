<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Ansible.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ansible">
    <local:PageCanvas>
        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="24" Padding="0,12,0,24">
            <Grid>
                <TextBlock Text="WELCOME TO ANSIBLE" CharacterSpacing="140" Style="{StaticResource CaptionSecondaryStyle}" />
                <TextBlock x:Name="StepLabel" HorizontalAlignment="Right" Style="{StaticResource CaptionSecondaryStyle}" />
            </Grid>
            <StackPanel Spacing="10">
                <TextBlock x:Name="Heading" Text="Less typing. More you." FontSize="40" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="Description" FontSize="17" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <local:ShortcutIllustration x:Name="Illustration" />
            <Border Background="{ThemeResource AppCardBrush}" CornerRadius="20" Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="IntroPanel" Spacing="14">
                        <TextBlock Text="Speak naturally. Keep your flow." Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Focus a text field in another app. Use your shortcut to speak, and Ansible inserts the finished words there."
                                   Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Recognition runs on this device. Audio is never saved or uploaded. Successful dictations are saved in your local history."
                                   Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ShortcutPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock x:Name="ShortcutInstruction" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="Keycaps" Orientation="Horizontal" Spacing="8" />
                        <TextBlock x:Name="ShortcutDetail" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="This illustration is a preview. Your microphone is off until you start a dictation."
                                   Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="PracticePanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Try a sentence of your own." Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="PracticeBox" Header="Practice field" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="110" MaxHeight="200" PlaceholderText="Click here, then use your shortcut."
                                 AutomationProperties.AutomationId="WelcomePracticeField" />
                        <TextBlock x:Name="PracticeStatus" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="CancelPracticeButton" Content="Cancel dictation" Click="CancelPracticeClicked"
                                HorizontalAlignment="Left" Visibility="Collapsed">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="Escape" /></Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="ModelsButton" Content="Set up a speech model" Click="ModelsClicked"
                                HorizontalAlignment="Left" Visibility="Collapsed" />
                        <TextBlock Text="Nothing is sent to another app or the clipboard here. Practice dictations also appear in your local history."
                                   Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <InfoBar x:Name="Notice" IsOpen="False" Visibility="Collapsed" IsClosable="False" />
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SkipButton" Content="Skip for now" Click="SkipClicked" HorizontalAlignment="Left" />
                <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="BackClicked" Visibility="Collapsed" />
                <Button x:Name="NextButton" Grid.Column="2" Content="Get started" Click="NextClicked"
                        Style="{StaticResource AppPrimaryButtonStyle}" />
            </Grid>
            <TextBlock Text="You can revisit this lesson from Home. Change the shortcut in Settings."
                       HorizontalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </local:PageCanvas>
</Page>
