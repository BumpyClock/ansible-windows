<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.NoticeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ansible"
             HorizontalAlignment="Stretch">
    <!-- One control for every notification, drawn as a docked bar like the stock InfoBar: flat, with the card
         stroke and the control corner radius. NoticeHost docks it in the band under the page; a page may place it
         inline only for a condition that explains that page. -->
    <Border x:Name="Surface"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="16,8,8,8">
        <!-- The panel takes its four children in this order: icon, message, actions, close. The message may run to
             two lines beside the actions; a longer one gets the full width and the actions move under it. -->
        <local:NoticeBarPanel InlineMessageMaxHeight="40">
            <Grid x:Name="IconHost" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw">
                <!-- ThemeResource fills keep the disc correct when the theme changes while a notice shows. -->
                <Ellipse x:Name="InfoDisc" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Ellipse x:Name="WarningDisc" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                <Ellipse x:Name="ErrorDisc" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <FontIcon x:Name="IconGlyph" FontSize="12" Foreground="{ThemeResource AppOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="Text" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run x:Name="TitleRun" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><Run x:Name="MessageRun" />
            </TextBlock>
            <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}" Click="CloseClicked"
                    ToolTipService.ToolTip="Dismiss">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>
        </local:NoticeBarPanel>
    </Border>
</UserControl>
