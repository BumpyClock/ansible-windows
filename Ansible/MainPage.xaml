<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <!-- Group headers sit on the window base above their card, so the card holds settings only. -->
        <Style x:Key="SettingsCardHeaderStyle" TargetType="Grid">
            <Setter Property="Padding" Value="{StaticResource SettingsGroupHeaderPadding}" />
        </Style>
        <Style x:Key="SettingsCardMetaStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsOptionStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="{StaticResource SettingsOptionGap}" />
            <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource SettingsRowBorderThickness}" />
        </Style>
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontSize" Value="{StaticResource SettingsLabelFontSize}" />
            <Setter Property="LineHeight" Value="{StaticResource SettingsLabelLineHeight}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="FontSize" Value="{StaticResource SettingsDescriptionFontSize}" />
            <Setter Property="LineHeight" Value="{StaticResource SettingsDescriptionLineHeight}" />
            <Setter Property="MaxWidth" Value="{StaticResource SettingsRowDescriptionMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsOptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontSize" Value="{StaticResource SettingsOptionFontSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <local:PageCanvas x:Name="SettingsCanvas"
                      Title="Settings"
                      Subtitle="Control how Ansible listens, recognizes speech, and protects your data.">
            <StackPanel Spacing="{StaticResource PageSectionSpacing}">
                <!-- Groups slide when the InfoBar appears; theme transitions follow the Windows animation setting. -->
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- A closed InfoBar stays Visible and still takes stack spacing, so RenderNotice collapses it too. -->
                <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" Visibility="Collapsed" Closing="StatusInfoClosing" />

                <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dictation" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Input and insertion" Style="{StaticResource SettingsCardMetaStyle}" />
                    </Grid>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Rows slide when an insertion row or the comparison appears. -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <local:SettingsRow Title="Activation mode"
                                            Description="Hold the shortcut while you speak, or press once to start and again to stop."
                                            CompactAlignment="Left">
                            <Border x:Name="PushToTalkTrack"
                                    Style="{StaticResource SettingsSegmentTrackStyle}">
                                <ListBox x:Name="PushToTalkChoice"
                                         Style="{StaticResource SegmentedListBoxStyle}"
                                         ItemContainerStyle="{StaticResource SegmentedListBoxItemStyle}"
                                         AutomationProperties.AutomationId="PushToTalkToggle"
                                         AutomationProperties.Name="Activation mode"
                                         SelectionChanged="DictationModeChanged">
                                    <x:String>Hold to talk</x:String>
                                    <x:String>Press to start and stop</x:String>
                                </ListBox>
                            </Border>
                        </local:SettingsRow>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                        <local:SettingsRow Title="Overlay position"
                                            Description="Show the waveform under the text cursor while you dictate. When Windows cannot report the cursor position, or when this is off, it appears at the bottom of the screen.">
                            <!-- The template keeps a fixed 12 DIP column for the empty On/Off content; the negative margin aligns the switch with the other row controls. -->
                            <ToggleSwitch x:Name="OverlayFollowsCaretToggle" VerticalAlignment="Center" Margin="0,0,-12,0"
                                          AutomationProperties.AutomationId="OverlayFollowsCaretToggle"
                                          AutomationProperties.Name="Overlay position"
                                          OnContent="" OffContent="" MinWidth="0" Toggled="OverlayFollowsCaretToggled" />
                        </local:SettingsRow>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                        <local:SettingsRow Title="Shortcut">
                            <StackPanel x:Name="ShortcutControl" Orientation="Horizontal" Spacing="8">
                                <!-- Read-only keycap. Focus or click records a new shortcut; Esc cancels. -->
                                <!-- Shown only when the shortcut differs from the default. -->
                                <HyperlinkButton x:Name="ResetShortcutButton" Content="Reset" VerticalAlignment="Center"
                                                 Foreground="{ThemeResource AccentForegroundBrush}"
                                                 FontSize="{StaticResource SettingsLinkFontSize}" FontWeight="Medium"
                                                 AutomationProperties.AutomationId="ResetShortcutButton"
                                                 AutomationProperties.Name="Reset shortcut"
                                                 Visibility="Collapsed" Click="ResetShortcutClicked" />
                                <Grid MinWidth="140" MaxWidth="280" MinHeight="32">
                                    <StackPanel x:Name="HotkeyKeycaps" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <Border x:Name="HotkeyModifierKeycap" Style="{StaticResource KeycapStyle}">
                                            <TextBlock x:Name="HotkeyModifierText" Style="{StaticResource KeycapTextStyle}" />
                                        </Border>
                                        <TextBlock x:Name="HotkeyPlusText" Text="+" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionSecondaryStyle}" />
                                        <Border x:Name="HotkeyPrimaryKeycap" Style="{StaticResource KeycapStyle}">
                                            <TextBlock x:Name="HotkeyPrimaryText" Style="{StaticResource KeycapTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="HotkeyCaptureStatus" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBox x:Name="HotkeyCaptureBox"
                                             AutomationProperties.AutomationId="HotkeyCaptureBox"
                                             AutomationProperties.Name="Shortcut"
                                             IsReadOnly="True" TextAlignment="Center"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="Transparent" Opacity="0.01"
                                             GotFocus="ShortcutGotFocus" KeyDown="ShortcutKeyDown"
                                             KeyUp="ShortcutKeyUp" LostFocus="ShortcutLostFocus" />
                                </Grid>
                            </StackPanel>
                        </local:SettingsRow>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                        <local:SettingsRow x:Name="InsertionRow" Title="Text insertion" CompactAlignment="Left">
                            <Border x:Name="InsertionTrack"
                                    Style="{StaticResource SettingsSegmentTrackStyle}">
                                <ListBox x:Name="InsertionChoice"
                                         Style="{StaticResource SegmentedListBoxStyle}"
                                         ItemContainerStyle="{StaticResource SegmentedListBoxItemStyle}"
                                         AutomationProperties.AutomationId="InsertionChoice"
                                         AutomationProperties.Name="Text insertion"
                                         SelectionChanged="InsertionMethodChanged">
                                    <x:String>Paste text</x:String>
                                    <x:String>Type characters</x:String>
                                </ListBox>
                            </Border>
                        </local:SettingsRow>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                        <local:SettingsRow x:Name="PasteShortcutRow"
                                            Title="Destination paste shortcut"
                                            Description="Choose the shortcut accepted by the focused editor or terminal. This applies to all paste dictation; it is not detected automatically."
                                            WideWidth="{StaticResource SettingsSelectWidth}">
                            <ComboBox x:Name="PasteShortcutChoice"
                                      AutomationProperties.AutomationId="PasteShortcutChoice"
                                      AutomationProperties.Name="Destination paste shortcut"
                                      SelectionChanged="PasteShortcutChanged">
                                <x:String>Ctrl+V</x:String>
                                <x:String>Shift+Insert</x:String>
                                <x:String>Ctrl+Shift+V</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="TypingGapRow"
                                            Visibility="Collapsed"
                                            Title="Gap between characters (ms)"
                                            Description="0 sends all text at once, which some apps such as Notepad garble. Windows may round short gaps up to about 15 ms."
                                            WideWidth="{StaticResource SettingsNumberWidth}">
                            <NumberBox x:Name="TypingGapBox"
                                       AutomationProperties.AutomationId="TypingGapBox"
                                       AutomationProperties.Name="Gap between typed characters in milliseconds"
                                       Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="TypingGapChanged" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SectionHeaderGap}" Margin="0,8,0,0">
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Audio and recognition" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Applies to the next dictation" Style="{StaticResource SettingsCardMetaStyle}" />
                    </Grid>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Rows slide when an insertion row or the comparison appears. -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <local:SettingsRow Title="Microphone boost (dB)"
                                            Description="For quiet speech or whispering. 0 is off; try 6 or 12 dB first. Higher boost also raises background noise and can distort louder speech."
                                            WideWidth="{StaticResource SettingsNumberWidth}">
                            <NumberBox x:Name="MicrophoneBoostBox"
                                       AutomationProperties.AutomationId="MicrophoneBoostBox"
                                       AutomationProperties.Name="Microphone boost in decibels"
                                       AutomationProperties.HelpText="0 is off. Applies to the next microphone dictation."
                                       Minimum="0" Maximum="24" SmallChange="6" LargeChange="12"
                                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="MicrophoneBoostChanged" />
                        </local:SettingsRow>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                        <local:SettingsRow Title="Language hint"
                                            Description="Leave this empty to use the model default."
                                            WideWidth="{StaticResource SettingsLanguageWidth}">
                            <TextBox x:Name="LanguageBox"
                                     AutomationProperties.Name="Language hint" PlaceholderText="Model default"
                                     TextChanged="LanguageChanged" />
                        </local:SettingsRow>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                        <local:SettingsRow x:Name="BackendRow"
                                            Title="Recognition processor"
                                            Description="Auto compares CPU and GPU using a bundled speech sample, then remembers the faster working device for each model. Audio stays local."
                                            CompactAlignment="Left"
                                            WideWidth="{StaticResource SettingsProcessorWidth}">
                            <Border x:Name="BackendTrack"
                                    Style="{StaticResource SettingsSegmentTrackStyle}">
                                <ListBox x:Name="BackendChoice"
                                         Style="{StaticResource SegmentedListBoxStyle}"
                                         ItemContainerStyle="{StaticResource SegmentedListBoxItemStyle}"
                                         AutomationProperties.Name="Recognition processor"
                                         AutomationProperties.AutomationId="BackendChoice"
                                         SelectionChanged="BackendChanged">
                                    <x:String>Auto (recommended)</x:String>
                                    <x:String>CPU</x:String>
                                    <x:String>Vulkan</x:String>
                                </ListBox>
                            </Border>
                        </local:SettingsRow>

                        <local:DeviceComparisonView x:Name="DeviceComparison" Margin="{StaticResource SettingsBenchmarkMargin}" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SectionHeaderGap}" Margin="0,8,0,0">
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transcript cleanup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Meeting text only" Style="{StaticResource SettingsCardMetaStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <ContentControl x:Name="CleanupSettingsPanel" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Choose where completed meeting text is sent. Audio stays local. Automatic cleanup is off until you enable it and save. Original wording is kept."
                                       Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                            <local:SettingsRow Title="Connection" Description="No fallback to another service or account.">
                                <ComboBox x:Name="CleanupProviderChoice" AutomationProperties.Name="Cleanup provider"
                                          SelectionChanged="CleanupProviderChanged" HorizontalAlignment="Stretch">
                                    <x:String>Copilot CLI</x:String>
                                    <x:String>OpenAI API</x:String>
                                </ComboBox>
                            </local:SettingsRow>
                            <StackPanel x:Name="CopilotCleanupFields" Spacing="12">
                                <TextBlock Text="Uses the installed Copilot CLI and its signed-in account. Run copilot login if needed. No OpenAI API key is used."
                                           Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="CopilotCleanupModelBox" Header="Copilot model" MaxLength="128"
                                         AutomationProperties.Name="Copilot cleanup model" />
                                <ComboBox x:Name="CopilotCleanupEffortChoice" Header="Copilot reasoning effort"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Copilot cleanup reasoning effort" />
                            </StackPanel>
                            <StackPanel x:Name="OpenAICleanupFields" Spacing="12">
                                <TextBlock Text="Sends text directly to the OpenAI Responses API. Requires an OpenAI API model with structured outputs and separate API billing. Copilot model names are not automatically mapped."
                                           Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="OpenAICleanupModelBox" Header="OpenAI API model" MaxLength="128"
                                         PlaceholderText="Enter the model ID from your OpenAI API account"
                                         AutomationProperties.Name="OpenAI cleanup model" />
                                <ComboBox x:Name="OpenAICleanupEffortChoice" Header="OpenAI reasoning effort"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="OpenAI cleanup reasoning effort" />
                                <PasswordBox x:Name="OpenAIKeyBox" Header="OpenAI API key" MaxLength="1024"
                                             PlaceholderText="Enter a key to save or replace it"
                                             PasswordRevealMode="Hidden" AutomationProperties.Name="OpenAI API key" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save API key" Click="SaveOpenAIKeyClicked" />
                                    <Button Content="Remove saved key" Click="RemoveOpenAIKeyClicked" />
                                </StackPanel>
                                <TextBlock x:Name="OpenAIKeyStatus" Style="{StaticResource SettingsDescriptionStyle}"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutomaticCleanupToggle" Header="Automatic cleanup"
                                          OnContent="Send completed meeting text automatically"
                                          OffContent="Send completed meeting text automatically"
                                          AutomationProperties.Name="Automatic transcript cleanup" />
                            <TextBlock Text="Enabling this authorizes sending each new completed meeting transcript to the selected provider without another confirmation. Applies to meetings started after saving. Saved meetings are not uploaded automatically."
                                       Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                            <Button Content="Save cleanup settings" Click="SaveCleanupSettingsClicked" />
                            <TextBlock x:Name="CleanupSettingsStatus" Style="{StaticResource SettingsDescriptionStyle}"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        </ContentControl>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SectionHeaderGap}" Margin="0,8,0,0">
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Privacy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Capture, meetings, telemetry" Style="{StaticResource SettingsCardMetaStyle}" />
                    </Grid>
                <Border Style="{StaticResource SettingsCardStyle}" Padding="{StaticResource SettingsPrivacyCardPadding}">
                    <StackPanel>
                        <!-- Rows slide when an insertion row or the comparison appears. -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <StackPanel Style="{StaticResource SettingsOptionStyle}">
                            <TextBlock Text="Screen capture privacy" Style="{StaticResource SettingsLabelStyle}" />
                            <CheckBox x:Name="HideFromCaptureChoice"
                                      CornerRadius="{StaticResource SettingsCheckBoxCornerRadius}"
                                      AutomationProperties.AutomationId="HideFromCaptureChoice"
                                      Checked="HideFromCaptureChanged" Unchecked="HideFromCaptureChanged">
                                <TextBlock Text="Hide dictation overlay and meeting windows from capture" Style="{StaticResource SettingsOptionTextStyle}" />
                            </CheckBox>
                            <TextBlock Text="Applies to supported Windows screenshots and screen sharing. The main window remains visible. Some recorders can still capture protected windows."
                                       Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingsOptionStyle}">
                            <TextBlock Text="Meeting suggestions" Style="{StaticResource SettingsLabelStyle}" />
                            <CheckBox x:Name="AutoDetectMeetingsChoice"
                                      CornerRadius="{StaticResource SettingsCheckBoxCornerRadius}"
                                      AutomationProperties.AutomationId="AutoDetectMeetingsChoice"
                                      Checked="AutoDetectMeetingsChanged" Unchecked="AutoDetectMeetingsChanged">
                                <TextBlock Text="Suggest notetaking when Teams uses the microphone" Style="{StaticResource SettingsOptionTextStyle}" />
                            </CheckBox>
                            <TextBlock Text="Detection checks app activity without recording audio. Suggestions open the notetaker; you must click Start to capture your meeting. Calendar access is not used."
                                       Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="UsageRow" Spacing="{StaticResource SettingsOptionGap}" Background="Transparent">
                            <TextBlock Text="Usage statistics" Style="{StaticResource SettingsLabelStyle}" />
                            <!-- The switch content is its visible label; the automation name stays "Usage statistics". -->
                            <ToggleSwitch x:Name="UsageToggle" HorizontalAlignment="Left"
                                          AutomationProperties.AutomationId="UsageToggle"
                                          AutomationProperties.Name="Usage statistics"
                                          OnContent="Record session counts" OffContent="Record session counts"
                                          MinWidth="0" Toggled="UsageToggled" />
                            <TextBlock Text="Session counts only. Never audio or text."
                                       Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>

                        <local:SettingsRow x:Name="DiagnosticsRow" Title="Local diagnostics"
                            Description="Off by default. When enabled, operational metadata stays on this device. No audio or transcript text is recorded.">
                            <ToggleSwitch x:Name="DiagnosticsToggle"
                                AutomationProperties.AutomationId="DiagnosticsToggle"
                                AutomationProperties.Name="Local diagnostics"
                                OnContent="Record local diagnostics" OffContent="Record local diagnostics"
                                Toggled="DiagnosticsToggled" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
    </local:PageCanvas>
</Page>
