<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="SettingsSectionDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}" />
            <Setter Property="MaxWidth" Value="{StaticResource SettingsRowDescriptionMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <!-- One section shows at a time, chosen in the section bar. Hidden sections stay loaded so their bindings and
         handlers keep working. A section is an optional description, then its cards; a card has its own heading
         only when the section holds more than one. -->
    <local:PageCanvas x:Name="SettingsCanvas"
                      Title="Settings"
                      Subtitle="How Ansible listens, recognizes speech, and handles your data.">
        <StackPanel x:Name="SettingsBody" Spacing="16">
            <!-- The bar sticks to the top of the page while a long section scrolls under it. Its fill repeats the
                 window's two layers, Mica under the content layer fill, so the rows it covers leave no band. The
                 padding gives it room while stuck; matching negative margins keep the layout where it was. -->
            <Grid x:Name="SectionBarHost" Margin="0,-8,0,-8" Padding="0,8,0,8" Canvas.ZIndex="1">
                <SystemBackdropElement Margin="0,-8,0,-8" IsHitTestVisible="False">
                    <SystemBackdropElement.SystemBackdrop>
                        <MicaBackdrop />
                    </SystemBackdropElement.SystemBackdrop>
                </SystemBackdropElement>
                <Border Margin="0,-8,0,-8" IsHitTestVisible="False"
                        Background="{ThemeResource LayerFillColorDefaultBrush}" />
                <SelectorBar x:Name="SectionBar" HorizontalAlignment="Left"
                             AutomationProperties.AutomationId="SettingsSections"
                             AutomationProperties.Name="Settings sections"
                             SelectionChanged="SectionChanged">
                    <SelectorBarItem x:Name="DictationSectionItem" Text="Dictation" IsSelected="True"
                                     AutomationProperties.AutomationId="SettingsSectionDictation" />
                    <SelectorBarItem x:Name="ScreenSectionItem" Text="Screen and ink"
                                     AutomationProperties.AutomationId="SettingsSectionScreen" />
                    <SelectorBarItem x:Name="RecognitionSectionItem" Text="Recognition"
                                     AutomationProperties.AutomationId="SettingsSectionRecognition" />
                    <SelectorBarItem x:Name="MeetingsSectionItem" Text="Meetings"
                                     AutomationProperties.AutomationId="SettingsSectionMeetings" />
                    <SelectorBarItem x:Name="PrivacySectionItem" Text="Privacy and data"
                                     AutomationProperties.AutomationId="SettingsSectionPrivacy" />
                </SelectorBar>
                <!-- A hairline under the stuck bar. The pin fades it in only while rows pass underneath. -->
                <Border x:Name="SectionBarDivider" Margin="0,0,0,-8" VerticalAlignment="Bottom" IsHitTestVisible="False"
                        Style="{StaticResource HistoryDividerStyle}" />
            </Grid>

            <Grid x:Name="SectionsHost">
                <Border x:Name="DictationSection" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Rows slide when an insertion row appears. -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <local:SettingsRow Title="Activation"
                                           Description="Hold the shortcut while you speak, or press it once to start and again to stop."
                                           ShowDivider="False"
                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="PushToTalkChoice"
                                      AutomationProperties.AutomationId="PushToTalkToggle"
                                      AutomationProperties.Name="Activation"
                                      SelectionChanged="DictationModeChanged">
                                <x:String>Hold to talk</x:String>
                                <x:String>Press to start and stop</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow Title="Shortcut"
                                           Description="Select Change, then press the keys you want. Esc cancels.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:ShortcutField x:Name="HotkeyField" VerticalAlignment="Center" />
                                <Button x:Name="ChangeShortcutButton" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ChangeShortcutButton"
                                        AutomationProperties.Name="Change shortcut"
                                        Click="ChangeShortcutClicked" />
                                <!-- Shown only when the shortcut differs from the default. -->
                                <Button x:Name="ResetShortcutButton" Content="Reset" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ResetShortcutButton"
                                        AutomationProperties.Name="Reset shortcut"
                                        Visibility="Collapsed" Click="ResetShortcutClicked" />
                                <Button x:Name="PracticeShortcutButton" Content="Practice" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ShortcutLessonButton"
                                        AutomationProperties.Name="Practice the shortcut"
                                        Click="PracticeShortcutClicked" />
                            </StackPanel>
                        </local:SettingsRow>

                        <local:SettingsRow Title="Show overlay at the text cursor"
                                           Description="Otherwise, or when Windows cannot report the cursor position, the overlay sits at the bottom of the screen.">
                            <ToggleSwitch x:Name="OverlayFollowsCaretToggle"
                                          AutomationProperties.AutomationId="OverlayFollowsCaretToggle"
                                          AutomationProperties.Name="Show overlay at the text cursor"
                                          Toggled="OverlayFollowsCaretToggled" />
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="InsertionRow" Title="Text insertion"
                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="InsertionChoice"
                                      AutomationProperties.AutomationId="InsertionChoice"
                                      AutomationProperties.Name="Text insertion"
                                      SelectionChanged="InsertionMethodChanged">
                                <x:String>Paste text</x:String>
                                <x:String>Type characters</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="PasteShortcutRow" IsChild="True"
                                           Title="Paste shortcut"
                                           Description="The keys sent to paste. Pick the ones your editor or terminal accepts, because Ansible cannot detect them."
                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="PasteShortcutChoice"
                                      AutomationProperties.AutomationId="PasteShortcutChoice"
                                      AutomationProperties.Name="Paste shortcut"
                                      SelectionChanged="PasteShortcutChanged">
                                <x:String>Ctrl+V</x:String>
                                <x:String>Shift+Insert</x:String>
                                <x:String>Ctrl+Shift+V</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="TypingGapRow" IsChild="True"
                                           Visibility="Collapsed"
                                           Title="Delay between characters (ms)"
                                           Description="At 0, all text is sent at once, which slow apps such as Notepad can garble. Windows may round short delays up to about 15 ms."
                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                            <NumberBox x:Name="TypingGapBox"
                                       AutomationProperties.AutomationId="TypingGapBox"
                                       AutomationProperties.Name="Delay between typed characters in milliseconds"
                                       Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="TypingGapChanged" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>

                <Border x:Name="ScreenSection" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <local:SettingsRow Title="Dictate with screen and ink" ShowDivider="False"
                                           Description="Records the screen under the pointer as video without audio, and lets you draw on it. Clicks and scrolling are blocked on every monitor while recording. Esc discards the take.">
                            <ToggleSwitch x:Name="RecordChordToggle" AutomationProperties.Name="Enable screen and ink recording"
                                          Toggled="RecordChordToggled" />
                        </local:SettingsRow>
                        <local:SettingsRow Title="Record shortcut" Description="Records speech, screen, and ink together.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:ShortcutField x:Name="RecordHotkeyField" VerticalAlignment="Center" />
                                <Button x:Name="ChangeRecordShortcutButton" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.Name="Change record shortcut"
                                        Click="ChangeRecordShortcutClicked" />
                                <Button x:Name="ResetRecordShortcutButton" Content="Reset" VerticalAlignment="Center"
                                        AutomationProperties.Name="Reset record shortcut"
                                        Click="ResetRecordShortcutClicked" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Title="Paste capture shortcut"
                                           Description="Pastes the latest take's text, ink markers, pictures, and optional video link into the focused chat or text field.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:ShortcutField x:Name="RecordPasteHotkeyField" VerticalAlignment="Center" />
                                <Button x:Name="ChangeRecordPasteShortcutButton" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.Name="Change paste capture shortcut"
                                        Click="ChangeRecordPasteShortcutClicked" />
                                <Button x:Name="ResetRecordPasteShortcutButton" Content="Reset" VerticalAlignment="Center"
                                        AutomationProperties.Name="Reset paste capture shortcut"
                                        Click="ResetRecordPasteShortcutClicked" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Title="Press once to start and stop"
                                           Description="Lets you release the record shortcut and draw with your touchpad. Press the shortcut again to finish. Separate from the dictation Activation setting.">
                            <ToggleSwitch x:Name="RecordToggleModeToggle"
                                          AutomationProperties.AutomationId="RecordToggleModeToggle"
                                          AutomationProperties.Name="Press record shortcut once to start and stop"
                                          Toggled="RecordToggleModeToggled" />
                        </local:SettingsRow>
                        <local:SettingsRow Title="Include video link in pasted text"
                                           Description="Adds a link to the video file on this device. Web and cloud apps cannot open it, and the link reveals the file's local path.">
                            <ToggleSwitch x:Name="IncludeVideoLinkToggle" AutomationProperties.Name="Include video link in pasted text"
                                          Toggled="IncludeVideoLinkToggled" />
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="CaptureStorageRow" Title="Saved captures" Description="Checking size…">
                            <Button x:Name="DeleteCapturesButton" Content="Delete all captures" Click="DeleteCapturesClicked" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RecognitionSection" Spacing="{StaticResource SectionHeaderGap}" Visibility="Collapsed">
                    <TextBlock Text="Changes apply to the next dictation." Style="{StaticResource SettingsSectionDescriptionStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <local:SettingsRow Title="Microphone boost (dB)"
                                               Description="Raises quiet speech. 0 is off. Try 6 or 12 dB first, because more boost also amplifies background noise and can distort loud speech."
                                               ShowDivider="False"
                                               ControlWidth="{StaticResource SettingsFieldWidth}">
                                <NumberBox x:Name="MicrophoneBoostBox"
                                           AutomationProperties.AutomationId="MicrophoneBoostBox"
                                           AutomationProperties.Name="Microphone boost in decibels"
                                           AutomationProperties.HelpText="0 is off. Applies to the next microphone dictation."
                                           Minimum="0" Maximum="24" SmallChange="6" LargeChange="12"
                                           SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                           ValueChanged="MicrophoneBoostChanged" />
                            </local:SettingsRow>

                            <local:SettingsRow Title="Language hint"
                                               Description="Leave empty to use the model's default language."
                                               ControlWidth="{StaticResource SettingsFieldWidth}">
                                <TextBox x:Name="LanguageBox"
                                         AutomationProperties.Name="Language hint" PlaceholderText="Model default"
                                         TextChanged="LanguageChanged" />
                            </local:SettingsRow>

                            <local:SettingsRow Title="Processor"
                                               Description="Auto tests the CPU and GPU on a bundled speech sample and uses the faster one for each model. Choosing CPU or Vulkan skips the test."
                                               ControlWidth="{StaticResource SettingsFieldWidth}">
                                <ComboBox x:Name="BackendChoice"
                                          AutomationProperties.Name="Processor"
                                          AutomationProperties.AutomationId="BackendChoice"
                                          SelectionChanged="BackendChanged">
                                    <x:String>Auto (recommended)</x:String>
                                    <x:String>CPU</x:String>
                                    <x:String>Vulkan</x:String>
                                </ComboBox>
                            </local:SettingsRow>

                            <!-- The busy ring sits inside the button, so the button keeps one size and one edge. -->
                            <local:SettingsRow x:Name="BenchmarkRow" Title="Compare processors">
                                <Button x:Name="BenchmarkButton" MinWidth="128"
                                        AutomationProperties.AutomationId="BenchmarkButton"
                                        AutomationProperties.Name="Run device benchmark"
                                        Click="BenchmarkClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="BenchmarkProgress" Width="16" Height="16" IsActive="False"
                                                      Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="BenchmarkButtonText" Text="Run benchmark" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </local:SettingsRow>

                            <local:DeviceComparisonView x:Name="DeviceComparison" Margin="{StaticResource SettingsBenchmarkMargin}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="MeetingsSection" Spacing="{StaticResource PageSectionSpacing}" Visibility="Collapsed">
                    <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                        <TextBlock Text="Meeting detection" Style="{StaticResource SettingsCardTitleStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <local:SettingsRow Title="Suggest notes when Teams uses the microphone"
                                               Description="Checks which apps use the microphone, never the audio, and offers a notetaker. Nothing is captured until you click Start. Your calendar is not used."
                                               ShowDivider="False">
                                <ToggleSwitch x:Name="AutoDetectMeetingsToggle"
                                              AutomationProperties.AutomationId="AutoDetectMeetingsChoice"
                                              AutomationProperties.Name="Suggest notes when Teams uses the microphone"
                                              Toggled="AutoDetectMeetingsChanged" />
                            </local:SettingsRow>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Transcript cleanup" Style="{StaticResource SettingsCardTitleStyle}" />
                            <TextBlock Text="Sends completed meeting text, never audio, to the service you choose. The original wording is kept."
                                       Style="{StaticResource SettingsSectionDescriptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <ContentControl x:Name="CleanupSettingsPanel" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <local:SettingsRow x:Name="CleanupProviderRow" Title="Service"
                                                       ShowDivider="False"
                                                       ControlWidth="{StaticResource SettingsFieldWidth}">
                                        <ComboBox x:Name="CleanupProviderChoice" AutomationProperties.Name="Cleanup provider"
                                                  SelectionChanged="CleanupProviderChanged">
                                            <x:String>Copilot CLI</x:String>
                                            <x:String>OpenAI API</x:String>
                                        </ComboBox>
                                    </local:SettingsRow>

                                    <StackPanel x:Name="CopilotCleanupFields">
                                        <local:SettingsRow x:Name="CopilotModelRow" Title="Model" IsChild="True"
                                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                                            <TextBox x:Name="CopilotCleanupModelBox" MaxLength="128"
                                                     AutomationProperties.Name="Copilot cleanup model"
                                                     LostFocus="CleanupModelCommitted" KeyDown="CleanupModelKeyDown" />
                                        </local:SettingsRow>
                                        <local:SettingsRow Title="Reasoning effort" IsChild="True"
                                                           Description="Higher effort can improve the wording but takes longer."
                                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                                            <ComboBox x:Name="CopilotCleanupEffortChoice"
                                                      AutomationProperties.Name="Copilot cleanup reasoning effort"
                                                      SelectionChanged="CleanupEffortChanged" />
                                        </local:SettingsRow>
                                    </StackPanel>

                                    <StackPanel x:Name="OpenAICleanupFields">
                                        <local:SettingsRow Title="Model" IsChild="True"
                                                           Description="Required. A model ID your OpenAI account can use."
                                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                                            <TextBox x:Name="OpenAICleanupModelBox" MaxLength="128"
                                                     PlaceholderText="OpenAI model ID"
                                                     AutomationProperties.Name="OpenAI cleanup model"
                                                     LostFocus="CleanupModelCommitted" KeyDown="CleanupModelKeyDown" />
                                        </local:SettingsRow>
                                        <local:SettingsRow Title="Reasoning effort" IsChild="True"
                                                           Description="Higher effort can improve the wording but takes longer. Pick a level the model supports."
                                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                                            <ComboBox x:Name="OpenAICleanupEffortChoice"
                                                      AutomationProperties.Name="OpenAI cleanup reasoning effort"
                                                      SelectionChanged="CleanupEffortChanged" />
                                        </local:SettingsRow>
                                        <!-- The key field and its two buttons share one field width, so both edges line up with the fields above. -->
                                        <local:SettingsRow x:Name="OpenAIKeyRow" Title="API key" IsChild="True"
                                                           ControlWidth="{StaticResource SettingsFieldWidth}">
                                            <StackPanel Spacing="8">
                                                <PasswordBox x:Name="OpenAIKeyBox" MaxLength="1024"
                                                             PlaceholderText="Paste a new key"
                                                             PasswordRevealMode="Hidden" AutomationProperties.Name="OpenAI API key" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="Save key" HorizontalAlignment="Stretch"
                                                            AutomationProperties.Name="Save API key"
                                                            Click="SaveOpenAIKeyClicked" />
                                                    <Button Grid.Column="1" Content="Remove key" HorizontalAlignment="Stretch"
                                                            AutomationProperties.Name="Remove saved API key"
                                                            Click="RemoveOpenAIKeyClicked" />
                                                </Grid>
                                            </StackPanel>
                                        </local:SettingsRow>
                                    </StackPanel>

                                    <local:SettingsRow Title="Clean up automatically"
                                                       Description="Cleans up each new meeting transcript as soon as it is saved. You can always clean up a meeting manually.">
                                        <ToggleSwitch x:Name="AutomaticCleanupToggle"
                                                      AutomationProperties.Name="Automatic transcript cleanup"
                                                      Toggled="AutomaticCleanupToggled" />
                                    </local:SettingsRow>
                                </StackPanel>
                            </ContentControl>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="PrivacySection" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <local:SettingsRow Title="Hide overlay and meeting windows from capture"
                                           Description="Keeps these windows out of screenshots and screen sharing that support it. The main window stays visible, and some recorders can still capture them."
                                           ShowDivider="False">
                            <ToggleSwitch x:Name="HideFromCaptureToggle"
                                          AutomationProperties.AutomationId="HideFromCaptureChoice"
                                          AutomationProperties.Name="Hide overlay and meeting windows from capture"
                                          Toggled="HideFromCaptureChanged" />
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="UsageRow" Title="Usage statistics"
                                           Description="Saves session dates, model, word counts, and timing on this device. Never audio or text.">
                            <ToggleSwitch x:Name="UsageToggle"
                                          AutomationProperties.AutomationId="UsageToggle"
                                          AutomationProperties.Name="Usage statistics"
                                          Toggled="UsageToggled" />
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="DiagnosticsRow" Title="Local diagnostics"
                                           Description="Keeps a log of app events on this device for troubleshooting. No audio or transcript text is recorded.">
                            <ToggleSwitch x:Name="DiagnosticsToggle"
                                          AutomationProperties.AutomationId="DiagnosticsToggle"
                                          AutomationProperties.Name="Local diagnostics"
                                          Toggled="DiagnosticsToggled" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </local:PageCanvas>
</Page>
