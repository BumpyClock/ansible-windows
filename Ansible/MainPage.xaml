<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="SettingsLedeStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="FontSize" Value="{StaticResource SettingsDescriptionFontSize}" />
            <Setter Property="LineHeight" Value="{StaticResource SettingsDescriptionLineHeight}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="{StaticResource SettingsRowDescriptionMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <local:PageCanvas x:Name="SettingsCanvas"
                      Title="Settings"
                      Subtitle="How Ansible listens, recognizes speech, and handles your data.">
        <StackPanel Spacing="{StaticResource PageSectionSpacing}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                <TextBlock Text="Dictation" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Rows slide when an insertion row appears. -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <local:SettingsRow Title="Activation"
                                           Description="Hold the shortcut while you speak, or press once to start and again to stop."
                                           ShowDivider="False"
                                           WideWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="PushToTalkChoice"
                                      AutomationProperties.AutomationId="PushToTalkToggle"
                                      AutomationProperties.Name="Activation"
                                      SelectionChanged="DictationModeChanged">
                                <x:String>Hold to talk</x:String>
                                <x:String>Press to start and stop</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow Title="Shortcut">
                            <StackPanel x:Name="ShortcutControl" Orientation="Horizontal" Spacing="8">
                                <!-- Read-only keycap. Focus or click records a new shortcut; Esc cancels. -->
                                <Grid MinWidth="140" MaxWidth="280" MinHeight="32">
                                    <StackPanel x:Name="HotkeyKeycaps" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <Border x:Name="HotkeyModifierKeycap" Style="{StaticResource KeycapStyle}">
                                            <TextBlock x:Name="HotkeyModifierText" Style="{StaticResource KeycapTextStyle}" />
                                        </Border>
                                        <TextBlock x:Name="HotkeyPlusText" Text="+" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionSecondaryStyle}" />
                                        <Border x:Name="HotkeyPrimaryKeycap" Style="{StaticResource KeycapStyle}">
                                            <TextBlock x:Name="HotkeyPrimaryText" Style="{StaticResource KeycapTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="HotkeyCaptureStatus" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBox x:Name="HotkeyCaptureBox"
                                             AutomationProperties.AutomationId="HotkeyCaptureBox"
                                             AutomationProperties.Name="Shortcut"
                                             IsReadOnly="True" TextAlignment="Center"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="Transparent" Opacity="0.01"
                                             GotFocus="ShortcutGotFocus" KeyDown="ShortcutKeyDown"
                                             KeyUp="ShortcutKeyUp" LostFocus="ShortcutLostFocus" />
                                </Grid>
                                <Button x:Name="ChangeShortcutButton" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ChangeShortcutButton"
                                        AutomationProperties.Name="Change shortcut"
                                        Click="ChangeShortcutClicked" />
                                <!-- Shown only when the shortcut differs from the default. -->
                                <HyperlinkButton x:Name="ResetShortcutButton" Content="Reset" VerticalAlignment="Center"
                                                 Foreground="{ThemeResource AccentForegroundBrush}"
                                                 FontSize="{StaticResource SettingsLinkFontSize}" FontWeight="Medium"
                                                 AutomationProperties.AutomationId="ResetShortcutButton"
                                                 AutomationProperties.Name="Reset shortcut"
                                                 Visibility="Collapsed" Click="ResetShortcutClicked" />
                                <HyperlinkButton x:Name="PracticeShortcutButton" Content="Practice" VerticalAlignment="Center"
                                                 Foreground="{ThemeResource AccentForegroundBrush}"
                                                 FontSize="{StaticResource SettingsLinkFontSize}" FontWeight="Medium"
                                                 AutomationProperties.AutomationId="ShortcutLessonButton"
                                                 AutomationProperties.Name="Practice the shortcut"
                                                 Click="PracticeShortcutClicked" />
                            </StackPanel>
                        </local:SettingsRow>

                        <local:SettingsRow Title="Show overlay at the text cursor"
                                           Description="Falls back to the bottom of the screen when Windows cannot report the cursor position."
                                           CompactAlignment="Left">
                            <ToggleSwitch x:Name="OverlayFollowsCaretToggle"
                                          AutomationProperties.AutomationId="OverlayFollowsCaretToggle"
                                          AutomationProperties.Name="Show overlay at the text cursor"
                                          Toggled="OverlayFollowsCaretToggled" />
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="InsertionRow" Title="Text insertion"
                                           WideWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="InsertionChoice"
                                      AutomationProperties.AutomationId="InsertionChoice"
                                      AutomationProperties.Name="Text insertion"
                                      SelectionChanged="InsertionMethodChanged">
                                <x:String>Paste text</x:String>
                                <x:String>Type characters</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="PasteShortcutRow" IsChild="True"
                                           Title="Paste shortcut"
                                           Description="Use the shortcut your editor or terminal accepts. Applies to all paste dictation. Not detected automatically."
                                           WideWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="PasteShortcutChoice"
                                      AutomationProperties.AutomationId="PasteShortcutChoice"
                                      AutomationProperties.Name="Paste shortcut"
                                      SelectionChanged="PasteShortcutChanged">
                                <x:String>Ctrl+V</x:String>
                                <x:String>Shift+Insert</x:String>
                                <x:String>Ctrl+Shift+V</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="TypingGapRow" IsChild="True"
                                           Visibility="Collapsed"
                                           Title="Gap between characters (ms)"
                                           Description="0 sends all text at once, which some apps such as Notepad garble. Windows may round short gaps up to about 15 ms."
                                           WideWidth="{StaticResource SettingsNumberWidth}">
                            <NumberBox x:Name="TypingGapBox"
                                       AutomationProperties.AutomationId="TypingGapBox"
                                       AutomationProperties.Name="Gap between typed characters in milliseconds"
                                       Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="TypingGapChanged" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                <TextBlock Text="Record chord" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <local:SettingsRow Title="Dictate with screen and ink" ShowDivider="False" CompactAlignment="Left"
                                           Description="Records the monitor under the pointer with silent video. Drag to draw while mouse input is blocked on all monitors. Esc discards the take. Images are pasted into chat; recordings stay on this device for up to seven days or 2 GB.">
                            <ToggleSwitch x:Name="RecordChordToggle" AutomationProperties.Name="Enable record chord"
                                          Toggled="RecordChordToggled" />
                        </local:SettingsRow>
                        <local:SettingsRow Title="Record shortcut" Description="Uses the same hold or press behavior as dictation.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="RecordHotkeyCaptureBox" IsReadOnly="True" MinWidth="150"
                                         AutomationProperties.Name="Record shortcut" TextAlignment="Center"
                                         GotFocus="ShortcutGotFocus" KeyDown="ShortcutKeyDown" KeyUp="ShortcutKeyUp"
                                         LostFocus="ShortcutLostFocus" />
                                <Button x:Name="ChangeRecordShortcutButton" Content="Change" Click="ChangeRecordShortcutClicked" />
                                <HyperlinkButton x:Name="ResetRecordShortcutButton" Content="Reset" Click="ResetRecordShortcutClicked"
                                                 AutomationProperties.Name="Reset record shortcut" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Title="Include video link in pasted text" CompactAlignment="Left"
                                           Description="Adds a local file URL. Web and cloud agents cannot open it. The URL reveals this device's local path.">
                            <ToggleSwitch x:Name="IncludeVideoLinkToggle" AutomationProperties.Name="Include video link in pasted text"
                                          Toggled="IncludeVideoLinkToggled" />
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="CaptureStorageRow" Title="Saved captures" Description="Checking size…">
                            <Button x:Name="DeleteCapturesButton" Content="Delete all captures" Click="DeleteCapturesClicked" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                <TextBlock Text="Recognition" Style="{StaticResource SettingsSectionTitleStyle}" />
                <TextBlock Text="Applies to the next dictation." Style="{StaticResource SettingsLedeStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <local:SettingsRow Title="Microphone boost (dB)"
                                           Description="For quiet speech or whispering. 0 is off; try 6 or 12 dB first. Higher boost also raises background noise and can distort louder speech."
                                           ShowDivider="False"
                                           WideWidth="{StaticResource SettingsNumberWidth}">
                            <NumberBox x:Name="MicrophoneBoostBox"
                                       AutomationProperties.AutomationId="MicrophoneBoostBox"
                                       AutomationProperties.Name="Microphone boost in decibels"
                                       AutomationProperties.HelpText="0 is off. Applies to the next microphone dictation."
                                       Minimum="0" Maximum="24" SmallChange="6" LargeChange="12"
                                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="MicrophoneBoostChanged" />
                        </local:SettingsRow>

                        <local:SettingsRow Title="Language hint"
                                           Description="Leave empty to use the model default."
                                           WideWidth="{StaticResource SettingsFieldWidth}">
                            <TextBox x:Name="LanguageBox"
                                     AutomationProperties.Name="Language hint" PlaceholderText="Model default"
                                     TextChanged="LanguageChanged" />
                        </local:SettingsRow>

                        <local:SettingsRow Title="Processor"
                                           Description="Auto compares CPU and GPU on a bundled speech sample and keeps the faster working device for each model. A manual choice skips the comparison. Applies to the next recognition."
                                           WideWidth="{StaticResource SettingsFieldWidth}">
                            <ComboBox x:Name="BackendChoice"
                                      AutomationProperties.Name="Processor"
                                      AutomationProperties.AutomationId="BackendChoice"
                                      SelectionChanged="BackendChanged">
                                <x:String>Auto (recommended)</x:String>
                                <x:String>CPU</x:String>
                                <x:String>Vulkan</x:String>
                            </ComboBox>
                        </local:SettingsRow>

                        <local:DeviceComparisonView x:Name="DeviceComparison" Margin="{StaticResource SettingsBenchmarkMargin}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                <TextBlock Text="Meetings" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <local:SettingsRow Title="Suggest notes when Teams uses the microphone"
                                       Description="Checks app activity without recording audio. You must click Start to capture a meeting. Calendar access is not used."
                                       ShowDivider="False" CompactAlignment="Left">
                        <ToggleSwitch x:Name="AutoDetectMeetingsToggle"
                                      AutomationProperties.AutomationId="AutoDetectMeetingsChoice"
                                      AutomationProperties.Name="Suggest notes when Teams uses the microphone"
                                      Toggled="AutoDetectMeetingsChanged" />
                    </local:SettingsRow>
                </Border>

                <TextBlock Text="Transcript cleanup" Margin="0,16,0,0"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Text="Sends completed meeting text, never audio, to the service you choose. Original wording is kept."
                           Style="{StaticResource SettingsLedeStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <ContentControl x:Name="CleanupSettingsPanel" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <local:SettingsRow x:Name="CleanupProviderRow" Title="Service"
                                               ShowDivider="False"
                                               WideWidth="{StaticResource SettingsFieldWidth}">
                                <ComboBox x:Name="CleanupProviderChoice" AutomationProperties.Name="Cleanup provider"
                                          SelectionChanged="CleanupProviderChanged" HorizontalAlignment="Stretch">
                                    <x:String>Copilot CLI</x:String>
                                    <x:String>OpenAI API</x:String>
                                </ComboBox>
                            </local:SettingsRow>

                            <StackPanel x:Name="CopilotCleanupFields">
                                <local:SettingsRow Title="Model" IsChild="True"
                                                   WideWidth="{StaticResource SettingsFieldWidth}">
                                    <TextBox x:Name="CopilotCleanupModelBox" MaxLength="128"
                                             AutomationProperties.Name="Copilot cleanup model"
                                             LostFocus="CleanupModelCommitted" KeyDown="CleanupModelKeyDown" />
                                </local:SettingsRow>
                                <local:SettingsRow Title="Reasoning effort" IsChild="True"
                                                   WideWidth="{StaticResource SettingsFieldWidth}">
                                    <ComboBox x:Name="CopilotCleanupEffortChoice" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Copilot cleanup reasoning effort"
                                              SelectionChanged="CleanupEffortChanged" />
                                </local:SettingsRow>
                            </StackPanel>

                            <StackPanel x:Name="OpenAICleanupFields">
                                <local:SettingsRow Title="Model" IsChild="True"
                                                   WideWidth="{StaticResource SettingsFieldWidth}">
                                    <TextBox x:Name="OpenAICleanupModelBox" MaxLength="128"
                                             PlaceholderText="Model ID from your OpenAI account"
                                             AutomationProperties.Name="OpenAI cleanup model"
                                             LostFocus="CleanupModelCommitted" KeyDown="CleanupModelKeyDown" />
                                </local:SettingsRow>
                                <local:SettingsRow Title="Reasoning effort" IsChild="True"
                                                   WideWidth="{StaticResource SettingsFieldWidth}">
                                    <ComboBox x:Name="OpenAICleanupEffortChoice" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="OpenAI cleanup reasoning effort"
                                              SelectionChanged="CleanupEffortChanged" />
                                </local:SettingsRow>
                                <local:SettingsRow x:Name="OpenAIKeyRow" Title="API key" IsChild="True">
                                    <StackPanel Spacing="8">
                                        <PasswordBox x:Name="OpenAIKeyBox" MaxLength="1024" Width="{StaticResource SettingsFieldWidth}"
                                                     HorizontalAlignment="Right"
                                                     PlaceholderText="Enter a key to save or replace it"
                                                     PasswordRevealMode="Hidden" AutomationProperties.Name="OpenAI API key" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="Save API key" Click="SaveOpenAIKeyClicked" />
                                            <Button Content="Remove saved key" Click="RemoveOpenAIKeyClicked" />
                                        </StackPanel>
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>

                            <local:SettingsRow Title="Clean up automatically"
                                               Description="Off until you turn it on. Manual cleanup stays available on each meeting."
                                               CompactAlignment="Left">
                                <ToggleSwitch x:Name="AutomaticCleanupToggle"
                                              AutomationProperties.Name="Automatic transcript cleanup"
                                              Toggled="AutomaticCleanupToggled" />
                            </local:SettingsRow>

                        </StackPanel>
                    </ContentControl>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionHeaderGap}">
                <TextBlock Text="Privacy and data" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <local:SettingsRow Title="Hide overlay and meeting windows from capture"
                                           Description="Applies to supported Windows screenshots and screen sharing. The main window stays visible. Some recorders can still capture protected windows."
                                           ShowDivider="False" CompactAlignment="Left">
                            <ToggleSwitch x:Name="HideFromCaptureToggle"
                                          AutomationProperties.AutomationId="HideFromCaptureChoice"
                                          AutomationProperties.Name="Hide overlay and meeting windows from capture"
                                          Toggled="HideFromCaptureChanged" />
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="UsageRow" Title="Usage statistics"
                                           Description="Records session counts only. Never audio or text."
                                           CompactAlignment="Left">
                            <ToggleSwitch x:Name="UsageToggle"
                                          AutomationProperties.AutomationId="UsageToggle"
                                          AutomationProperties.Name="Usage statistics"
                                          Toggled="UsageToggled" />
                        </local:SettingsRow>

                        <local:SettingsRow x:Name="DiagnosticsRow" Title="Local diagnostics"
                                           Description="Operational metadata stays on this device. No audio or transcript text is recorded."
                                           CompactAlignment="Left">
                            <ToggleSwitch x:Name="DiagnosticsToggle"
                                          AutomationProperties.AutomationId="DiagnosticsToggle"
                                          AutomationProperties.Name="Local diagnostics"
                                          Toggled="DiagnosticsToggled" />
                        </local:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </local:PageCanvas>
</Page>
