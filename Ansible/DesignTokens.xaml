<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <!--
        Colour. Neutral text, fills, strokes, and materials are WinUI's own theme resources, used by name and never
        redefined here, so Mica, Acrylic, High Contrast, and transparency fallbacks stay the platform's. The only
        colour this dictionary owns is the citron brand accent: the ramp WinUI derives its accent brushes from, the
        primary button, the activity ramp, and the app mark.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- WinUI derives its accent brushes from this ramp: toggles, sliders, progress, and accent text. -->
            <Color x:Key="SystemAccentColor">#D3EB62</Color>
            <Color x:Key="SystemAccentColorLight1">#E0F08C</Color>
            <Color x:Key="SystemAccentColorLight2">#EAF5B1</Color>
            <Color x:Key="SystemAccentColorLight3">#F4F9D7</Color>
            <Color x:Key="SystemAccentColorDark1">#526719</Color>
            <Color x:Key="SystemAccentColorDark2">#435414</Color>
            <Color x:Key="SystemAccentColorDark3">#35420F</Color>
            <Color x:Key="BrandAccentColor">#D3EB62</Color>
            <Color x:Key="BrandAccentStrongColor">#B9D63F</Color>
            <Color x:Key="BrandAccentSoftColor">#E9F797</Color>
            <Color x:Key="BrandOnAccentColor">#19210D</Color>
            <!-- The accent as a graphic on a neutral surface: olive on light, citron on dark. -->
            <Color x:Key="BrandAccentGraphicColor">#526719</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="ActivityLowBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="ActivityMediumBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="ActivityHighBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.8" />
            <x:Double x:Key="FutureActivityOpacity">0.35</x:Double>

            <!-- The primary button is citron with ink text in both themes. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource BrandAccentStrongColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource BrandAccentSoftColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{StaticResource BrandAccentStrongColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource BrandAccentSoftColor}" />

            <LinearGradientBrush x:Key="AppBrandVoiceBrush" StartPoint="0.124748886,0.095063823" EndPoint="0.635967368,0.887388920">
                <GradientStop Color="#687384" Offset="0" />
                <GradientStop Color="#414B5E" Offset="0.35" />
                <GradientStop Color="#293144" Offset="0.7" />
                <GradientStop Color="#161C2A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppBrandReplyBrush" StartPoint="0.203780099,0.108486502" EndPoint="0.915343807,0.919447693">
                <GradientStop Color="#FAFFD2" Offset="0" />
                <GradientStop Color="#E9F797" Offset="0.35" />
                <GradientStop Color="#D3EB62" Offset="0.7" />
                <GradientStop Color="#B9D63F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AppBrandVoiceDetailBrush" Color="#DFE5EB" />
            <SolidColorBrush x:Key="AppBrandReplyDetailBrush" Color="#4A5F1C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- WinUI derives its accent brushes from this ramp: toggles, sliders, progress, and accent text. -->
            <Color x:Key="SystemAccentColor">#D3EB62</Color>
            <Color x:Key="SystemAccentColorLight1">#E9F797</Color>
            <Color x:Key="SystemAccentColorLight2">#D3EB62</Color>
            <Color x:Key="SystemAccentColorLight3">#B9D63F</Color>
            <Color x:Key="SystemAccentColorDark1">#A9C45C</Color>
            <Color x:Key="SystemAccentColorDark2">#879B45</Color>
            <Color x:Key="SystemAccentColorDark3">#657F1E</Color>
            <Color x:Key="BrandAccentColor">#D3EB62</Color>
            <Color x:Key="BrandAccentStrongColor">#B9D63F</Color>
            <Color x:Key="BrandAccentSoftColor">#E9F797</Color>
            <Color x:Key="BrandOnAccentColor">#19210D</Color>
            <!-- The accent as a graphic on a neutral surface: olive on light, citron on dark. -->
            <Color x:Key="BrandAccentGraphicColor">#D3EB62</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="ActivityLowBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="ActivityMediumBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="ActivityHighBrush" Color="{StaticResource BrandAccentGraphicColor}" Opacity="0.8" />
            <x:Double x:Key="FutureActivityOpacity">0.35</x:Double>

            <!-- The primary button is citron with ink text in both themes. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource BrandAccentStrongColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource BrandAccentSoftColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{StaticResource BrandAccentStrongColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource BrandAccentSoftColor}" />

            <LinearGradientBrush x:Key="AppBrandVoiceBrush" StartPoint="0.124748886,0.095063823" EndPoint="0.635967368,0.887388920">
                <GradientStop Color="#687384" Offset="0" />
                <GradientStop Color="#414B5E" Offset="0.35" />
                <GradientStop Color="#293144" Offset="0.7" />
                <GradientStop Color="#161C2A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppBrandReplyBrush" StartPoint="0.203780099,0.108486502" EndPoint="0.915343807,0.919447693">
                <GradientStop Color="#FAFFD2" Offset="0" />
                <GradientStop Color="#E9F797" Offset="0.35" />
                <GradientStop Color="#D3EB62" Offset="0.7" />
                <GradientStop Color="#B9D63F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AppBrandVoiceDetailBrush" Color="#DFE5EB" />
            <SolidColorBrush x:Key="AppBrandReplyDetailBrush" Color="#4A5F1C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ActivityLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ActivityMediumBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ActivityHighBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <x:Double x:Key="FutureActivityOpacity">1</x:Double>
            <SolidColorBrush x:Key="AppBrandVoiceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppBrandReplyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppBrandVoiceDetailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppBrandReplyDetailBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Dimensions, type, motion, and shared styles. -->
    <x:Double x:Key="PageContentMaxWidth">1440</x:Double>
    <Thickness x:Key="PagePadding">36,24,40,40</Thickness>
    <Thickness x:Key="CompactPagePadding">18</Thickness>
    <x:Double x:Key="CompactPageThreshold">800</x:Double>
    <x:Double x:Key="NarrowActionsThreshold">400</x:Double>
    <x:Double x:Key="ShortcutStackThreshold">440</x:Double>
    <x:Double x:Key="HistorySearchStackThreshold">520</x:Double>
    <GridLength x:Key="HistorySearchColumnWidth">280</GridLength>
    <!-- Two 400 DIP cards plus the 16 DIP gutter keep model names and status readable. -->
    <Thickness x:Key="PageSectionBottomMargin">0,0,0,20</Thickness>
    <x:Double x:Key="PageSectionSpacing">28</x:Double>
    <!-- Window notices float bottom-centred over the content panel. -->
    <Thickness x:Key="NoticeHostMargin">24,0,24,16</Thickness>
    <x:Double x:Key="NoticeHostMaxWidth">680</x:Double>
    <x:Double x:Key="NoticeHostSpacing">8</x:Double>
    <x:Double x:Key="CardGap">20</x:Double>
    <x:Double x:Key="SectionHeaderGap">10</x:Double>
    <x:Double x:Key="HomeSectionTitleFontSize">28</x:Double>
    <!-- Home grid: a 320 DIP insights rail beside history, 32 DIP apart. Below 1040 DIP of page content the rail
         would squeeze history, so the cards move above it as a strip. -->
    <GridLength x:Key="HomeRailColumnWidth">320</GridLength>
    <x:Double x:Key="HomeRailStackThreshold">1040</x:Double>
    <x:Double x:Key="HomeGridGap">32</x:Double>
    <x:Double x:Key="NavSelectionBarWidth">3</x:Double>
    <Thickness x:Key="NavSelectionBarMargin">0,12</Thickness>
    <FontFamily x:Key="InsightNumeralFontFamily">Consolas</FontFamily>
    <x:Double x:Key="InsightNumeralFontSize">22</x:Double>
    <x:Double x:Key="InsightTotalNumeralFontSize">32</x:Double>
    <x:Double x:Key="HomeSectionHeaderMinHeight">36</x:Double>
    <x:Double x:Key="NavLabelGap">12</x:Double>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="HomeMetricCardPadding">20</Thickness>
    <Thickness x:Key="SettingsCardPadding">24,4,24,4</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <x:Double x:Key="IconSize">18</x:Double>
    <x:Double x:Key="RadioButtonsColumnSpacing">2</x:Double>
    <x:Double x:Key="RadioButtonsRowSpacing">2</x:Double>
    <x:Double x:Key="NavHeight">40</x:Double>
    <x:Double x:Key="SidebarWidth">248</x:Double>
    <GridLength x:Key="SidebarColumnWidth">248</GridLength>
    <GridLength x:Key="CompactSidebarColumnWidth">72</GridLength>
    <x:Double x:Key="CompactNavigationThreshold">1000</x:Double>
    <Thickness x:Key="CompactSidebarPadding">8,12,8,12</Thickness>
    <Thickness x:Key="SidebarPadding">12,12,12,12</Thickness>
    <!-- The brand sits in the title bar row above the sidebar, aligned with the navigation icons. -->
    <Thickness x:Key="SidebarBrandMargin">24,0,12,0</Thickness>
    <!-- The page area is an inset content layer under the title bar, beside the sidebar. -->
    <Thickness x:Key="ContentLayerMargin">0,4,4,4</Thickness>
    <CornerRadius x:Key="ContentLayerCornerRadius">8</CornerRadius>
    <Thickness x:Key="TitleBarPageTitleMargin">40,0,12,0</Thickness>
    <Thickness x:Key="CompactTitleBarPageTitleMargin">20,0,12,0</Thickness>
    <x:Double x:Key="BenchmarkBarHeight">8</x:Double>
    <x:Double x:Key="BenchmarkValueMaxWidth">160</x:Double>
    <CornerRadius x:Key="BenchmarkBarCornerRadius">4</CornerRadius>
    <x:Double x:Key="SettingsRowRowSpacing">12</x:Double>
    <x:Double x:Key="SettingsRowDescriptionSpacing">5</x:Double>
    <x:Double x:Key="SettingsRowDescriptionMaxWidth">620</x:Double>
    <x:Double x:Key="SettingsSelectWidth">320</x:Double>
    <x:Double x:Key="SettingsNumberWidth">132</x:Double>
    <x:Double x:Key="SettingsLanguageWidth">180</x:Double>
    <x:Double x:Key="SettingsWideMinWidth">700</x:Double>
    <Thickness x:Key="SettingsRowPadding">0,20</Thickness>
    <Thickness x:Key="SettingsBenchmarkMargin">0,0,0,20</Thickness>
    <x:Double x:Key="SettingsRowColumnGap">32</x:Double>
    <x:Double x:Key="SettingsLabelFontSize">14.5</x:Double>
    <x:Double x:Key="SettingsLabelLineHeight">20</x:Double>
    <x:Double x:Key="SettingsDescriptionFontSize">13</x:Double>
    <x:Double x:Key="SettingsDescriptionLineHeight">19.5</x:Double>
    <x:Double x:Key="SettingsLinkFontSize">13.5</x:Double>
    <x:Double x:Key="SettingsOptionFontSize">14</x:Double>
    <Thickness x:Key="BenchmarkPanelPadding">24,20</Thickness>
    <CornerRadius x:Key="BenchmarkPanelCornerRadius">12</CornerRadius>
    <x:Double x:Key="BenchmarkColumnGap">32</x:Double>
    <x:Double x:Key="BenchmarkRowGap">18</x:Double>
    <x:Double x:Key="BenchmarkBarGap">12</x:Double>
    <x:Double x:Key="BenchmarkLabelWidth">52</x:Double>
    <x:Double x:Key="BenchmarkValueMinWidth">84</x:Double>
    <x:Double x:Key="BenchmarkResultWidth">340</x:Double>
    <x:Double x:Key="BenchmarkLabelFontSize">13</x:Double>
    <x:Double x:Key="BenchmarkFootnoteFontSize">12</x:Double>
    <x:Double x:Key="BenchmarkFootnoteLineHeight">18</x:Double>
    <x:Double x:Key="NavItemGap">4</x:Double>
    <x:Double x:Key="BrandSize">32</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="PageTitleFontSize">28</x:Double>
    <x:Double x:Key="MetricValueFontSize">30</x:Double>
    <x:Double x:Key="PageTitleLineHeight">34</x:Double>
    <x:Double x:Key="StatValueLineHeight">36</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="BodyLineHeight">18</x:Double>
    <x:Double x:Key="BodyStrongFontSize">14</x:Double>
    <x:Double x:Key="CaptionFontSize">12.5</x:Double>
    <x:Double x:Key="CaptionLineHeight">16</x:Double>
    <x:Double x:Key="SubtitleFontSize">14.5</x:Double>
    <x:Double x:Key="KeycapFontSize">12.5</x:Double>
    <x:Double x:Key="KeycapLineHeight">16</x:Double>
    <x:Double x:Key="KeycapMinHeight">24</x:Double>
    <x:Double x:Key="SearchKeycapFontSize">11.5</x:Double>
    <x:Double x:Key="SearchKeycapLineHeight">14</x:Double>
    <x:Double x:Key="SearchKeycapMinHeight">22</x:Double>
    <Thickness x:Key="KeycapPadding">8,3</Thickness>
    <Thickness x:Key="SearchKeycapPadding">8,2</Thickness>
    <Thickness x:Key="SearchKeycapMargin">0,0,8,0</Thickness>
    <Thickness x:Key="KeycapBorderThickness">0,0,0,2</Thickness>
    <CornerRadius x:Key="KeycapCornerRadius">6</CornerRadius>
    <x:Double x:Key="HomeStatsGap">16</x:Double>
    <x:Double x:Key="HomeMetricColumnGap">12</x:Double>
    <x:Double x:Key="HomeModelRowsGap">8</x:Double>
    <x:Double x:Key="HomeModelTrackHeight">6</x:Double>
    <CornerRadius x:Key="HomeModelTrackCornerRadius">3</CornerRadius>
    <x:Double x:Key="HomeModelsCardGap">14</x:Double>
    <x:Double x:Key="HomeCardTitleFontSize">15</x:Double>
    <x:Double x:Key="HomeCardMetaFontSize">12.5</x:Double>
    <x:Double x:Key="HomeCardFootnoteFontSize">12</x:Double>
    <x:Double x:Key="HistoryEmptyTitleFontSize">14</x:Double>
    <x:Double x:Key="HistoryEmptyDetailFontSize">12.5</x:Double>
    <x:Double x:Key="HistoryEmptyGap">4</x:Double>
    <x:Double x:Key="HomeActivityHeatmapGap">4</x:Double>
    <Thickness x:Key="SectionBadgePadding">10,4</Thickness>
    <CornerRadius x:Key="SectionBadgeCornerRadius">6</CornerRadius>
    <x:Double x:Key="SectionBadgeMinHeight">28</x:Double>
    <x:Double x:Key="SectionBadgeMaxWidth">240</x:Double>
    <Thickness x:Key="HistorySearchPadding">36,7,68,7</Thickness>
    <x:Double x:Key="HistorySearchFontSize">13.5</x:Double>
    <x:Double x:Key="HomeLegendChipSize">11</x:Double>
    <CornerRadius x:Key="HomeLegendChipCornerRadius">3</CornerRadius>
    <!-- History timeline rows (Pencil P4f14c rows xwIiZ..tSBom). -->
    <Thickness x:Key="HistoryRowPadding">20,14,12,14</Thickness>
    <CornerRadius x:Key="HistoryRowCornerRadius">10</CornerRadius>
    <GridLength x:Key="HistoryTimeColumnWidth">64</GridLength>
    <x:Double x:Key="HistoryRowColumnGap">20</x:Double>
    <x:Double x:Key="HistoryTranscriptFontSize">15.5</x:Double>
    <x:Double x:Key="HistoryTranscriptLineHeight">24</x:Double>
    <x:Double x:Key="HistoryTimeFontSize">13</x:Double>
    <x:Double x:Key="HistoryMetaFontSize">12</x:Double>
    <x:Double x:Key="HistoryMetaGap">8</x:Double>
    <x:Double x:Key="HistoryGroupLabelFontSize">11.5</x:Double>
    <x:Double x:Key="IconButtonSize">32</x:Double>
    <x:Double x:Key="IconButtonGlyphSize">16</x:Double>
    <x:Double x:Key="HistoryActionGap">2</x:Double>
    <x:Double x:Key="PillBackdropTintOpacity">0.8</x:Double>
    <!-- Motion. Theme transitions follow the Windows animation setting on their own. -->
    <x:Double x:Key="MotionFastMilliseconds">120</x:Double>
    <x:Double x:Key="MotionNormalMilliseconds">200</x:Double>
    <x:Double x:Key="MotionEntranceOffset">12</x:Double>



    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A heading for a group of rows within a page section, such as Speech models groups. -->
    <Style x:Key="GroupHeadingTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MetricValueTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource MetricValueFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource StatValueLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AppWordmarkStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="LineHeight" Value="{StaticResource PageTitleLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="StatValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource MetricValueFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource StatValueLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- Shared input surfaces keep native WinUI templates and interaction states. -->
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="controls:NumberBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="HomeCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource HomeCardTitleFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="HomeCardMetaStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
        <Setter Property="FontSize" Value="{StaticResource HomeCardMetaFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="HomeCardFootnoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
        <Setter Property="FontSize" Value="{StaticResource HomeCardFootnoteFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="HomeMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>
    <Style x:Key="HistoryEmptyTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource HistoryEmptyTitleFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="HistoryEmptyDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
        <Setter Property="FontSize" Value="{StaticResource HistoryEmptyDetailFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeycapStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KeycapBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource KeycapCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource KeycapPadding}" />
