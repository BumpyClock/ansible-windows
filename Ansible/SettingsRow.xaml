<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.SettingsRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Content>
        <Grid x:Name="LayoutRoot"
              ColumnSpacing="{StaticResource CardGap}"
              RowSpacing="{StaticResource SettingsRowRowSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="DescriptionPanel"
                    Spacing="{StaticResource SettingsRowDescriptionSpacing}"
                    MaxWidth="{StaticResource SettingsRowDescriptionMaxWidth}"
                    HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <TextBlock x:Name="DescriptionText"
                       Text="{x:Bind Description, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionSecondaryStyle}" />
        </StackPanel>

        <ContentPresenter x:Name="ControlPresenter"
                          Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Content="{x:Bind ControlContent, Mode=OneWay}" />
        </Grid>
    </UserControl.Content>
</UserControl>
