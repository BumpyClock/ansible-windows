<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.SettingsRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Content>
        <Grid x:Name="LayoutRoot"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              ColumnSpacing="{StaticResource SettingsRowColumnGap}"
              RowSpacing="{StaticResource SettingsRowRowSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="DescriptionPanel"
                    Spacing="{StaticResource SettingsRowDescriptionSpacing}"
                    MaxWidth="{StaticResource SettingsRowDescriptionMaxWidth}"
                    HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="{StaticResource BodyFontSize}"
                       LineHeight="{StaticResource BodyLineHeight}"
                       FontWeight="Medium"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <TextBlock x:Name="DescriptionText"
                       Text="{x:Bind Description, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource CaptionFontSize}"
                       LineHeight="{StaticResource CaptionLineHeight}"
                       Style="{StaticResource CaptionSecondaryStyle}" />
        </StackPanel>

        <!-- A toggle's On/Off label sits before the switch, as in Windows Settings, so every control ends at the right edge. -->
        <Grid x:Name="ControlPresenter" Grid.Row="1" VerticalAlignment="Center" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ToggleStateText" Visibility="Collapsed" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
            <ContentPresenter Grid.Column="1" Content="{x:Bind ControlContent, Mode=OneWay}" />
        </Grid>
        </Grid>
    </UserControl.Content>
</UserControl>
