<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.HomeInsightsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="HomeStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HomeStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <DataTemplate x:Key="PrimaryModelTemplate" x:DataType="local:HomeModelViewModel">
                <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource HomeModelDotStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind FullName}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                                 AutomationProperties.Name="{x:Bind DisplayName}"
                                 Style="{StaticResource HomeModelPrimaryBarStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SecondaryModelTemplate" x:DataType="local:HomeModelViewModel">
                <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind FullName}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                                 AutomationProperties.Name="{x:Bind DisplayName}"
                                 Style="{StaticResource HomeModelSecondaryBarStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
            <local:HomeModelTemplateSelector x:Key="HomeModelTemplateSelector"
                                             PrimaryTemplate="{StaticResource PrimaryModelTemplate}"
                                             SecondaryTemplate="{StaticResource SecondaryModelTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <local:CardFlowPanel x:Name="RailCards" RowSpacing="16" ColumnSpacing="16" VerticalAlignment="Top"
          AutomationProperties.Name="Your voice, in numbers" AutomationProperties.LandmarkType="Custom"
          AutomationProperties.LocalizedLandmarkType="Your voice, in numbers">
        <Border x:Name="WordsCard" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Words dictated" Style="{StaticResource HomeCardTitleStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="All time on this device" Style="{StaticResource HomeStatLabelStyle}" />
                </StackPanel>
                <TextBlock x:Name="HomeWordsText" Grid.Row="2" Text="--" Margin="0,4,0,0" TextWrapping="NoWrap"
                           Style="{StaticResource TitleLargeTextBlockStyle}" />
                <local:CardFlowPanel Grid.Row="4" MinColumnWidth="76" ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="HomePaceText" Text="--" Style="{StaticResource HomeStatValueStyle}" />
                        <TextBlock Text="Words / min" Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HomeSessionsText" Text="--" Style="{StaticResource HomeStatValueStyle}" />
                        <TextBlock Text="Dictations" Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HomeMicrophoneText" Text="--" Style="{StaticResource HomeStatValueStyle}" />
                        <TextBlock Text="Mic minutes" Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                </local:CardFlowPanel>
                <TextBlock x:Name="HomeInsightsFootnote" Grid.Row="6" Text="Usage statistics are not available yet." Margin="0,12,0,0"
                           Style="{StaticResource HomeStatLabelStyle}" />
                <Border Grid.Row="8" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="{StaticResource HomeModelsCardGap}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Most-used models" Style="{StaticResource HomeCardTitleStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="Dictations and transcribed files · all time" Style="{StaticResource HomeStatLabelStyle}" />
                        </StackPanel>
                        <muxc:ItemsRepeater x:Name="HomeModelRows" ItemTemplate="{StaticResource HomeModelTemplateSelector}">
                            <muxc:ItemsRepeater.Layout><muxc:StackLayout Spacing="{StaticResource HomeModelsCardGap}" /></muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                        <TextBlock x:Name="NoModelDataText" Text="No completed sessions yet." TextWrapping="WrapWholeWords"
                                   Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="RhythmCard" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Daily rhythm" Style="{StaticResource HomeCardTitleStyle}"
                                   AutomationProperties.HeadingLevel="Level2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ActivityPeriodText" Text="Last 7 days"
                                   Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                    <muxc:SelectorBar x:Name="ActivityPeriodSelector" Grid.Column="1" Margin="0,-12,0,0" VerticalAlignment="Top"
                                      SelectionChanged="ActivityPeriodChanged"
                                      AutomationProperties.Name="Activity period">
                        <muxc:SelectorBarItem x:Name="WeekPeriodItem" Text="Week" IsSelected="True" />
                        <muxc:SelectorBarItem Text="Month" />
                    </muxc:SelectorBar>
                </Grid>

                <local:EmptyState x:Name="ActivityEmptyState" Grid.Row="1" Glyph="&#xE823;" Visibility="Collapsed" />

                <StackPanel x:Name="ActivityChartPanel" Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                    <local:Badge x:Name="HomeStreakPill" Text="" Margin="0,0,0,8" Visibility="Collapsed"
                                 ToolTipService.ToolTip="Consecutive local days with completed dictations. Includes yesterday if there are no dictations today." />
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="260"
                             HorizontalAlignment="Center">
                        <Canvas x:Name="ActivityClock" Width="320" Height="320"
                                AutomationProperties.Name="Dictations by local completion hour">
                            <Path x:Name="ClockBackgroundDots" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Path x:Name="ClockActiveDots" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Path x:Name="ClockTicks" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse Canvas.Left="92" Canvas.Top="92" Width="136" Height="136"
                                     Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Grid Canvas.Left="94" Canvas.Top="94" Width="132" Height="132"
                                  IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                    <Viewbox MaxWidth="116" MaxHeight="40" StretchDirection="DownOnly">
                                        <TextBlock x:Name="ActivityTotalText" Text="--" TextWrapping="NoWrap"
                                                   Style="{StaticResource TitleTextBlockStyle}" />
                                    </Viewbox>
                                    <TextBlock x:Name="ActivityUnitText" Text="dictations" HorizontalAlignment="Center"
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="00" Canvas.Left="140" Canvas.Top="2" Width="40" TextAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock Text="06" Canvas.Left="293" Canvas.Top="150" Width="27" TextAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock Text="12" Canvas.Left="140" Canvas.Top="300" Width="40" TextAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock Text="18" Canvas.Left="0" Canvas.Top="150" Width="27" TextAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                            <Canvas x:Name="ClockHitTargets" Width="320" Height="320" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="ActivityScaleText" HorizontalAlignment="Center"
                               Style="{StaticResource CaptionSecondaryStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActivityStartText" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="ActivityEndText" Grid.Column="1" HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionSecondaryStyle}" />
                    </Grid>
                    <TextBlock Text="Local time. Taller dots mean more dictations."
                               Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </local:CardFlowPanel>
</UserControl>
