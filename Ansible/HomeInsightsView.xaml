<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.HomeInsightsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- A stat is a Subtitle value over a caption label. Labels wrap between words, never inside one. -->
            <Style x:Key="HomeStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HomeStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="HomeChartAxisStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <!-- Model rows pair a name and a count of the same size, so both sit on one baseline. -->
            <DataTemplate x:Key="PrimaryModelTemplate" x:DataType="local:HomeModelViewModel">
                <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource HomeModelDotStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                                 AutomationProperties.Name="{x:Bind DisplayName}"
                                 Style="{StaticResource HomeModelPrimaryBarStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SecondaryModelTemplate" x:DataType="local:HomeModelViewModel">
                <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind DisplayName}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                                 AutomationProperties.Name="{x:Bind DisplayName}"
                                 Style="{StaticResource HomeModelSecondaryBarStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
            <local:HomeModelTemplateSelector x:Key="HomeModelTemplateSelector"
                                             PrimaryTemplate="{StaticResource PrimaryModelTemplate}"
                                             SecondaryTemplate="{StaticResource SecondaryModelTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Two cards: all-time usage with its models, and the daily rhythm. As a rail they stack in one column; as a
         strip above history they flow into columns. Each card keeps its natural height (VerticalAlignment Top), so a
         short card never carries dead space; only the empty rhythm card fills its row, with its message centred. -->
    <local:CardFlowPanel x:Name="RailCards" RowSpacing="16" ColumnSpacing="16" VerticalAlignment="Top"
          AutomationProperties.Name="Your voice, in numbers" AutomationProperties.LandmarkType="Custom"
          AutomationProperties.LocalizedLandmarkType="Your voice, in numbers">
        <Border x:Name="WordsCard" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Words dictated" Style="{StaticResource HomeCardTitleStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="All time on this device" Style="{StaticResource HomeStatLabelStyle}" />
                </StackPanel>
                <TextBlock x:Name="HomeWordsText" Text="--" Margin="0,4,0,0" TextWrapping="NoWrap"
                           Style="{StaticResource TitleLargeTextBlockStyle}" />
                <!-- Three stat groups reflow to fewer columns before a label would have to break. -->
                <local:CardFlowPanel MinColumnWidth="76" ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="HomePaceText" Text="--" Style="{StaticResource HomeStatValueStyle}" />
                        <TextBlock Text="Words / min" Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HomeSessionsText" Text="--" Style="{StaticResource HomeStatValueStyle}" />
                        <TextBlock Text="Dictations" Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HomeMicrophoneText" Text="--" Style="{StaticResource HomeStatValueStyle}" />
                        <TextBlock Text="Mic minutes" Style="{StaticResource HomeStatLabelStyle}" />
                    </StackPanel>
                </local:CardFlowPanel>
                <TextBlock x:Name="HomeInsightsFootnote" Text="Usage statistics are not available yet." Margin="0,12,0,0"
                           Style="{StaticResource HomeStatLabelStyle}" />
                <!-- Which models produced those words: the same all-time usage, so it shares the card. -->
                <Border Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="{StaticResource HomeModelsCardGap}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Most-used models" Style="{StaticResource HomeCardTitleStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="Dictation and file sessions · all time" Style="{StaticResource HomeStatLabelStyle}" />
                        </StackPanel>
                        <muxc:ItemsRepeater x:Name="HomeModelRows" ItemTemplate="{StaticResource HomeModelTemplateSelector}">
                            <muxc:ItemsRepeater.Layout><muxc:StackLayout Spacing="{StaticResource HomeModelsCardGap}" /></muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                        <TextBlock x:Name="NoModelDataText" Text="No completed sessions yet." TextWrapping="WrapWholeWords"
                                   Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="RhythmCard" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Daily rhythm" VerticalAlignment="Center" Style="{StaticResource HomeCardTitleStyle}"
                                   AutomationProperties.HeadingLevel="Level2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <muxc:SelectorBar x:Name="ActivityPeriodSelector" Grid.Column="1"
                                          SelectionChanged="ActivityPeriodChanged"
                                          AutomationProperties.Name="Activity period">
                            <muxc:SelectorBarItem x:Name="WeekPeriodItem" Text="Week" IsSelected="True" />
                            <muxc:SelectorBarItem Text="Month" />
                        </muxc:SelectorBar>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActivityPeriodText" Text="Last 7 days · includes today" VerticalAlignment="Center"
                                   Style="{StaticResource HomeStatLabelStyle}" />
                        <!-- Shown only for a real streak; "no streak" would only repeat an empty chart. -->
                        <local:Badge x:Name="HomeStreakPill" Grid.Column="1" Text="" VerticalAlignment="Center" Visibility="Collapsed"
                                     ToolTipService.ToolTip="Consecutive local days with completed dictations. Includes yesterday if there are no dictations today." />
                    </Grid>
                </StackPanel>

                <!-- No data: one quiet message where the chart would be. Nothing is drawn for activity that did not happen. -->
                <StackPanel x:Name="ActivityEmptyPanel" Grid.Row="1" Spacing="8" Padding="0,24"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE823;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="HomeActivityAvailabilityText" Text="Activity statistics are not available yet."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ActivityChartPanel" Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                    <!-- Only the ring geometry scales (320 to 256 DIP). Axis labels and the total are laid over it at
                         their real type sizes, so no chart text drops below Caption. -->
                    <Grid Width="256" Height="256" HorizontalAlignment="Center">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="ActivityClock" Width="320" Height="320"
                                    AutomationProperties.Name="Dictations by local completion hour">
                                <Path x:Name="ClockBackgroundDots" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Path x:Name="ClockActiveDots" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Path x:Name="ClockTicks" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Ellipse Canvas.Left="92" Canvas.Top="92" Width="136" Height="136"
                                         Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"
                                         IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Canvas x:Name="ClockHitTargets" Width="320" Height="320" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="00" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource HomeChartAxisStyle}" />
                        <TextBlock Text="06" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HomeChartAxisStyle}" />
                        <TextBlock Text="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource HomeChartAxisStyle}" />
                        <TextBlock Text="18" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource HomeChartAxisStyle}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock x:Name="ActivityTotalText" Text="--" HorizontalAlignment="Center" TextWrapping="NoWrap"
                                       Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="ActivityUnitText" Text="dictations" HorizontalAlignment="Center"
                                       Style="{StaticResource HomeChartAxisStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActivityStartText" Style="{StaticResource HomeChartAxisStyle}" />
                        <TextBlock x:Name="ActivityScaleText" Grid.Column="1" HorizontalAlignment="Center"
                                   Style="{StaticResource HomeChartAxisStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ActivityEndText" Grid.Column="2" Style="{StaticResource HomeChartAxisStyle}" />
                    </Grid>
                    <TextBlock Text="Local completion time. Dot height shows relative activity."
                               Style="{StaticResource HomeStatLabelStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </local:CardFlowPanel>
</UserControl>
