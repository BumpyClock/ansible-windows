<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.HomeInsightsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="InsightNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueTextBlockStyle}">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <DataTemplate x:Key="PrimaryModelTemplate" x:DataType="local:HomeModelViewModel">
                <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource HomeModelDotStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                                 AutomationProperties.Name="{x:Bind DisplayName}"
                                 Style="{StaticResource HomeModelPrimaryBarStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SecondaryModelTemplate" x:DataType="local:HomeModelViewModel">
                <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind DisplayName}" Style="{StaticResource HomeMetricLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                                 AutomationProperties.Name="{x:Bind DisplayName}"
                                 Style="{StaticResource HomeModelSecondaryBarStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
            <local:HomeModelTemplateSelector x:Key="HomeModelTemplateSelector"
                                             PrimaryTemplate="{StaticResource PrimaryModelTemplate}"
                                             SecondaryTemplate="{StaticResource SecondaryModelTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="InsightsColumn" Spacing="{StaticResource HomeSectionGap}" VerticalAlignment="Top">
        <muxc:InfoBar x:Name="UsageWarningBar" Title="Some usage statistics are missing"
                      Severity="Warning" IsOpen="False" IsClosable="False" Visibility="Collapsed" />

        <StackPanel Style="{StaticResource HomeSectionStyle}">
            <Grid Style="{StaticResource HomeSectionHeaderStyle}">
                <TextBlock Text="Your voice, in numbers" Style="{StaticResource HomeSectionTitleStyle}" />
            </Grid>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="WORDS DICTATED" Style="{StaticResource HomeMetricLabelStyle}" CharacterSpacing="100" />
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="76">
                            <TextBlock x:Name="HomeWordsText" Text="--" FontFamily="Consolas"
                                       FontSize="56" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.Name="All-time words dictated" />
                        </Viewbox>
                        <TextBlock Text="All time · on this device" Style="{StaticResource HomeCardMetaStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Activity" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <local:Badge x:Name="HomeStreakPill" Grid.Column="1" Text="--"
                                         HorizontalAlignment="Right"
                                         ToolTipService.ToolTip="Consecutive local days with completed dictations. Includes yesterday if there are no dictations today." />
                        </Grid>
                        <StackPanel Spacing="2">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Your daily rhythm" Style="{StaticResource HomeCardMetaStyle}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <muxc:SelectorBar x:Name="ActivityPeriodSelector" Grid.Column="1"
                                                  SelectionChanged="ActivityPeriodChanged"
                                                  AutomationProperties.Name="Activity period">
                                    <muxc:SelectorBarItem x:Name="WeekPeriodItem" Text="Week" IsSelected="True" />
                                    <muxc:SelectorBarItem Text="Month" />
                                </muxc:SelectorBar>
                            </Grid>
                            <TextBlock x:Name="ActivityPeriodText" Text="Last 7 days · includes today"
                                       Style="{StaticResource HomeCardFootnoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="HomeActivityAvailabilityText" Text="Activity statistics are not available yet."
                                   TextWrapping="Wrap" Style="{StaticResource HomeCardFootnoteStyle}" Visibility="Collapsed" />
                        <StackPanel x:Name="ActivityChartPanel" Spacing="4">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="280"
                                     HorizontalAlignment="Center">
                                <Canvas x:Name="ActivityClock" Width="320" Height="320"
                                        AutomationProperties.Name="Dictations by local completion hour">
                                    <Path x:Name="ClockBackgroundDots" Fill="{ThemeResource AppTrackBrush}"
                                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <Path x:Name="ClockActiveDots" Fill="{ThemeResource AccentGraphicBrush}"
                                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <Path x:Name="ClockTicks" Stroke="{ThemeResource AppMutedTextBrush}" StrokeThickness="1"
                                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <Ellipse Canvas.Left="92" Canvas.Top="92" Width="136" Height="136"
                                             Stroke="{ThemeResource AppBorderBrush}" StrokeThickness="1"
                                             IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <Grid Canvas.Left="94" Canvas.Top="94" Width="132" Height="132"
                                          IsHitTestVisible="False">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                            <Viewbox MaxWidth="116" MaxHeight="40" StretchDirection="DownOnly">
                                                <TextBlock x:Name="ActivityTotalText" Text="--" FontFamily="Consolas"
                                                           FontSize="32" FontWeight="SemiBold" />
                                            </Viewbox>
                                            <TextBlock x:Name="ActivityUnitText" Text="dictations" HorizontalAlignment="Center"
                                                       Style="{StaticResource HomeMetricLabelStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="00" Canvas.Left="140" Canvas.Top="2" Width="40" TextAlignment="Center"
                                               FontFamily="Consolas" Style="{StaticResource HomeCardMetaStyle}" />
                                    <TextBlock Text="06" Canvas.Left="293" Canvas.Top="150" Width="27" TextAlignment="Center"
                                               FontFamily="Consolas" Style="{StaticResource HomeCardMetaStyle}" />
                                    <TextBlock Text="12" Canvas.Left="140" Canvas.Top="300" Width="40" TextAlignment="Center"
                                               FontFamily="Consolas" Style="{StaticResource HomeCardMetaStyle}" />
                                    <TextBlock Text="18" Canvas.Left="0" Canvas.Top="150" Width="27" TextAlignment="Center"
                                               FontFamily="Consolas" Style="{StaticResource HomeCardMetaStyle}" />
                                    <Canvas x:Name="ClockHitTargets" Width="320" Height="320" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="ActivityScaleText" HorizontalAlignment="Center"
                                       Style="{StaticResource HomeCardFootnoteStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ActivityStartText" Style="{StaticResource HomeCardFootnoteStyle}" />
                                <TextBlock x:Name="ActivityEndText" Grid.Column="1" HorizontalAlignment="Right"
                                           Style="{StaticResource HomeCardFootnoteStyle}" />
                            </Grid>
                            <TextBlock Text="Local completion time. Dot height shows relative activity."
                                       Style="{StaticResource HomeCardFootnoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="{StaticResource HomeMetricColumnGap}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HomePaceText" Text="--" Style="{StaticResource InsightNumberStyle}"
                                       AutomationProperties.Name="All-time words per microphone minute" />
                            <TextBlock Text="Words / min" Style="{StaticResource HomeMetricLabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="HomeSessionsText" Text="--" Style="{StaticResource InsightNumberStyle}"
                                       AutomationProperties.Name="All-time dictations" />
                            <TextBlock Text="Dictations" Style="{StaticResource HomeMetricLabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock x:Name="HomeMicrophoneText" Text="--" Style="{StaticResource InsightNumberStyle}"
                                       AutomationProperties.Name="All-time microphone minutes, pauses included" />
                            <TextBlock Text="Mic minutes" Style="{StaticResource HomeMetricLabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HomeInsightsFootnote" Text="Usage statistics are not available yet."
                               Style="{StaticResource HomeCardFootnoteStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Style="{StaticResource HomeSectionStyle}">
            <Grid Style="{StaticResource HomeSectionHeaderStyle}">
                <TextBlock Text="Most-used models" Style="{StaticResource HomeSectionTitleStyle}" />
            </Grid>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="{StaticResource HomeModelsCardGap}">
                    <TextBlock Text="Dictation + file sessions · all time" Style="{StaticResource HomeCardFootnoteStyle}" TextWrapping="Wrap" />
                    <muxc:ItemsRepeater x:Name="HomeModelRows" ItemTemplate="{StaticResource HomeModelTemplateSelector}">
                        <muxc:ItemsRepeater.Layout><muxc:StackLayout Spacing="{StaticResource HomeModelsCardGap}" /></muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                    <TextBlock x:Name="NoModelDataText" Text="No completed sessions yet." TextWrapping="Wrap"
                               Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
