<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.HomeInsightsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="PrimaryModelTemplate" x:DataType="local:HomeModelViewModel">
            <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource HomeModelDotStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                             Style="{StaticResource HomeModelPrimaryBarStyle}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SecondaryModelTemplate" x:DataType="local:HomeModelViewModel">
            <StackPanel Spacing="{StaticResource HomeModelRowsGap}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource HomeMetricLabelStyle}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <ProgressBar Maximum="{x:Bind MaximumSessions}" Value="{x:Bind Sessions}"
                             Style="{StaticResource HomeModelSecondaryBarStyle}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
        <local:HomeModelTemplateSelector x:Key="HomeModelTemplateSelector"
                                         PrimaryTemplate="{StaticResource PrimaryModelTemplate}"
                                         SecondaryTemplate="{StaticResource SecondaryModelTemplate}" />
    </UserControl.Resources>
    <StackPanel x:Name="InsightsColumn" Spacing="{StaticResource HomeCardGap}" VerticalAlignment="Top">
        <Border x:Name="CompactInsightsCard" Style="{StaticResource MetricCardStyle}">
            <StackPanel Spacing="{StaticResource HomeStatsGap}">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Insights" VerticalAlignment="Center" Style="{StaticResource HomeCardTitleStyle}" />
                    <TextBlock Text="All time" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HomeCardMetaStyle}" />
                </Grid>
                <Grid x:Name="CompactStatsGrid" ColumnSpacing="{StaticResource HomeMetricColumnGap}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock x:Name="HomePaceText" Text="--" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock Text="Words / min" Style="{StaticResource HomeMetricLabelStyle}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="HomeSessionsText" Text="--" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock Text="Dictations" Style="{StaticResource HomeMetricLabelStyle}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock x:Name="HomeWordsText" Text="--" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock Text="Words" Style="{StaticResource HomeMetricLabelStyle}" /></StackPanel>
                </Grid>
                <TextBlock x:Name="HomeInsightsFootnote" Text="No completed sessions yet." Style="{StaticResource HomeCardFootnoteStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border x:Name="HomeActivityCard" Style="{StaticResource MetricCardStyle}">
            <StackPanel Spacing="16">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Activity" VerticalAlignment="Center" Style="{StaticResource HomeCardTitleStyle}" />
                    <Border x:Name="HomeStreakPill" HorizontalAlignment="Right" Style="{StaticResource HomeActivityStreakStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
