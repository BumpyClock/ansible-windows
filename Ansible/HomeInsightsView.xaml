                            <TextBlock x:Name="HomeStreakText" Text="--" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="HomeActivityAvailabilityText" TextWrapping="Wrap"
                           Style="{StaticResource HomeCardFootnoteStyle}" Visibility="Collapsed"
                           />
                <Grid x:Name="HomeHeatmapHost" SizeChanged="HomeHeatmapHostSizeChanged">
                    <Grid x:Name="HomeHeatmapGrid" ColumnSpacing="{StaticResource HomeActivityHeatmapGap}" RowSpacing="{StaticResource HomeActivityHeatmapGap}" HorizontalAlignment="Center"
                          AutomationProperties.Name="Local session activity calendar" />
                </Grid>
                <StackPanel x:Name="HomeActivityLegend" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <TextBlock Text="Less" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource HomeLegendChipStyle}" /><Border Style="{StaticResource HomeLegendLowChipStyle}" />
                    <Border Style="{StaticResource HomeLegendMediumChipStyle}" /><Border Style="{StaticResource HomeLegendHighChipStyle}" />
                    <TextBlock Text="More" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="HomeModelsCard" Style="{StaticResource MetricCardStyle}">
            <StackPanel Spacing="{StaticResource HomeModelsCardGap}">
                <TextBlock Text="Sessions by model" Style="{StaticResource HomeCardTitleStyle}" />
                <muxc:ItemsRepeater x:Name="HomeModelRows" ItemTemplate="{StaticResource HomeModelTemplateSelector}">
                    <muxc:ItemsRepeater.Layout><muxc:StackLayout Spacing="{StaticResource HomeModelsCardGap}" /></muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
                <TextBlock x:Name="NoModelDataText" Text="No completed sessions yet." TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
