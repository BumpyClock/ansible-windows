<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.ShellTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ansible"
             BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" ActualThemeChanged="ShellThemeChanged">
    <!-- The title bar spans the window so the brand above the sidebar is a drag area. Caption buttons share its
         48 px height. Once the page heading scrolls away it shows the page name and a compact copy of the page's
         primary action. The TitleBar control keeps visible controls in its content clickable and the rest draggable.
         BorderBrush only resolves the theme's secondary text colour for the inactive caption buttons. -->
    <TitleBar x:Name="Bar" Height="{StaticResource TitleBarHeight}" Background="Transparent"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}">
        <TitleBar.Resources>
            <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
            <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
            <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
        </TitleBar.Resources>
        <Grid x:Name="TitleBarContent" Height="{StaticResource TitleBarHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrandColumn" Width="{StaticResource SidebarColumnWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="{StaticResource NavLabelGap}" Margin="{StaticResource SidebarBrandMargin}"
                        VerticalAlignment="Center">
                <local:AppMark Width="{StaticResource BrandSize}" Height="{StaticResource BrandSize}" TitleBar.IsDragRegion="True" />
                <TextBlock x:Name="AppWordmark" Text="Ansible" Style="{StaticResource AppWordmarkStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Margin="{StaticResource TitleBarPageTitleMargin}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed"
                       AutomationProperties.AccessibilityView="Raw" />
            <Button x:Name="PrimaryActionCopy" Grid.Column="2" Style="{StaticResource AppPrimaryButtonStyle}"
                    Height="32" Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"
                    Click="PrimaryActionCopyClicked" AutomationProperties.AutomationId="TitleBarPrimaryAction" />
        </Grid>
    </TitleBar>
</UserControl>
