<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.ShellTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ansible"
             BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" ActualThemeChanged="ShellThemeChanged">
    <!-- The title bar spans the window so the brand above the sidebar is a drag area. Caption buttons share its
         48 px height. The brand follows Windows title bar guidance: a 16 DIP icon and the app name in Caption type,
         on the navigation icons' left edge. Once the page title scrolls away the bar shows the page name; once the
         page's header actions scroll away it adds, 12 DIP after the name, a compact copy of the page's primary action,
         so the real button and its copy never show together. The rest of the bar stays empty. The
         TitleBar control keeps visible controls in its content clickable and the rest draggable. BorderBrush only
         resolves the theme's secondary text colour for the inactive caption buttons. -->
    <TitleBar x:Name="Bar" Height="{StaticResource TitleBarHeight}" Background="Transparent"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}">
        <TitleBar.Resources>
            <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
            <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
            <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
        </TitleBar.Resources>
        <Grid x:Name="TitleBarContent" Height="{StaticResource TitleBarHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrandColumn" Width="{StaticResource SidebarColumnWidth}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="{StaticResource NavLabelGap}" Margin="{StaticResource SidebarBrandMargin}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <local:AppMark x:Name="BrandMark" Width="16" Height="16" VerticalAlignment="Center" TitleBar.IsDragRegion="True" />
                <TextBlock Text="Ansible" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Margin="{StaticResource TitleBarPageTitleMargin}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed"
                       AutomationProperties.AccessibilityView="Raw" />
            <Button x:Name="PrimaryActionCopy" Grid.Column="2" Style="{StaticResource AppPrimaryButtonStyle}"
                    Height="32" Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"
                    Click="PrimaryActionCopyClicked" AutomationProperties.AutomationId="TitleBarPrimaryAction">
                <!-- The icon is the one the page declares for its primary action; it takes the button's foreground. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <IconSourceElement x:Name="PrimaryActionIcon" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="PrimaryActionLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </TitleBar>
</UserControl>
