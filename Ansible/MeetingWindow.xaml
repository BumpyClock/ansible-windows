<Window x:Class="Ansible.MeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Ansible">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <!-- Header and footer stay fixed; the transcript between them is the window's one scrolling region. -->
    <Grid x:Name="Root" ActualThemeChanged="RootThemeChanged">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="1" Grid.RowSpan="3" Margin="8,0,8,8" Style="{StaticResource ContentLayerStyle}" />
        <Grid x:Name="TitleBar" Margin="24,0,140,0">
            <TextBlock x:Name="TitleBarCaption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionSecondaryStyle}"/>
        </Grid>

        <!-- The title line holds the heading, its rename pencil, and More options on one vertical centre. A long
             title trims to one line and shows in full in the heading's tooltip. -->
        <Grid Grid.Row="1" Margin="8,0" Padding="16,12,12,16" ColumnSpacing="8" RowSpacing="4"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- The heading is the rename control, the same pattern as the speaker labels below. -->
            <Button x:Name="TitleButton" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="RenameTitleClicked" ToolTipService.ToolTip="Rename meeting">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MeetingTitle" Text="New meeting" Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               IsTextTrimmedChanged="MeetingTitleTrimmedChanged"
                               AutomationProperties.HeadingLevel="Level1"/>
                    <FontIcon Grid.Column="1" Glyph="&#xE70F;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Button>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                <StackPanel x:Name="DetailsRow" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed">
                    <Ellipse x:Name="RecordingDot" Width="8" Height="8" VerticalAlignment="Center" Visibility="Collapsed"
                             Fill="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock x:Name="MeetingDetails" Style="{StaticResource CaptionSecondaryStyle}"
                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="DelayText" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                <StackPanel x:Name="AudioHealthPanel" Visibility="Collapsed" Margin="8,0,0,0" Spacing="4">
                    <TextBlock x:Name="MicrophoneHealthText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PlaybackHealthText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PlaybackHintText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="DiagnosticsErrorText" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="CleanupStatusText" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource CaptionSecondaryStyle}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                    ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy transcript" Click="CopyClicked">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="ExportMenuItem" Text="Export as text file…" Click="ExportClicked">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="RevertCleanupMenuItem" Text="Restore original wording" Click="RevertCleanupClicked" Visibility="Collapsed">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="AudioDiagnosticsMenuItem" Text="Open audio diagnostics folder" Click="AudioDiagnosticsClicked">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete meeting" Click="DeleteClicked">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout></Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="8,0">
            <!-- Padding sits inside the scroller, so the stock scrollbar runs in the right gutter beside the text. -->
            <ListView x:Name="TranscriptRows" SelectionMode="None" IsItemClickEnabled="False"
                      Padding="16,16,16,24" Loaded="TranscriptLoaded" LayoutUpdated="TranscriptLayoutUpdated"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="Meeting transcript">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,20"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MeetingTranscriptRow">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Tag="{x:Bind SpeakerId, Mode=OneWay}" Click="SpeakerClicked"
                                        Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                        AutomationProperties.Name="{x:Bind RenameSpeakerName, Mode=OneWay}"
                                        ToolTipService.ToolTip="Rename speaker">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind SpeakerName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Bind TimingText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind local:MeetingWindow.VisibleIfText(TimingText), Mode=OneWay}"/>
                            </StackPanel>
                            <!-- Text sits 8 in from the row edge so it lines up with the speaker name inside its button. -->
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource BodyLargeTextBlockStyle}"
                                       Margin="8,0" IsTextSelectionEnabled="True"/>
                            <HyperlinkButton Content="{x:Bind OriginalToggleText, Mode=OneWay}" Click="OriginalToggleClicked"
                                             Padding="0,4" Margin="8,0" Visibility="{x:Bind local:MeetingWindow.ToVisibility(HasCleanup), Mode=OneWay}"/>
                            <Border Margin="8,0" Padding="12,0,0,0" BorderThickness="2,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind local:MeetingWindow.ToVisibility(IsOriginalExpanded), Mode=OneWay}">
                                <TextBlock Text="{x:Bind OriginalText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <local:EmptyState x:Name="TranscriptEmpty" Glyph="&#xE720;" Title="Ready when you are"
                              Detail="Start the meeting to see what each person says here."/>
        </Grid>
        <!-- Floats over the bottom of the transcript area and never moves content; the footer controls stay reachable. -->
        <local:NoticeHost x:Name="Notices" Grid.Row="2"/>

        <Grid Grid.Row="3" Margin="8,0,8,8" Padding="24,16" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="CaptureSetup" Grid.ColumnSpan="2" Spacing="8" Margin="0,0,0,16">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProcessChoice" Header="Teams call (optional)" HorizontalAlignment="Stretch"
                              SelectionChanged="MeetingProcessChanged"/>
                    <Button Grid.Column="1" Click="RefreshProcessesClicked" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Refresh Teams calls" AutomationProperties.Name="Refresh Teams calls">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="NamingHelpText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                           Text="Transcribes your microphone and everything your speakers play, including other apps. Ask everyone for consent first. Only text is saved; audio is never stored."/>
            </StackPanel>
            <TextBlock x:Name="SaveText" Grid.Row="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionSecondaryStyle}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CleanupButton" Content="Clean up wording…" Click="CleanupClicked" Visibility="Collapsed"/>
                <Button x:Name="CancelCleanupButton" Content="Cancel cleanup" Click="CancelCleanupClicked" Visibility="Collapsed"/>
                <Button x:Name="PauseButton" Content="Pause" Click="PauseClicked" Visibility="Collapsed"/>
                <Button x:Name="EndButton" Content="End meeting" Click="EndClicked" Visibility="Collapsed"
                        Style="{StaticResource AppPrimaryButtonStyle}"/>
                <Button x:Name="StartButton" Content="Start meeting" Click="StartClicked"
                        Style="{StaticResource AppPrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
