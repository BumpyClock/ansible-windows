<Window x:Class="Ansible.MeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Ansible">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource AppWindowBrush}" RowSpacing="0" ActualThemeChanged="RootThemeChanged">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="1" Grid.RowSpan="4" Margin="8,0,8,8" Style="{StaticResource PageSurfaceStyle}" />
        <Grid x:Name="TitleBar" Margin="24,0,140,0"><TextBlock x:Name="TitleBarCaption" Text="Meeting transcript" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}"/></Grid>
        <StackPanel Grid.Row="1" Margin="32,20,32,20" Spacing="12">
            <TextBox x:Name="MeetingTitle" Text="New meeting" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0" MaxLength="200" LostFocus="TitleLostFocus" AutomationProperties.Name="Meeting title"/>
            <TextBlock x:Name="MeetingDate" Style="{StaticResource CaptionSecondaryStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Transcript" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="More" AutomationProperties.Name="Transcript actions">
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="Copy transcript" Click="CopyClicked"/>
                        <MenuFlyoutItem Text="Export as text" Click="ExportClicked"/>
                        <MenuFlyoutItem x:Name="AudioDiagnosticsMenuItem" Text="Open audio diagnostics folder" Click="AudioDiagnosticsClicked"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete meeting" Click="DeleteClicked"/>
                    </MenuFlyout></Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="32,0,32,16" Spacing="12">
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE916;" FontSize="14"/>
                    <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="0:00" Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBlock x:Name="StateText" Grid.Column="2" Text="Ready" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock x:Name="DelayText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}"/>
            <StackPanel x:Name="AudioHealthPanel" Visibility="Collapsed" Spacing="6">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MicrophoneHealthText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PlaybackHealthText" Grid.Column="1" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                </Grid>
                <TextBlock x:Name="PlaybackHintText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="DiagnosticsErrorText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CleanupStatusText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" AutomationProperties.LiveSetting="Polite"/>
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                     Visibility="Collapsed" Closed="ErrorBarClosed"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="32,0,32,0">
            <ListView x:Name="TranscriptRows" SelectionMode="None" IsItemClickEnabled="False"
                      Padding="0,0,0,24" Loaded="TranscriptLoaded" LayoutUpdated="TranscriptLayoutUpdated"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="Meeting transcript">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,16"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MeetingTranscriptRow">
                        <StackPanel Spacing="6">
                            <Button Content="{x:Bind SpeakerName, Mode=OneWay}" Tag="{x:Bind SpeakerId, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind RenameSpeakerName, Mode=OneWay}" Click="SpeakerClicked"
                                    Background="{x:Null}" BorderThickness="0" Padding="0,4,0,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind TimingText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}"/>
                            <Border CornerRadius="8" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="16"/>
                            </Border>
                            <Expander Header="Original wording" IsExpanded="{x:Bind IsOriginalExpanded, Mode=TwoWay}"
                                      Visibility="{x:Bind local:MeetingWindow.ToVisibility(HasCleanup), Mode=OneWay}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBlock Text="{x:Bind OriginalText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </Expander>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="400">
                <TextBlock x:Name="EmptyTitle" Text="Ready when you are" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyDescription" Text="Start the meeting to see speaker-labelled text here." Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,20,32,24">
            <StackPanel Spacing="12">
                <StackPanel x:Name="CaptureSetup" Spacing="12">
                    <TextBlock Text="Records your default microphone and everything playing on your speakers and headphones, including notifications and other apps." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                    <Grid x:Name="ProcessSelector" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProcessChoice" Header="Teams app for speaker names (optional)" HorizontalAlignment="Stretch" SelectionChanged="MeetingProcessChanged"/>
                        <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesClicked" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock x:Name="NamingHelpText" Text="Automatic speaker names are available for Teams meetings. Other speakers keep editable model labels." Style="{StaticResource CaptionSecondaryStyle}"/>
                </StackPanel>
                <TextBlock x:Name="PrivacyText" Text="Get consent before transcribing others. Audio stays in memory; only text is saved." Style="{StaticResource CaptionSecondaryStyle}"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Content="Start meeting" Click="StartClicked" Style="{StaticResource AppPrimaryButtonStyle}" MinHeight="44"/>
                    <Button x:Name="PauseButton" Content="Pause" Click="PauseClicked" Visibility="Collapsed" MinHeight="44"/>
                    <Button x:Name="CleanupButton" Content="Clean up wording" Click="CleanupClicked" Visibility="Collapsed" MinHeight="44"/>
                    <Button x:Name="CancelCleanupButton" Content="Cancel cleanup" Click="CancelCleanupClicked" Visibility="Collapsed" MinHeight="44"/>
                    <TextBlock x:Name="SaveText" Grid.Column="1" Text="Saved locally" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}"/>
                    <Button x:Name="EndButton" Grid.Column="2" Content="End meeting" Click="EndClicked" Visibility="Collapsed" MinHeight="44"/>
                    <Button x:Name="RevertCleanupButton" Grid.Column="2" Content="Restore original" Click="RevertCleanupClicked" Visibility="Collapsed" MinHeight="44"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
