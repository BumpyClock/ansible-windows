<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.CustomWordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <local:PageCanvas Scrollable="False">
        <Grid>
        <Grid x:Name="PageRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="DictionaryHeader" ColumnSpacing="24" Margin="{StaticResource PageSectionBottomMargin}"
                  SizeChanged="DictionaryHeaderSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DictionaryPageTitle" Text="Dictionary" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" />
                <StackPanel x:Name="DictionaryHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ImportWordsButton" Content="Import" MinHeight="40" Padding="20,8"
                            AutomationProperties.AutomationId="ImportCustomWordsButton"
                            ToolTipService.ToolTip="Import a pasted list of words" Click="ImportWordsClicked" />
                    <Button x:Name="AddWordsButton" Content="Add new" MinHeight="40" Padding="20,8"
                            AutomationProperties.AutomationId="AddCustomWordsButton"
                            Style="{StaticResource AppPrimaryButtonStyle}" Click="AddWordsClicked" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="StatusInfo" Grid.Row="1" Margin="{StaticResource PageSectionBottomMargin}" IsOpen="False" Visibility="Collapsed" IsClosable="True"
                     AutomationProperties.AutomationId="CustomWordsStatusInfo"
                     AutomationProperties.LiveSetting="Polite" Closing="StatusInfoClosing" />

            <TextBlock x:Name="BusyText" Grid.Row="2" Text="Finish the current operation to change your dictionary."
                       Margin="{StaticResource PageSectionBottomMargin}"
                       Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" />

            <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Padding="20,8">
                        <Grid ColumnSpacing="12" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" MinWidth="80" MinHeight="40"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                     UseSystemFocusVisuals="True"
                                     AutomationProperties.AutomationId="SearchCustomWordsBox"
                                     AutomationProperties.Name="Search dictionary" PlaceholderText="Search dictionary"
                                     TextChanged="SearchChanged" />
                            <TextBlock x:Name="CountText" Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}"
                                       AutomationProperties.AutomationId="CustomWordsCount"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>
                    <ListView x:Name="WordsList" Grid.Row="1" AutomationProperties.AutomationId="CustomWordsList"
                              AutomationProperties.Name="Dictionary entries" SelectionMode="None"
                              ContainerContentChanging="WordsContainerContentChanging"
                              CornerRadius="{StaticResource OverlayCornerRadius}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DictionaryWord">
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid Padding="20,8,12,8" ColumnSpacing="16" MinHeight="64">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Word}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Tag="{x:Bind Word}" MinWidth="40" MinHeight="40"
                                                    AutomationProperties.AutomationId="EditCustomWordButton"
                                                    AutomationProperties.Name="{x:Bind EditName}"
                                                    Style="{StaticResource SubtleButtonStyle}" Click="EditWordClicked"
                                                    ToolTipService.ToolTip="Edit word">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                            </Button>
                                            <Button Tag="{x:Bind Word}" MinWidth="40" MinHeight="40"
                                                    AutomationProperties.AutomationId="RemoveCustomWordButton"
                                                    AutomationProperties.Name="{x:Bind RemoveName}"
                                                    Style="{StaticResource SubtleButtonStyle}" Click="RemoveWordClicked"
                                                    ToolTipService.ToolTip="Remove word">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="24" Spacing="8">
                        <FontIcon Glyph="&#xE82D;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EmptyTitle" Text="Your dictionary starts here"
                                   Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock x:Name="EmptyHelp" Text="Add names and terms you use, or import a list."
                                   Style="{StaticResource CaptionSecondaryStyle}" TextAlignment="Center" MaxWidth="360" />
                        <Button Content="Add your first word" HorizontalAlignment="Center" Margin="0,8,0,0"
                                AutomationProperties.AutomationId="AddFirstCustomWordButton"
                                Click="AddWordsClicked" x:Name="AddFirstWordButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Spacing="8" Margin="{StaticResource PageFooterTopMargin}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FeedbackText" VerticalAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="CustomWordsFeedback"
                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionSecondaryStyle}" />
                    <Button x:Name="UndoButton" Grid.Column="1" Content="Undo remove" Visibility="Collapsed"
                            AutomationProperties.AutomationId="UndoRemoveCustomWordButton" Click="UndoClicked" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource CaptionSecondaryStyle}" />
                    <HyperlinkButton Grid.Column="1" Content="Speech models" Padding="0,4"
                                     AutomationProperties.AutomationId="CustomWordsModelsButton" Click="ModelsClicked" />
                </Grid>
                <TextBlock Text="Stored on this device. Words guide recognition; they are not replacement rules."
                           Style="{StaticResource CaptionSecondaryStyle}" />
            </StackPanel>
        </Grid>

        <ContentDialog x:Name="EntryDialog" CloseButtonText="Cancel"
                       AutomationProperties.AutomationId="CustomWordEditorDialog"
                       PrimaryButtonClick="EntryDialogPrimaryClicked">
            <StackPanel Spacing="16" MinWidth="280">
                <TextBlock x:Name="EditorHelpText" Style="{StaticResource PageSubtitleStyle}" />
                <TextBox x:Name="EntryBox" Header="Word or phrase" PlaceholderText="For example, a project name"
                         AutomationProperties.AutomationId="CustomWordEditorBox"
                         AutomationProperties.Name="Word or phrase"
                         TextWrapping="Wrap" MaxHeight="240"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="EntryTextChanged" />
                <TextBlock x:Name="EditorValidationText" Visibility="Collapsed" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="CustomWordEditorValidation"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="EditorPreviewText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}"
                           AutomationProperties.AutomationId="CustomWordEditorPreview"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Up to 100 entries, 100 characters each, and 4 KB total."
                           Style="{StaticResource CaptionSecondaryStyle}" />
            </StackPanel>
        </ContentDialog>
        </Grid>
    </local:PageCanvas>
</Page>
