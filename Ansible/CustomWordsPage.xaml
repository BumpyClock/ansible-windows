<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.CustomWordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <local:PageCanvas Title="Dictionary"
                      Subtitle="Words you add here help Ansible recognize them when you speak. They are stored on this device.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="MoreOptionsButton" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                    ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem x:Name="ImportWordsMenuItem" Text="Import…" Click="ImportWordsClicked"
                                    AutomationProperties.AutomationId="ImportCustomWordsButton"
                                    AutomationProperties.Name="Import words"
                                    ToolTipService.ToolTip="Import a pasted list of words">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout></Button.Flyout>
            </Button>
        </local:PageCanvas.HeaderActions>
        <StackPanel>
            <local:NoticeBar x:Name="CompatibilityNotice" Visibility="Collapsed"
                             Margin="{StaticResource PageSectionBottomMargin}"
                             AutomationProperties.AutomationId="CustomWordsCompatibilityNotice" />

            <TextBlock x:Name="BusyText" Text="Finish the current operation to change your dictionary."
                       Margin="0,0,0,12" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" />

            <Grid ColumnSpacing="8" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="36,4,12,4"
                             AutomationProperties.AutomationId="SearchCustomWordsBox"
                             AutomationProperties.Name="Find or add a word" PlaceholderText="Find or add a word"
                             TextChanged="SearchChanged" KeyDown="SearchKeyDown" />
                    <FontIcon Glyph="&#xE721;" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsHitTestVisible="False"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Button x:Name="AddWordButton" Grid.Column="1" MaxWidth="260" VerticalAlignment="Stretch"
                        Style="{StaticResource AppPrimaryButtonStyle}" Click="AddWordClicked"
                        AutomationProperties.AutomationId="AddCustomWordsButton" AutomationProperties.Name="Add word">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="AddWordLabel" Text="Add" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CountText" Grid.Row="1" Grid.ColumnSpan="2"
                           Style="{StaticResource CaptionSecondaryStyle}"
                           AutomationProperties.AutomationId="CustomWordsCount"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="FieldValidationText" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           AutomationProperties.AutomationId="CustomWordFieldValidation"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </Grid>

            <ItemsControl x:Name="WordsList" Margin="0,12,0,0" IsTabStop="False"
                          AutomationProperties.AutomationId="CustomWordsList"
                          AutomationProperties.Name="Dictionary entries">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DictionaryWordRowModel">
                        <local:DictionaryWordRow Model="{x:Bind}" EditRequested="BeginEdit" SaveRequested="SaveEdit"
                                                 CancelRequested="EndEdit" RemoveRequested="RemoveWord" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <local:EmptyState x:Name="EmptyWords" Margin="0,28,0,0" VerticalAlignment="Top" Visibility="Collapsed"
                              IconData="{StaticResource DictionaryIconData}"
                              AutomationProperties.AutomationId="CustomWordsEmptyState" />

            <ContentDialog x:Name="EntryDialog" Title="Import words" PrimaryButtonText="Import words"
                           CloseButtonText="Cancel" DefaultButton="None"
                           AutomationProperties.AutomationId="CustomWordEditorDialog"
                           PrimaryButtonClick="EntryDialogPrimaryClicked">
                <StackPanel Spacing="16" MinWidth="280">
                    <TextBlock Text="Paste your list below, with one name, word, or phrase per line."
                               Style="{StaticResource PageSubtitleStyle}" />
                    <TextBox x:Name="EntryBox" Header="Words to import" PlaceholderText="One entry per line"
                             AutomationProperties.AutomationId="CustomWordEditorBox"
                             AutomationProperties.Name="Words to import, one per line"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="240"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="EntryTextChanged" />
                    <TextBlock x:Name="EditorValidationText" Visibility="Collapsed" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="CustomWordEditorValidation"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="EditorPreviewText" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}"
                               AutomationProperties.AutomationId="CustomWordEditorPreview"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Up to 100 entries, 100 characters each, and 4 KB total."
                               Style="{StaticResource CaptionSecondaryStyle}" />
                </StackPanel>
            </ContentDialog>
        </StackPanel>
    </local:PageCanvas>
</Page>
