<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ansible.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ansible">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!--
                Text, surface, stroke, and selection colors come from the WinUI system tokens
                (TextFillColor*, CardBackgroundFillColor*, CardStrokeColor*, DividerStrokeColor*,
                SubtleFillColor*, LayerFillColor*). Only app tokens without a system equivalent live here.
                High Contrast entries reference SystemColor* only; the Fluent *Color keys are placeholders in High Contrast.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Accent overrides. The system Accent* brushes derive from these. -->
                    <Color x:Key="SystemAccentColor">#185C5E</Color>
                    <Color x:Key="SystemAccentColorLight1">#216E70</Color>
                    <Color x:Key="SystemAccentColorLight2">#185C5E</Color>
                    <Color x:Key="SystemAccentColorLight3">#CEF0EA</Color>
                    <Color x:Key="SystemAccentColorDark1">#124A4C</Color>
                    <Color x:Key="SystemAccentColorDark2">#103F41</Color>
                    <Color x:Key="SystemAccentColorDark3">#0B3032</Color>
                    <!-- App tokens: accent graphics and data visualization. -->
                    <!-- AccentGraphicBrush matches AccentFillColorDefaultBrush, which is SystemColorWindowColor (invisible) in High Contrast. -->
                    <SolidColorBrush x:Key="AccentGraphicBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF1EB" />
                    <SolidColorBrush x:Key="InactiveChartBrush" Color="#E3E1DA" />
                    <SolidColorBrush x:Key="ActivityLowBrush" Color="#CDEBE5" />
                    <SolidColorBrush x:Key="ActivityMediumBrush" Color="#79C1B7" />
                    <x:Double x:Key="FutureActivityOpacity">0.35</x:Double>
                    <!-- Temporary alias for FloatingDictationWindow. Use TextFillColorPrimaryBrush elsewhere. -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource TextFillColorPrimary}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Accent overrides. The system Accent* brushes derive from these. -->
                    <Color x:Key="SystemAccentColor">#79CFC0</Color>
                    <Color x:Key="SystemAccentColorLight1">#91DDD0</Color>
                    <Color x:Key="SystemAccentColorLight2">#79CFC0</Color>
                    <Color x:Key="SystemAccentColorLight3">#C4F1E8</Color>
                    <Color x:Key="SystemAccentColorDark1">#68BCAD</Color>
                    <Color x:Key="SystemAccentColorDark2">#57A999</Color>
                    <Color x:Key="SystemAccentColorDark3">#459787</Color>
                    <!-- App tokens: accent graphics and data visualization. -->
                    <SolidColorBrush x:Key="AccentGraphicBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#254F49" />
                    <SolidColorBrush x:Key="InactiveChartBrush" Color="#3C423F" />
                    <SolidColorBrush x:Key="ActivityLowBrush" Color="#365D54" />
                    <SolidColorBrush x:Key="ActivityMediumBrush" Color="#568F82" />
                    <x:Double x:Key="FutureActivityOpacity">0.35</x:Double>
                    <!-- Temporary alias for FloatingDictationWindow. Use TextFillColorPrimaryBrush elsewhere. -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource TextFillColorPrimary}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <!-- App tokens: accent graphics and data visualization. -->
                    <SolidColorBrush x:Key="AccentGraphicBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="InactiveChartBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ActivityLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ActivityMediumBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <x:Double x:Key="FutureActivityOpacity">1</x:Double>
                    <!-- Temporary alias for FloatingDictationWindow. Use TextFillColorPrimaryBrush elsewhere. -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Shared page layout. Page roots use these directly inside their ScrollViewer. -->
            <x:Double x:Key="PageContentMaxWidth">1172</x:Double>
            <Thickness x:Key="PagePadding">36,28,36,36</Thickness>
            <Style x:Key="ActivityEmptyCellStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InactiveChartBrush}" />
            </Style>
            <Style x:Key="ActivityLowCellStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ActivityLowBrush}" />
            </Style>
            <Style x:Key="ActivityMediumCellStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ActivityMediumBrush}" />
            </Style>
            <Style x:Key="ActivityHighCellStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentGraphicBrush}" />
            </Style>
            <Style x:Key="ActivityFutureCellStyle" TargetType="Border" BasedOn="{StaticResource ActivityEmptyCellStyle}">
                <Setter Property="Opacity" Value="{ThemeResource FutureActivityOpacity}" />
            </Style>
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="SelectedNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <!-- Read-only keyboard shortcut display. -->
            <Style x:Key="KeycapStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="72" />
                <Setter Property="Height" Value="72" />
                <Setter Property="CornerRadius" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="26" />
            </Style>
            <Style x:Key="TranscriptTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="17" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
