<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.HomeHistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Insertion tags. Verified insertion uses the accent; every other outcome keeps the amber HistoryTagStyle. -->
            <Style x:Key="HistoryInsertedTagStyle" TargetType="Border" BasedOn="{StaticResource HistoryTagStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentSoftBrush}" />
            </Style>
            <Style x:Key="HistoryInsertedTagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryTagTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentForegroundBrush}" />
            </Style>
            <Style x:Key="HistoryTagIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource HistoryTagIconSize}" />
                <Setter Property="Foreground" Value="{ThemeResource AppTagBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HistoryInsertedTagIconStyle" TargetType="FontIcon" BasedOn="{StaticResource HistoryTagIconStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="HistorySection" RowSpacing="{StaticResource SectionHeaderGap}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Rows are built in code; this anchor supplies the hover fill resolved for this element's theme. -->
        <Border x:Name="HoverFillAnchor" Visibility="Collapsed" Background="{ThemeResource AppHoverBrush}" />
        <Grid x:Name="HistoryHeaderGrid" Style="{StaticResource HomeSectionHeaderStyle}" SizeChanged="HistoryHeaderSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource HistorySearchColumnWidth}" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HistoryTitle" Text="History" Style="{StaticResource HomeSectionTitleStyle}" />
            <local:Badge x:Name="HistoryCountPill" Grid.Column="1" Text="0 transcriptions"
                         ToolTipService.ToolTip="Your latest transcriptions saved on this device, up to 100." />
            <TextBox x:Name="HistorySearchBox" Grid.Column="3" Height="36" PlaceholderText="Search transcripts"
                     TextChanged="HistorySearchChanged" Padding="{StaticResource HistorySearchPadding}"
                     FontSize="{StaticResource HistorySearchFontSize}" VerticalContentAlignment="Center"
                     Background="{ThemeResource AppCardBrush}"
                     BorderBrush="{ThemeResource AppBorderBrush}" AutomationProperties.Name="Search transcripts">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="FocusHistorySearchInvoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <FontIcon x:Name="HistorySearchIcon" Grid.Column="3" Glyph="&#xE721;"
                      FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="12,0,0,0" IsHitTestVisible="False" />
            <Border x:Name="HistorySearchShortcut" Grid.Column="3" Style="{StaticResource SearchKeycapStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="Ctrl K" Style="{StaticResource SearchKeycapTextStyle}" />
            </Border>
        </Grid>
        <InfoBar x:Name="HistoryStorageWarning" Grid.Row="1" Title="History needs attention"
                 Severity="Warning" IsOpen="False" IsClosable="False" Visibility="Collapsed" />
        <Border x:Name="HistoryCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer x:Name="HistoryRowsHost"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Stretch">
                <StackPanel x:Name="HistoryContent" Padding="{StaticResource HistoryListPadding}" Spacing="4"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock x:Name="OversizedNotice" TextWrapping="Wrap" Margin="12,8,12,4"
                               Style="{StaticResource CaptionSecondaryStyle}" Visibility="Collapsed" />
                    <StackPanel x:Name="HistoryRows" Spacing="4" SizeChanged="HistoryRowsSizeChanged">
                        <!-- Full rebuilds (search, first render) detach these; only real history changes animate. -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" Spacing="{StaticResource HistoryEmptyGap}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" TextWrapping="Wrap" HorizontalAlignment="Center" Style="{StaticResource HistoryEmptyTitleStyle}" />
                        <TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" HorizontalAlignment="Center" Style="{StaticResource HistoryEmptyDetailStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
