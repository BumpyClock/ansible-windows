<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.HomeHistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Insertion status reads as row metadata: an icon and a word, no pill. Colour carries the outcome:
                 an accent check when the field confirmed it, muted when unverified, amber when the text did not arrive. -->
            <Style x:Key="HistoryTagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryMetaTextStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HistoryNotInsertedTagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryTagTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HistoryTagIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HistoryInsertedTagIconStyle" TargetType="FontIcon" BasedOn="{StaticResource HistoryTagIconStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="HistoryNotInsertedTagIconStyle" TargetType="FontIcon" BasedOn="{StaticResource HistoryTagIconStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HistoryCopyIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource IconButtonGlyphSize}" />
            </Style>
            <!-- Text that never reached the app keeps an amber Copy so the recovery action stays obvious. -->
            <Style x:Key="HistoryNeedsCopyIconStyle" TargetType="FontIcon" BasedOn="{StaticResource HistoryCopyIconStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <!-- Rows sit on the page surface. The negative margin keeps row text aligned with the section header
                 while the hover fill extends past it. -->
            <Style x:Key="HomeHistoryRowStyle" TargetType="Border" BasedOn="{StaticResource HistoryRowStyle}">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="-12,0" />
            </Style>
            <Thickness x:Key="HomeHistoryGroupMargin">0,16,0,8</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="HistorySection" RowSpacing="{StaticResource SectionHeaderGap}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Rows are built in code; this anchor supplies the hover fill resolved for this element's theme. -->
        <Border x:Name="HoverFillAnchor" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <!-- The header sticks to the top of the page scroller (PinHeader) and draws above the rows that scroll under
             it. Its fill repeats the window's two layers, Mica under the content layer fill, so it hides those rows
             without a visible band. The fill reaches past the row hover fill on both sides and adds breathing room above and below
             while stuck; matching negative margins keep the layout where it was. -->
        <Grid x:Name="HistoryHeaderGrid" Style="{StaticResource HomeSectionHeaderStyle}" Margin="-12,-12,-12,-8"
              Padding="12,12,12,8" Background="Transparent" Canvas.ZIndex="1"
              SizeChanged="HistoryHeaderSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource HistorySearchColumnWidth}" />
            </Grid.ColumnDefinitions>
            <SystemBackdropElement Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="-12,-12,-12,-8" IsHitTestVisible="False">
                <SystemBackdropElement.SystemBackdrop>
                    <MicaBackdrop />
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>
            <Border Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="-12,-12,-12,-8" IsHitTestVisible="False"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <TextBlock x:Name="HistoryTitle" Text="History" Style="{StaticResource HomeSectionTitleStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
            <local:Badge x:Name="HistoryCountPill" Grid.Column="1" Text="0 transcriptions"
                         ToolTipService.ToolTip="Your latest transcriptions saved on this device, up to 100." />
            <TextBox x:Name="HistorySearchBox" Grid.Column="3" Height="36" PlaceholderText="Search transcripts"
                     TextChanged="HistorySearchChanged" Padding="{StaticResource HistorySearchPadding}"
                     FontSize="{StaticResource BodyFontSize}" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search transcripts">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="FocusHistorySearchInvoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <FontIcon x:Name="HistorySearchIcon" Grid.Column="3" Glyph="&#xE721;"
                      FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="12,0,0,0" IsHitTestVisible="False" />
            <Border x:Name="HistorySearchShortcut" Grid.Column="3" Style="{StaticResource SearchKeycapStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="Ctrl K" Style="{StaticResource SearchKeycapTextStyle}" />
            </Border>
            <!-- A hairline under the stuck header. The pin fades it in only while rows pass underneath. -->
            <Border x:Name="HistoryHeaderDivider" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="-12,0,-12,-8"
                    Style="{StaticResource HistoryDividerStyle}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        </Grid>
        <!-- History flows in the page scroller. No card, no fixed height, no nested scroller. -->
        <StackPanel x:Name="HistoryContent" Grid.Row="1">
            <TextBlock x:Name="OversizedNotice" TextWrapping="Wrap" Margin="0,4,0,8"
                       Style="{StaticResource CaptionSecondaryStyle}" Visibility="Collapsed" />
            <StackPanel x:Name="HistoryRows" SizeChanged="HistoryRowsSizeChanged">
                <!-- Full rebuilds (search, first render) detach these; only real history changes animate. -->
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>
            <Grid x:Name="EmptyState" Margin="0,8,0,0" Visibility="Collapsed">
                <Rectangle Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="4,3"
                           RadiusX="12" RadiusY="12" IsHitTestVisible="False" />
                <StackPanel Padding="24,48" Spacing="{StaticResource HistoryEmptyGap}" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource HistoryEmptyTitleStyle}" />
                    <TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource HistoryEmptyDetailStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
