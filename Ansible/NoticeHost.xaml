<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.NoticeHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsTabStop="False"
             AutomationProperties.Name="Notifications" AutomationProperties.LandmarkType="Custom"
             PointerEntered="HostPointerEntered" PointerExited="HostPointerExited"
             GotFocus="HostGotFocus" LostFocus="HostLostFocus">
    <Grid x:Name="Layout" Margin="{StaticResource NoticeHostMargin}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="BarColumn" Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="{StaticResource NoticeHostSpacing}">
            <Button x:Name="MoreButton" HorizontalAlignment="Left" Height="28" Padding="12,0" CornerRadius="14"
                    FontSize="{StaticResource CaptionFontSize}" Visibility="Collapsed" Click="MoreClicked"
                    AutomationProperties.AutomationId="MoreNoticesButton" />
            <StackPanel x:Name="Bars" Spacing="{StaticResource NoticeHostSpacing}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="False" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
