                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TitleBar x:Name="AppTitleBar" Height="{StaticResource TitleBarHeight}" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                <!-- Pages sit directly on the Mica window base; cards are the only container level. Pages are
                     cached and swap instantly: sidebar navigation is frequent and flat, so an entrance would
                     replay on every switch without explaining anything. -->
                <ContentControl x:Name="MainContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Border x:Name="MicrophonePermissionNotice" Grid.Row="1"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="{StaticResource ApplicationNoticeMargin}"
                        MaxWidth="{StaticResource ApplicationNoticeMaxWidth}"
                        Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="{StaticResource CardBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource ApplicationNoticePadding}"
                        Visibility="Collapsed"
                        SizeChanged="MicrophonePermissionNoticeSizeChanged"
                        AutomationProperties.AutomationId="MicrophonePermissionNotice"
                        AutomationProperties.Name="Microphone access required"
                        AutomationProperties.LiveSetting="Polite">
                    <Grid ColumnSpacing="{StaticResource NavItemGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="{StaticResource IconSize}"
                                  Foreground="{ThemeResource AccentGraphicBrush}" VerticalAlignment="Top"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource NavItemGap}">
                            <TextBlock Text="Microphone access required" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="MicrophonePermissionMessage" Style="{StaticResource CaptionSecondaryStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="MicrophonePermissionActions" Orientation="Horizontal"
                                        Spacing="{StaticResource NavItemGap}">
                                <Button Content="Open settings" Style="{StaticResource AppPrimaryButtonStyle}"
                                        Click="OpenMicrophoneSettingsClicked"
                                        AutomationProperties.Name="Open microphone settings" />
                                <Button x:Name="CheckMicrophonePermissionButton" Content="Check again"
                                        Click="CheckMicrophonePermissionClicked"
                                        AutomationProperties.Name="Check microphone permission again" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource NavigationButtonStyle}"
                                Width="{StaticResource NavHeight}" Height="{StaticResource NavHeight}"
                                HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" Padding="0"
                                Click="MicrophonePermissionNoticeDismissed"
                                AutomationProperties.Name="Dismiss microphone permission notice"
                                ToolTipService.ToolTip="Dismiss">
                            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconSize}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1">
            <!-- Notices toggle Visibility, so only reposition applies: a notice appearing slides the others down. -->
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <InfoBar x:Name="MeetingSuggestion" Margin="{StaticResource ApplicationNoticeMargin}" IsOpen="False" Visibility="Collapsed"
                     Severity="Informational" Title="Teams microphone is active."
                     Message="Start local notetaking? Recording starts only when you click Start."
                     CloseButtonClick="MeetingSuggestionDismissed" AutomationProperties.AutomationId="MeetingSuggestion"
                     AutomationProperties.LiveSetting="Polite">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenSuggestedMeetingButton" Content="Open notetaker" Click="OpenSuggestedMeetingClicked"
                            AutomationProperties.AutomationId="OpenSuggestedMeetingButton" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="TrayError" Margin="{StaticResource ApplicationNoticeMargin}"
                     IsOpen="False" IsClosable="False" Visibility="Collapsed"
                     Severity="Error" Title="Tray icon unavailable" AutomationProperties.AutomationId="TrayError">
                <InfoBar.ActionButton>
                    <Button Content="Exit Ansible" Click="ExitClicked" AutomationProperties.AutomationId="TrayErrorExitButton" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ShutdownError" Margin="{StaticResource ApplicationNoticeMargin}"
                     IsOpen="False" IsClosable="False" Visibility="Collapsed"
                     Severity="Error" Title="Close failed" AutomationProperties.AutomationId="ShutdownError" />
        </StackPanel>
    </Grid>
</Window>
