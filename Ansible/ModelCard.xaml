<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.ModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ansible"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </UserControl.Resources>
    <!-- One full-width row per model. The page's group heading carries the install state; the row carries
         facts, actions, and details that expand in place. -->
    <Border x:Name="CardBorder" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}" Padding="16">
        <!-- The in-use outline is a visual state with a ThemeResource setter, so it follows theme and High Contrast. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OutlineStates">
                <VisualState x:Name="OutlineRest" />
                <VisualState x:Name="OutlineActive">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="RowLayout" ColumnSpacing="16" SizeChanged="RowSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Width="40" Height="40" CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource ControlFillColorDefaultBrush}"
                    VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <Grid>
                    <Image x:Name="IconImage" Width="28" Height="28" Stretch="Uniform"
                           Visibility="Collapsed" ImageOpened="IconOpened" ImageFailed="IconFailed" />
                    <TextBlock x:Name="Monogram" FontSize="{StaticResource BodyFontSize}" FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <!-- Name and chips flow like text: chips follow the name and wrap below it when the row is narrow. -->
                <local:ModelRowWrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <local:Badge x:Name="RoleBadge" Background="{ThemeResource AccentSoftBrush}" Visibility="Collapsed" />
                    <local:Badge x:Name="CustomWordsBadge" Text="Custom words"
                                 Visibility="Collapsed" />
                </local:ModelRowWrapPanel>
                <!-- One line of facts: an exceptional state, then behaviour, sizes, or transfer progress. -->
                <TextBlock x:Name="FactsText" Style="{StaticResource CaptionSecondaryStyle}">
                    <Run x:Name="StateRun" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><Run x:Name="SeparatorRun" /><Run x:Name="CaptionRun" />
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="ActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel x:Name="ProgressPanel" Width="160" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Update owns the style: accent for enabled forward steps, default for Pause, Stop and disabled.
                     A disabled button shows no tooltip, so the transparent host carries the reason. -->
                <Border x:Name="PrimaryHost" Background="Transparent">
                    <Button x:Name="PrimaryButton" Content="Download" MinHeight="32" Click="PrimaryClicked" />
                </Border>
                <Button x:Name="UseButton" Content="Use for dictation" MinHeight="32" Click="UseClicked" Visibility="Collapsed" />
                <Button x:Name="RemoveButton" Style="{StaticResource IconButtonStyle}" Click="RemoveClicked"
                        Visibility="Collapsed">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                </Button>
                <Button x:Name="DetailsButton" Style="{StaticResource IconButtonStyle}" Click="DetailsClicked"
                        ToolTipService.ToolTip="Details">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                </Button>
            </StackPanel>

            <local:NoticeBar x:Name="ErrorNotice" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                             Visibility="Collapsed" />

            <!-- Details flow inside the page scroller; they never scroll on their own. -->
            <Border x:Name="DetailsPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                    Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid x:Name="AboutRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="About" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock x:Name="DescriptionText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Languages" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock x:Name="LanguagesText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Custom words" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock x:Name="CustomWordsText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="License" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock x:Name="LicenseDetailText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Source" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock x:Name="SourceText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Verification" Style="{StaticResource DetailLabelStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PrecisionText" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock x:Name="ByteCountText" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock x:Name="HashText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Location" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock x:Name="LocationText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
