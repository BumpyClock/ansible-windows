<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.ModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Top">
    <UserControl.Resources>
        <!-- Transparent at rest; the default Button template supplies the hover and pressed fills. -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="CardBorder" Style="{StaticResource CardStyle}" Padding="20">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="IconImage" Width="28" Height="28" Stretch="Uniform"
                               Visibility="Collapsed" ImageOpened="IconOpened" ImageFailed="IconFailed" />
                        <TextBlock x:Name="Monogram" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="VariantText" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                    <Button x:Name="DetailsButton" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Details">
                        <FontIcon Glyph="&#xE9CE;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="400" />
                                        <Setter Property="Padding" Value="16" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="12">
                                    <StackPanel x:Name="AboutSection" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="About" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextBlockStyle}" />
                                        </StackPanel>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Capabilities" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock x:Name="CapabilityText" Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="License" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock x:Name="LicenseDetailText" Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Source" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock x:Name="SourceText" Style="{StaticResource BodyTextBlockStyle}"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Verification" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock x:Name="ByteCountText" Style="{StaticResource BodyTextBlockStyle}"
                                                   IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="HashText" Style="{StaticResource BodyTextBlockStyle}"
                                                   FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Location" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock x:Name="LocationText" Style="{StaticResource BodyTextBlockStyle}"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="RemoveButton" Style="{StaticResource IconButtonStyle}" Click="RemoveClicked"
                            Visibility="Collapsed">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock x:Name="BehaviorText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="LanguageText" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Download" Style="{StaticResource CaptionSecondaryStyle}" />
                    <TextBlock x:Name="DownloadSizeText" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Memory" Style="{StaticResource CaptionSecondaryStyle}"
                               ToolTipService.ToolTip="Admission estimate used before loading, not measured usage." />
                    <TextBlock x:Name="MemoryText" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="License" Style="{StaticResource CaptionSecondaryStyle}" />
                    <TextBlock x:Name="LicenseText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>


            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed"
                         AutomationProperties.Name="Model download progress" />
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Visibility="Collapsed"
                       Style="{StaticResource CaptionSecondaryStyle}" />

            <InfoBar x:Name="ErrorInfo" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="This model needs attention" />

            <StackPanel x:Name="ActionRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton" Content="Download" MinHeight="36" Click="PrimaryClicked"
                        Style="{StaticResource AccentButtonStyle}" />
                <!-- Disabled buttons do not show tooltips, so the reason lives on this hit-testable host. -->
                <Border x:Name="UseButtonHost" Background="Transparent" Visibility="Collapsed">
                    <Button x:Name="UseButton" Content="Use" MinHeight="32" Click="UseClicked" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
