<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Ansible.ModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ansible"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryStyle}">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </UserControl.Resources>
    <!-- One full-width row per model. The page's group heading carries the install state. The row says what the
         model does and what it costs in plain words, offers at most one transfer or selection button, and keeps
         details and removal in the More menu. Every row has the same three text lines, so rows are the same height. -->
    <!-- Every row has the stock card stroke. The In use badge alone marks the model in use. -->
    <Border Style="{StaticResource CardStyle}" Padding="16">
        <Grid x:Name="RowLayout" ColumnSpacing="12" SizeChanged="RowSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- A neutral glyph for what the model does, on a subtle fill that darkens a light card and lightens a dark
                 one. When the app ships the maker's mark, it covers the glyph on this themed tile. Artwork drawn only
                 for a light background sits on the light plate instead: RequestedTheme="Light" resolves the stock
                 light fill and card stroke inside it. The plate has the tile's size, radius, and stroke, and stays
                 collapsed until that mark opens. The image is a sibling so it loads under a visible parent. -->
            <Grid Width="40" Height="40" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <Border x:Name="GlyphTile" CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource CardBorderThickness}">
                    <FontIcon x:Name="TileGlyph" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border x:Name="LogoPlate" RequestedTheme="Light" CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource CardBorderThickness}" Visibility="Collapsed" />
                <Image x:Name="IconImage" Width="28" Height="28" Stretch="Uniform" Visibility="Collapsed"
                       ImageOpened="IconOpened" ImageFailed="IconFailed" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <!-- Name and badges flow like text: a badge follows the name and wraps below it when the row is narrow.
                     The name sits in a slot as tall as a badge, so rows with and without one are the same height. -->
                <local:ModelRowWrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                    <Grid MinHeight="28">
                        <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <local:Badge x:Name="InUseBadge" Background="{ThemeResource AccentSoftBrush}" Visibility="Collapsed" />
                    <local:Badge x:Name="StateBadge" Visibility="Collapsed" />
                </local:ModelRowWrapPanel>
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionSecondaryStyle}" />
                <TextBlock x:Name="FootprintText" Style="{StaticResource CaptionSecondaryStyle}" />
            </StackPanel>

            <StackPanel x:Name="ActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel x:Name="ProgressPanel" Width="160" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- A disabled button shows no tooltip, so the transparent host carries the reason. -->
                <Border x:Name="PrimaryHost" Background="Transparent">
                    <Button x:Name="PrimaryButton" Content="Download" Click="PrimaryClicked" />
                </Border>
                <Button x:Name="UseButton" Content="Use for dictation" Click="UseClicked" Visibility="Collapsed" />
            </StackPanel>

            <!-- More stays in the row's corner at every width. Removal lives here so it never sits beside the name. -->
            <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                    ToolTipService.ToolTip="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="DetailsItem" Text="Show details" Click="DetailsClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="RemoveSeparator" Visibility="Collapsed" />
                        <MenuFlyoutItem x:Name="RemoveItem" Text="Remove from this device" Click="RemoveClicked"
                                        Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <local:NoticeBar x:Name="ErrorNotice" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,12,0,0"
                             Visibility="Collapsed" />

            <!-- Details flow inside the page scroller; they never scroll on their own. Exact identifiers live here. -->
            <Border x:Name="DetailsPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,12,0,0"
                    Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid x:Name="AboutRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="About" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="DescriptionText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Languages" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="LanguagesText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Dictionary" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="CustomWordsText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="License" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="LicenseDetailText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Catalog name" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="CatalogNameText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Source" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="SourceText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Verification" Style="{StaticResource CaptionSecondaryStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PrecisionText" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock x:Name="ByteCountText" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock x:Name="HashText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Location" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="LocationText" Grid.Column="1" Style="{StaticResource DetailValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
