<?xml version="1.0" encoding="utf-8"?>
<!-- Home-only section styles for the history header, which sits on the window base above its rows. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HomeSectionHeaderStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource HomeSectionHeaderMinHeight}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <!-- Section headings use the same BodyStrong heading as "In use" on Speech models and the Settings card titles. -->
    <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
