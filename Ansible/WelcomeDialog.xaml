<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="Ansible.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ansible"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="Next" CloseButtonText="Skip for now" DefaultButton="Primary"
    PrimaryButtonClick="NextClicked" SecondaryButtonClick="BackClicked" CloseButtonClick="SkipClicked"
    Opened="LessonOpened" Closing="LessonClosing" Closed="LessonClosed">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <Style x:Key="LessonIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="LessonGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StepDotStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
        </Style>
        <Style x:Key="CurrentStepDotStyle" TargetType="Border" BasedOn="{StaticResource StepDotStyle}">
            <Setter Property="Background" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ContentDialog.Resources>
    <Grid x:Name="LessonRoot" Width="640" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:WelcomeScene x:Name="Scene" />
        <Grid x:Name="StepBody" Grid.Row="1" MinHeight="224" RowSpacing="24">
            <Grid.RenderTransform><TranslateTransform x:Name="StepShift" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="Description" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="IntroPanel" Grid.Row="1" Spacing="24" VerticalAlignment="Center">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LessonIconStyle}"><FontIcon Glyph="&#xE720;" Style="{StaticResource LessonGlyphStyle}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Speak naturally. Keep your flow." Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Focus a text field in another app. Use your shortcut to speak, and Ansible inserts the finished words there."
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LessonIconStyle}"><FontIcon Glyph="&#xE72E;" Style="{StaticResource LessonGlyphStyle}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Recognition runs on this device." Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Audio is never saved or uploaded. Only the text of successful dictations is kept, in your history on this device."
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <StackPanel x:Name="ShortcutPanel" Grid.Row="1" Spacing="24" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LessonIconStyle}"><FontIcon Glyph="&#xE765;" Style="{StaticResource LessonGlyphStyle}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="ShortcutInstruction" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ShortcutDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LessonIconStyle}"><FontIcon Glyph="&#xE713;" Style="{StaticResource LessonGlyphStyle}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Your microphone is off until you start a dictation." Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="The keys above follow your keyboard. You can change the shortcut, or replay this lesson, in Settings > Dictation."
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <StackPanel x:Name="PracticePanel" Grid.Row="1" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid>
                    <TextBox x:Name="PracticeBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                             PlaceholderText="Click here, then use your shortcut." Padding="8,8,48,8"
                             AutomationProperties.Name="Practice field"
                             AutomationProperties.AutomationId="WelcomePracticeField" />
                    <Grid x:Name="Celebration" Width="28" Height="28" Margin="0,0,12,12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
                        <Ellipse x:Name="Burst" Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="BurstScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Height="28" CornerRadius="14" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="CheckScale" /></Border.RenderTransform>
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Grid>
                <Grid Height="40" Margin="0,4,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PracticeStatus" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="CancelPracticeButton" Grid.Column="1" Content="Cancel dictation" VerticalAlignment="Center"
                            Click="CancelPracticeClicked" Visibility="Collapsed" />
                    <Button x:Name="ModelsButton" Grid.Column="1" Content="Set up a speech model" VerticalAlignment="Center"
                            Click="ModelsClicked" Visibility="Collapsed" />
                </Grid>
                <TextBlock Text="Nothing is sent to another app or the clipboard. Practice dictations also appear in your local history."
                           Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <StackPanel x:Name="StepDots" Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Grid Width="6" Height="6"><Border Style="{StaticResource StepDotStyle}" /><Border Style="{StaticResource CurrentStepDotStyle}" /></Grid>
            <Grid Width="6" Height="6"><Border Style="{StaticResource StepDotStyle}" /><Border Style="{StaticResource CurrentStepDotStyle}" /></Grid>
            <Grid Width="6" Height="6"><Border Style="{StaticResource StepDotStyle}" /><Border Style="{StaticResource CurrentStepDotStyle}" /></Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
