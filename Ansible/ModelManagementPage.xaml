<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.ModelManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <Style x:Key="ModelGroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ModelGroupNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <local:PageCanvas Title="Speech models" Subtitle="Recognition runs on this device. One model handles dictation at a time.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="TranscribeFileButton" MinHeight="32" Click="TranscribeFileClicked"
                        AutomationProperties.AutomationId="TranscribeModelWavButton"
                        AutomationProperties.Name="Transcribe a WAV file">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Transcribe WAV file…" />
                </StackPanel>
            </Button>
            <Button x:Name="FolderMenuButton" MinHeight="32" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ModelFolderButton"
                        AutomationProperties.Name="Model folder and verification">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    <TextBlock Text="Model folder" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="12" MaxWidth="380">
                            <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Spacing="12">
                                <Button x:Name="FolderButton" Content="Choose folder" Click="ChooseFolderClicked"
                                        MinHeight="40" AutomationProperties.AutomationId="ChooseModelFolder"
                                        ToolTipService.ToolTip="Changing folders does not move or delete model files." />
                                <Button x:Name="RefreshButton" Content="Verify installed files" Click="RefreshClicked"
                                        IsEnabled="False" MinHeight="40" AutomationProperties.AutomationId="VerifyModelFiles" />
                            </StackPanel>
                            <TextBlock x:Name="BackendText" Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </local:PageCanvas.HeaderActions>
        <!-- Install state is the group: In use, Installed, Available. Render moves each row into its group and
             keeps catalog order inside it. Empty groups collapse. -->
        <StackPanel Spacing="32">
            <StackPanel x:Name="InUseSection" Spacing="12" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="In use" Style="{StaticResource ModelGroupHeadingStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Column="1" Text="Dictation model and the meeting speaker companion."
                               Style="{StaticResource ModelGroupNoteStyle}" />
                </Grid>
                <StackPanel x:Name="InUseRows" Spacing="8" />
            </StackPanel>
            <StackPanel x:Name="InstalledSection" Spacing="12" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Installed" Style="{StaticResource ModelGroupHeadingStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Column="1" Text="Ready on this device." Style="{StaticResource ModelGroupNoteStyle}" />
                </Grid>
                <StackPanel x:Name="InstalledRows" Spacing="8" />
            </StackPanel>
            <StackPanel x:Name="AvailableSection" Spacing="12" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Available" Style="{StaticResource ModelGroupHeadingStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Column="1" Text="Pinned downloads, verified by SHA-256." Style="{StaticResource ModelGroupNoteStyle}" />
                </Grid>
                <StackPanel x:Name="AvailableRows" Spacing="8" />
            </StackPanel>
        </StackPanel>
    </local:PageCanvas>
</Page>
