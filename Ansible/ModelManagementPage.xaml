<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.ModelManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <local:PageCanvas Title="Speech models" Subtitle="Recognition runs on this device. One model handles dictation at a time.">
        <local:PageCanvas.HeaderActions>
            <Button x:Name="MoreOptionsButton" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                    Margin="{StaticResource CardInsetActionMargin}"
                    ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem x:Name="TranscribeFileMenuItem" Text="Transcribe WAV file…" Click="TranscribeFileClicked"
                                    AutomationProperties.AutomationId="TranscribeModelWavButton"
                                    AutomationProperties.Name="Transcribe a WAV file">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="ModelFolderMenuItem" Text="Model folder…" Click="ModelFolderClicked"
                                    AutomationProperties.AutomationId="ModelFolderButton"
                                    AutomationProperties.Name="Model folder and verification">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout></Button.Flyout>
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="ModelFolderFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="12" MaxWidth="380">
                            <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="FolderButton" Content="Choose folder" Click="ChooseFolderClicked"
                                        AutomationProperties.AutomationId="ChooseModelFolder"
                                        ToolTipService.ToolTip="Changing folders does not move or delete model files." />
                                <Button x:Name="RefreshButton" Content="Verify installed files" Click="RefreshClicked"
                                        IsEnabled="False" AutomationProperties.AutomationId="VerifyModelFiles" />
                            </StackPanel>
                            <TextBlock x:Name="BackendText" Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
        </local:PageCanvas.HeaderActions>
        <StackPanel Spacing="{StaticResource PageSectionSpacing}">
            <StackPanel x:Name="InUseSection" Spacing="{StaticResource SectionHeaderGap}" Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock Text="In use" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="The model that handles dictation, and the model that tells meeting speakers apart."
                               Style="{StaticResource CaptionSecondaryStyle}" />
                </StackPanel>
                <StackPanel x:Name="InUseRows" Spacing="8" />
            </StackPanel>
            <StackPanel x:Name="InstalledSection" Spacing="{StaticResource SectionHeaderGap}" Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock Text="Installed" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Ready on this device." Style="{StaticResource CaptionSecondaryStyle}" />
                </StackPanel>
                <StackPanel x:Name="InstalledRows" Spacing="8" />
            </StackPanel>
            <StackPanel x:Name="AvailableSection" Spacing="{StaticResource SectionHeaderGap}" Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock Text="Available" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Each download is checked before it is installed."
                               Style="{StaticResource CaptionSecondaryStyle}" />
                </StackPanel>
                <StackPanel x:Name="AvailableRows" Spacing="8" />
            </StackPanel>
        </StackPanel>
    </local:PageCanvas>
</Page>
