<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.ModelManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="24">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speech models" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <Button x:Name="FolderMenuButton" Grid.Column="1" MinHeight="40" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ModelFolderButton"
                        AutomationProperties.Name="Model folder and verification">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        <TextBlock Text="Model folder" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="12" MaxWidth="380">
                                <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="FolderButton" Content="Choose folder" Click="ChooseFolderClicked"
                                            MinHeight="40" AutomationProperties.AutomationId="ChooseModelFolder"
                                            ToolTipService.ToolTip="Changing folders does not move or delete model files." />
                                    <Button x:Name="RefreshButton" Content="Verify installed files" Click="RefreshClicked"
                                            MinHeight="40" AutomationProperties.AutomationId="VerifyModelFiles" />
                                </StackPanel>
                                <TextBlock x:Name="BackendText" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="False" />

            <local:StaggeredPanel x:Name="ModelsGrid" ColumnSpacing="16" RowSpacing="16"
                  SizeChanged="OnModelsGridSizeChanged" />

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
