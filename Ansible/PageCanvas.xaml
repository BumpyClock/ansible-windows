<UserControl x:Class="Ansible.PageCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ansible">
    <UserControl.Content>
        <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.AutomationId="PageViewport" SizeChanged="ViewportSizeChanged"
                      ViewChanged="ViewportViewChanged">
            <Grid x:Name="ContentHost" Padding="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ContentColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <local:PageHeaderPanel x:Name="HeaderLayout" Margin="{StaticResource PageSectionBottomMargin}"
                                       ColumnGap="{StaticResource CardGap}" SizeChanged="HeaderSizeChanged">
                    <TextBlock x:Name="TitleText" Text="{x:Bind Title, Mode=OneWay}" Margin="0,2"
                               Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="SubtitleText" Margin="0,4,0,0"
                               Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
                    <StackPanel x:Name="HeaderActionsPanel" Orientation="Horizontal" Spacing="8" />
                </local:PageHeaderPanel>
                <ContentControl x:Name="BodyHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" IsTabStop="False" />
            </Grid>
        </ScrollViewer>
    </UserControl.Content>
</UserControl>
