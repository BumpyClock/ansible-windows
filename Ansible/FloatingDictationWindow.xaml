<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Ansible.FloatingDictationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ansible preview">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Border x:Name="PreviewRoot"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Loaded="PreviewLoaded" SizeChanged="PreviewSizeChanged" ActualThemeChanged="ThemeChanged"
            Background="{ThemeResource PillBackgroundBrush}" BorderBrush="{ThemeResource AppTextBrush}">
        <!-- The native composition pill draws the visible overlay. This region-empty host sizes the
             window and resolves the theme text colour from BorderBrush for high-contrast drawing.
             Width, Height, and CornerRadius come from FloatingPreviewPresentation in code. -->
        <Border x:Name="PillBorder" Background="{ThemeResource PillBackdropFillBrush}"
                BorderBrush="{ThemeResource PillStrokeBrush}" BorderThickness="0"
                HorizontalAlignment="Center">
            <StackPanel x:Name="WaveBars" HorizontalAlignment="Center" Background="{ThemeResource PillWaveBrush}"
                        AutomationProperties.Name="Current real audio energy" />
        </Border>
    </Border>
</Window>
