<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Ansible.FloatingDictationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ansible preview">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Border x:Name="PreviewRoot"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Loaded="PreviewLoaded" SizeChanged="PreviewSizeChanged" ActualThemeChanged="ThemeChanged">
        <!-- The native composition pill draws the visible overlay. This region-empty host sizes the
             window and resolves the theme text colour from BorderBrush for high-contrast drawing. -->
        <Border x:Name="PillBorder" Width="220" Height="56" Background="Transparent"
                BorderBrush="{ThemeResource PrimaryTextBrush}" BorderThickness="0"
                CornerRadius="28" HorizontalAlignment="Center">
            <StackPanel x:Name="WaveBars" HorizontalAlignment="Center"
                        AutomationProperties.Name="Real audio energy history" />
        </Border>
    </Border>
</Window>
