<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Ansible.DictationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Ansible">
    <Page.Resources>
        <StaticResource x:Key="ProgressBarTrackHeight" ResourceKey="HomeModelTrackHeight" />
        <StaticResource x:Key="ProgressBarIndicatorHeight" ResourceKey="HomeModelTrackHeight" />
        <StaticResource x:Key="ProgressBarTrackCornerRadius" ResourceKey="HomeModelTrackCornerRadius" />
        <StaticResource x:Key="ProgressBarCornerRadius" ResourceKey="HomeModelTrackCornerRadius" />
    </Page.Resources>
    <local:PageCanvas x:Name="HomeViewport" SizeChanged="HomeViewportSizeChanged">
        <StackPanel Spacing="{StaticResource PageSectionSpacing}">
            <Grid x:Name="HomeHeader" ColumnSpacing="{StaticResource CardGap}" RowSpacing="12"
                  SizeChanged="HomeHeaderSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HomeHeading" Grid.Row="0" Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingText" Text="Good afternoon" Style="{StaticResource PageTitleStyle}"
                               Margin="0" />
                    <TextBlock Text="Your dictations, kept in memory on this device for this session."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Border x:Name="CompactDictateCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}"
                        VerticalAlignment="Center"
                        Padding="16,6,6,6" CornerRadius="{StaticResource PanelCornerRadius}">
                    <StackPanel Spacing="8">
                        <Grid x:Name="ShortcutControlGrid" ColumnSpacing="14" RowSpacing="8" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ShortcutHint" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="ShortcutModeText" Text="Hold" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                                <StackPanel x:Name="ShortcutKeys" Orientation="Horizontal" Spacing="4" />
                                <TextBlock x:Name="ShortcutTailText" Text="anywhere, or" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="ShortcutButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CompactDictateButton" Click="RecordClicked"
                                        Height="40" Padding="14,0" Style="{StaticResource AppPrimaryButtonStyle}"
                                        AutomationProperties.Name="Start dictation">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Width="17" Height="17" Stretch="Uniform" Fill="{ThemeResource AppOnAccentBrush}" Data="M6.90088 0.58789q-0.64258 0.02734-1.18262 0.38623-0.53662 0.35547-0.80322 0.92969-0.14014 0.28027-0.19824 0.54687-0.02734 0.0957-0.02735 0.4751l-0.01367 4.40918 0.04102 0.16748q0.19824 0.78613 0.75879 1.26123 0.43408 0.36572 1.02197 0.51953 0.10938 0.02734 0.1914 0.03418 0.08545 0.00684 0.31104 0.00684 0.28027 0 0.43408-0.02734 0.15381-0.02734 0.3794-0.1128 0.46143-0.16748 0.82373-0.52295 0.36572-0.35889 0.54687-0.83398 0.04102-0.12646 0.08545-0.29395l0.05469-0.1709 0-4.15625q0-0.48877-0.02734-0.68701-0.01367-0.12646-0.07178-0.29394l-0.01367-0.02735q-0.23584-0.70068-0.80323-1.13476-0.56738-0.43408-1.30908-0.4751l-0.19824 0z m0.33838 1.18945q0.29395 0.05811 0.52978 0.26661 0.23926 0.2085 0.32129 0.47509 0.04443 0.12646 0.06494 0.3042 0.02051 0.17432 0.00684 2.25928l0 1.77734q-0.01367 0.36572-0.02734 0.43409-0.08545 0.29395-0.31788 0.52636-0.229 0.229-0.52294 0.31446-0.11279 0.02734-0.29395 0.02734-0.18115 0-0.29395-0.02734-0.30762-0.08545-0.5332-0.31446-0.22217-0.23242-0.30762-0.52636-0.01367-0.06836-0.02734-0.43409l0-1.77734q-0.01367-2.08496 0-2.26953 0.04102-0.30762 0.19482-0.54346 0.19824-0.29395 0.52637-0.42724 0.32813-0.1333 0.68018-0.06495z m-4.46729 3.48633q-0.14014 0.04102-0.2666 0.16748-0.0957 0.08545-0.1333 0.17774-0.03418 0.08887-0.03418 0.31445-0.01367 0.18115 0 0.69727 0 0.61865 0.01367 0.83056 0.01367 0.2085 0.08545 0.51612 0.0957 0.4751 0.31104 0.96044 0.21875 0.48193 0.52636 0.88526 0.46484 0.60156 1.09375 1.03564 0.62891 0.43408 1.35694 0.646 0.40674 0.11279 0.63232 0.12646l0.05469 0.01368 0.01367 0.70068q0 0.41699 0.01367 0.52978 0 0.16748 0.02735 0.22559 0.03076 0.05469 0.11279 0.14014l0.01367 0.01367q0.16748 0.16748 0.40674 0.16748 0.23926 0 0.40674-0.16748l0.01367-0.01367q0.08203-0.08545 0.10938-0.14014 0.03076-0.05811 0.03076-0.22559 0.01367-0.11279 0.01367-0.52978l0.01367-0.70068 0.05469-0.01368q0.04443 0 0.22558-