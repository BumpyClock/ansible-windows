                                        <TextBlock x:Name="HomeStreakText" Text="--" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid x:Name="HomeHeatmapHost" SizeChanged="HomeHeatmapHostSizeChanged">
                            <Grid x:Name="HomeHeatmapGrid" ColumnSpacing="{StaticResource HomeActivityHeatmapGap}" RowSpacing="{StaticResource HomeActivityHeatmapGap}" HorizontalAlignment="Center"
                                      AutomationProperties.Name="Local session activity calendar" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="Less" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HomeLegendChipStyle}" />
                                <Border Style="{StaticResource HomeLegendLowChipStyle}" />
                                <Border Style="{StaticResource HomeLegendMediumChipStyle}" />
                                <Border Style="{StaticResource HomeLegendHighChipStyle}" />
                                <TextBlock Text="More" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HomeModelsCard" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="{StaticResource HomeModelsCardGap}">
                            <TextBlock Text="Sessions by model" Style="{StaticResource HomeCardTitleStyle}" />
                            <StackPanel x:Name="HomeModelRows" Spacing="{StaticResource HomeModelsCardGap}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
<Border x:Name="TranscriptCard" Style="{StaticResource CardStyle}" MinHeight="160" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="TranscriptHeader" ColumnSpacing="12" MinHeight="32" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transcript" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton" Grid.Column="1" Click="CopyClicked" MinHeight="32"
                                AutomationProperties.Name="Copy transcript">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock x:Name="CopyLabel" Text="Copy" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="96">
                        <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 MaxHeight="420" Style="{StaticResource TranscriptTextBoxStyle}"
                                 AutomationProperties.Name="Dictation transcript"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource ControlFillColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource ControlFillColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource ControlFillColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource ControlFillColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource ControlFillColorTransparent}" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </local:PageCanvas>
</Page>
