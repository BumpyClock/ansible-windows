                                        <TextBlock x:Name="CompactDictateLabel" Text="Dictate" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CompactCancelButton" Content="Cancel" Click="CancelClicked" MinHeight="40"
                                        Padding="12,0" Visibility="Collapsed" ToolTipService.ToolTip="Cancel (Esc)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Escape" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="CompactStatusPanel" Visibility="Collapsed" Spacing="2">
                            <Grid>
                                <TextBlock x:Name="CompactStatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CompactLiveText" HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionSecondaryStyle}" Visibility="Collapsed"
                                           AutomationProperties.Name="Elapsed time and words" />
                            </Grid>
                            <TextBlock x:Name="CompactStatusDetail" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" Visibility="Collapsed"
                     SizeChanged="StatusInfoSizeChanged"
                     Closing="StatusInfoClosing" Closed="StatusInfoClosed" />

            <Grid x:Name="HomeColumns" ColumnSpacing="{StaticResource HomeCardGap}" RowSpacing="{StaticResource HomeCardGap}" SizeChanged="HomeColumnsSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="HistoryCard" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HistoryHeader" Padding="{StaticResource HistoryHeaderPadding}" BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="0,0,0,1" VerticalAlignment="Center">
                            <Grid x:Name="HistoryHeaderGrid" ColumnSpacing="12" SizeChanged="HistoryHeaderSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource HistorySearchColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HistoryTitle" Text="History" VerticalAlignment="Center" Style="{StaticResource HomeCardTitleStyle}" />
                                <Border x:Name="HistoryCountPill" Grid.Column="1" Style="{StaticResource HistoryCountStyle}"
                                        ToolTipService.ToolTip="Completed dictations today in this app session.">
                                    <TextBlock x:Name="HistoryCount" Text="0 dictations today" VerticalAlignment="Center" TextWrapping="NoWrap" Style="{StaticResource CaptionSecondaryStyle}" />
                                </Border>
                                <TextBox x:Name="HistorySearchBox" Grid.Column="3" Height="36" PlaceholderText="Search transcripts"
                                         TextChanged="HistorySearchChanged" Padding="{StaticResource HistorySearchPadding}"
                                         FontSize="{StaticResource HistorySearchFontSize}" VerticalContentAlignment="Center"
                                         Background="{ThemeResource AppSearchBrush}"
                                         BorderBrush="{ThemeResource AppBorderBrush}" AutomationProperties.Name="Search transcripts">
                                    <TextBox.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="FocusHistorySearchInvoked" />
                                    </TextBox.KeyboardAccelerators>
                                </TextBox>
                                <FontIcon x:Name="HistorySearchIcon" Grid.Column="3" Glyph="&#xE721;"
                                          FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="12,0,0,0" IsHitTestVisible="False" />
                                <Border x:Name="HistorySearchShortcut" Grid.Column="3" Style="{StaticResource SearchKeycapStyle}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                    <TextBlock Text="Ctrl K" Style="{StaticResource SearchKeycapTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="HistoryRowsHost" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      VerticalContentAlignment="Stretch">
                            <StackPanel x:Name="HistoryRows" Padding="{StaticResource HistoryListPadding}" Spacing="4"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel x:Name="HomeInsightsColumn" Grid.Column="1" Spacing="{StaticResource HomeCardGap}"
                            VerticalAlignment="Top">
                    <Border x:Name="CompactInsightsCard" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="{StaticResource HomeStatsGap}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="Insights" VerticalAlignment="Center" Style="{StaticResource HomeCardTitleStyle}" />
                                <TextBlock Text="All time" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HomeCardMetaStyle}" />
                            </Grid>
                            <Grid x:Name="CompactStatsGrid" ColumnSpacing="{StaticResource HomeMetricColumnGap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="HomePaceText" Text="--" Style="{StaticResource MetricValueTextBlockStyle}" />
                                    <TextBlock Text="Words / min" Style="{StaticResource HomeMetricLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="HomeSessionsText" Text="--" Style="{StaticResource MetricValueTextBlockStyle}" />
                                    <TextBlock Text="Dictations" Style="{StaticResource HomeMetricLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock x:Name="HomeWordsText" Text="--" Style="{StaticResource MetricValueTextBlockStyle}" />
                                    <TextBlock Text="Words" Style="{StaticResource HomeMetricLabelStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="HomeInsightsFootnote" Text="No completed sessions yet."
                                       Style="{StaticResource HomeCardFootnoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="HomeActivityCard" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="Activity" VerticalAlignment="Center" Style="{StaticResource HomeCardTitleStyle}" />
                                <Border x:Name="HomeStreakPill" HorizontalAlignment="Right" Style="{StaticResource HomeActivityStreakStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{ThemeResource AccentGraphicBrush}"
