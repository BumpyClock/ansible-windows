<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.ModelManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="ModelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36" Spacing="24">
            <TextBlock Text="Speech models" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Choose what runs on your device." FontSize="18"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
            <InfoBar x:Name="StatusInfo" IsOpen="True" IsClosable="False"
                     Title="Opening the pinned catalog" Message="No model downloads start automatically." />
            <Border Style="{StaticResource ModelCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Model folder" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="FolderButton" Content="Choose folder" Click="ChooseFolderClicked" MinHeight="44" />
                        <Button x:Name="RefreshButton" Content="Verify installed files" Click="RefreshClicked" MinHeight="44" />
                    </StackPanel>
                    <TextBlock Text="Changing folders does not move or delete weights. Only verified, complete files become installed."
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            <ComboBox x:Name="CatalogBox" Header="Pinned model catalog" HorizontalAlignment="Stretch"
                      SelectionChanged="ModelChanged" AutomationProperties.Name="Pinned model catalog" />
            <Border x:Name="ModelCard" Style="{StaticResource ModelCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="CapabilitiesText" TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="SizeText" TextWrapping="Wrap" />
                    <TextBlock x:Name="StateText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100"
                                 AutomationProperties.Name="Model download progress" />
                    <TextBlock x:Name="ProgressText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="DownloadButton" Content="Download" Click="DownloadClicked"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="44" />
                        <Button x:Name="PauseButton" Content="Pause" Click="PauseClicked" MinHeight="44" />
                        <Button x:Name="RemoveButton" Content="Remove file" Click="RemoveClicked" MinHeight="44" />
                    </StackPanel>
                    <Button x:Name="DiscardButton" Content="Discard partial download" Click="DiscardClicked" MinHeight="44" />
                    <TextBlock Text="Dictation can continue during downloads. Installation waits for idle recognition. Pause retains resumable weights. No speech leaves your device."
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <Expander Header="License and integrity" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="LicenseText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="SourceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="IntegrityText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
