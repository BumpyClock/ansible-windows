<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.ModelManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1052" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="36,28,36,36" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Speech models" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Download verified models. One model is resident at a time."
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <Button x:Name="FolderMenuButton" Grid.Column="1" MinHeight="40" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ModelFolderButton"
                            AutomationProperties.Name="Model folder and verification">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="Model folder" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="12" MaxWidth="380">
                                    <TextBlock Text="Model folder" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="FolderButton" Content="Choose folder" Click="ChooseFolderClicked"
                                                MinHeight="40" AutomationProperties.AutomationId="ChooseModelFolder" />
                                        <Button x:Name="RefreshButton" Content="Verify installed files" Click="RefreshClicked"
                                                MinHeight="40" AutomationProperties.AutomationId="VerifyModelFiles" />
                                    </StackPanel>
                                    <TextBlock Text="Changing folders does not move or delete model files."
                                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <InfoBar x:Name="StatusInfo" IsOpen="True" IsClosable="False" Title="Opening model catalog" />

                <Grid x:Name="ModelsGrid" ColumnSpacing="16" RowSpacing="16"
                      SizeChanged="OnModelsGridSizeChanged" />

                <TextBlock Text="Memory values are admission estimates, not measured usage." FontSize="12"
                           TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
