<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.DictationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.45" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.45" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="0" Duration="0:0:1.6" />
        </Storyboard>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1052" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="36,28,36,36" Spacing="20">
                <TextBlock Text="Dictation" Style="{StaticResource PageTitleStyle}" />

                <Border Style="{StaticResource CardStyle}" Padding="28,24">
                    <Grid ColumnSpacing="24" RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Width="112" Height="112" VerticalAlignment="Center">
                            <Ellipse x:Name="PulseRing" Width="72" Height="72" Fill="{ThemeResource AccentGraphicBrush}"
                                     Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <ProgressRing x:Name="BusyRing" Width="88" Height="88" IsActive="False"
                                          Foreground="{ThemeResource AccentGraphicBrush}" IsHitTestVisible="False" />
                            <Button x:Name="RecordButton" Style="{StaticResource RecordButtonStyle}" Click="RecordClicked"
                                    AutomationProperties.Name="Start dictation" ToolTipService.ToolTip="Start dictation">
                                <FontIcon x:Name="RecordGlyph" Glyph="&#xE720;" FontSize="26" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="StatusTitle" Text="Preparing" Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="StatusDetail" Text="" TextWrapping="Wrap"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <Grid x:Name="LiveRow" Margin="0,8,0,0" ColumnSpacing="16" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ElapsedText" Text="00:00" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" AutomationProperties.Name="Elapsed time" />
                                <TextBlock x:Name="WordsText" Grid.Column="1" Text="Word count pending"
                                           VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" />
                                <StackPanel x:Name="LevelBars" Grid.Column="2" Orientation="Horizontal" Spacing="3"
                                            Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            AutomationProperties.Name="Microphone level history" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox x:Name="ModelBox" Header="Speech model" MinWidth="320" SelectionChanged="ModelChanged"
                                          PlaceholderText="No installed models" />
                                <TextBlock x:Name="ModelNote" TextWrapping="Wrap" VerticalAlignment="Bottom" MaxWidth="360"
                                           Margin="0,0,0,8" Visibility="Collapsed" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelClicked"
                                    VerticalAlignment="Bottom" MinHeight="32" />
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" Closing="StatusInfoClosing" />

                <Border Style="{StaticResource CardStyle}" Padding="24,20,24,24" MinHeight="280">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transcript" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="CopyButton" Grid.Column="1" Click="CopyClicked" MinHeight="32"
                                    AutomationProperties.Name="Copy transcript">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock x:Name="CopyLabel" Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" MinHeight="200">
                            <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     MaxHeight="420" Style="{StaticResource TranscriptTextBoxStyle}"
                                     AutomationProperties.Name="Dictation transcript"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <StackPanel x:Name="EmptyState" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" MaxWidth="360">
                                <FontIcon Glyph="&#xE8D2;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Nothing transcribed yet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Recognized text appears here. Transcripts stay in memory on this device."
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
