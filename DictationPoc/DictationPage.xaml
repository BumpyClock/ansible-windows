<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.DictationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36" Spacing="24">
            <TextBlock Text="Dictation" FontSize="28" FontWeight="SemiBold" />
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="20">
                    <ComboBox x:Name="ModelBox" Header="Speech model" HorizontalAlignment="Stretch" SelectionChanged="ModelChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RecordButton" Content="Start dictation" Click="RecordClicked"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="44" MinWidth="160" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked" MinHeight="44" />
                    </StackPanel>
                    <TextBlock x:Name="ModelNote" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="StatusInfo" IsOpen="True" IsClosable="False" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Transcript" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CopyButton" Grid.Column="1" Content="Copy transcript" Click="CopyClicked" />
            </Grid>
            <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     MinHeight="220" MaxHeight="360" FontSize="18"
                     AutomationProperties.Name="Dictation transcript" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Expander Header="Dictation help" AutomationProperties.AutomationId="DictationHelp"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="Start dictation records here without typing into another app."
                               TextWrapping="Wrap" />
                    <TextBlock Text="To insert speech in another app, use your dictation shortcut. Change the shortcut and activation mode in Settings."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
