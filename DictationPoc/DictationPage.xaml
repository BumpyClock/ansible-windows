<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.DictationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36" Spacing="24">
            <TextBlock Text="Dictation" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="A little less typing. A little more you."
                       FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Say what you have in mind." FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="A floating panel keeps your microphone level and actual transcript in view while the native model works."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <ComboBox x:Name="ModelBox" Header="Speech model" HorizontalAlignment="Stretch" SelectionChanged="ModelChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RecordButton" Content="Start dictation" Click="RecordClicked"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="44" MinWidth="160" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked" MinHeight="44" />
                    </StackPanel>
                    <TextBlock x:Name="ModelNote" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="StatusInfo" IsOpen="True" IsClosable="False" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Your words" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CopyButton" Grid.Column="1" Content="Copy transcript" Click="CopyClicked" />
            </Grid>
            <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     MinHeight="220" MaxHeight="360" FontSize="18" PlaceholderText="Your transcript appears here."
                     AutomationProperties.Name="Dictation transcript" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="Audio stays on this device. Automatic insertion and global hotkeys are not enabled in this POC."
                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
