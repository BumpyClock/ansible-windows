<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1052" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="36,28,36,36" Spacing="20">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

                <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" Closing="StatusInfoClosing" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Recognition" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Language hint" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Leave blank to use the model default."
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <TextBox x:Name="LanguageBox" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                     AutomationProperties.Name="Language hint" PlaceholderText="Model default"
                                     TextChanged="LanguageChanged" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Dictation shortcut" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Activation mode" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ToggleSwitch x:Name="PushToTalkToggle" Grid.Column="1" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="PushToTalkToggle"
                                              AutomationProperties.Name="Activation mode"
                                              OnContent="Hold to talk" OffContent="Press to start and stop"
                                              Toggled="DictationModeChanged" />
                            </Grid>
                            <Border Height="1" Margin="0,12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Shortcut" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Works in any app. Text is typed at the cursor."
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox x:Name="HotkeyCaptureBox" AutomationProperties.AutomationId="HotkeyCaptureBox"
                                             AutomationProperties.Name="Shortcut" MinWidth="200" MaxWidth="280"
                                             IsReadOnly="True" KeyDown="ShortcutKeyDown"
                                             KeyUp="ShortcutKeyUp"
                                             LostFocus="ShortcutLostFocus" />
                                    <Button x:Name="ChangeShortcutButton" AutomationProperties.AutomationId="ChangeShortcutButton"
                                            Content="Change shortcut" Click="ChangeShortcutClicked" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Custom dictionary" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Add one name, word, or phrase per line. Supported models use these as recognition hints, not replacement rules."
                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox x:Name="DictionaryBox" AutomationProperties.AutomationId="DictionaryBox"
                                     AutomationProperties.Name="Custom dictionary entries"
                                     ToolTipService.ToolTip="Up to 100 entries, 100 characters per entry, and 4 KB total. Save an empty list to clear it."
                                     PlaceholderText="Contoso&#x0a;WinUI&#x0a;audio.cpp"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="200"
                                     MaxLength="8192" TextChanged="DictionaryChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="SaveDictionaryButton" AutomationProperties.AutomationId="SaveDictionaryButton"
                                        Content="Save dictionary" Click="SaveDictionaryClicked" />
                                <TextBlock x:Name="DictionaryStatusText" Grid.Column="1" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Privacy" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid x:Name="UsageRow" ColumnSpacing="16" Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Usage statistics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Keeps session dates, model, word counts, and timing on this device. Never audio or text."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="UsageToggle" Grid.Column="1" VerticalAlignment="Center"
                                          AutomationProperties.Name="Usage statistics" Toggled="UsageToggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
