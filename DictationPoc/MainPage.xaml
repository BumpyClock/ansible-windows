<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32" Spacing="24">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
            <InfoBar x:Name="StatusInfo" IsOpen="True" IsClosable="False" />
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Recognition" FontSize="20" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelBox" Header="Speech model" HorizontalAlignment="Stretch"
                                  SelectionChanged="ModelChanged" PlaceholderText="No installed models" />
                        <TextBox x:Name="LanguageBox" Grid.Column="1" Header="Language hint" PlaceholderText="Model default"
                                 TextChanged="LanguageChanged" />
                    </Grid>
                    <Expander Header="Model details" AutomationProperties.AutomationId="ModelDetails"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ModelsFolderBox" Header="Model folder" IsReadOnly="True" />
                                <Button x:Name="ConnectButton" Grid.Column="1" Content="Load models" Click="ConnectClicked"
                                        VerticalAlignment="Bottom" MinHeight="36" />
                            </Grid>
                            <TextBlock Text="Change the folder in Speech models." TextWrapping="Wrap" />
                            <TextBlock x:Name="BackendText" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Custom dictionary" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Add one name, word, or phrase per line. Supported models use these as recognition hints, not replacement rules."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBox x:Name="DictionaryBox" AutomationProperties.AutomationId="DictionaryBox"
                             AutomationProperties.Name="Custom dictionary entries"
                             Header="Words and phrases" PlaceholderText="Contoso&#x0a;WinUI&#x0a;audio.cpp"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="200"
                             MaxLength="8192" TextChanged="DictionaryChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="DictionarySupportText" TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SaveDictionaryButton" AutomationProperties.AutomationId="SaveDictionaryButton"
                                Content="Save dictionary" Click="SaveDictionaryClicked" />
                        <TextBlock x:Name="DictionaryDraftText" Text="Unsaved dictionary changes"
                                   VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="Up to 100 entries, 100 characters per entry, and 4 KB total. Save an empty list to clear it."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dictation shortcut" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="PushToTalkToggle" AutomationProperties.AutomationId="PushToTalkToggle"
                                  Header="Activation mode" OnContent="Push-to-talk (hold)" OffContent="Toggle (press twice)"
                                  Toggled="DictationModeChanged" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyCaptureBox" AutomationProperties.AutomationId="HotkeyCaptureBox"
                                 Header="Shortcut" IsReadOnly="True" KeyDown="ShortcutKeyDown"
                                 KeyUp="ShortcutKeyUp"
                                 LostFocus="ShortcutLostFocus" />
                        <Button x:Name="ChangeShortcutButton" AutomationProperties.AutomationId="ChangeShortcutButton"
                                Grid.Column="1" Content="Change shortcut" Click="ChangeShortcutClicked" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock x:Name="ShortcutHint"
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock Text="Check the destination before dictating. Cancel cannot undo inserted text."
                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            <Expander Header="Recognition tools" AutomationProperties.AutomationId="RecognitionTools"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ModelNote" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RecordButton" Content="Start dictation" Click="RecordClicked"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="44" />
                        <Button x:Name="FileButton" Content="Transcribe WAV" Click="FileClicked" MinHeight="44" />
                        <Button x:Name="ReplayButton" Content="Replay WAV live" Click="ReplayClicked" MinHeight="44" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SampleButton" Content="Verify public sample" Click="SampleClicked" MinHeight="40" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked" MinHeight="40" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailsText" Text="0 words / 00:00" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SecondaryTextBrush}" />
                        <Button x:Name="CopyButton" Grid.Column="1" Content="Copy transcript" Click="CopyClicked" />
                    </Grid>
                    <TextBox x:Name="TranscriptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="180" MaxHeight="300" FontSize="16"
                             AutomationProperties.Name="Verification transcript"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Expander>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Privacy" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="UsageToggle" Header="Local usage statistics" Toggled="UsageToggled" />
                    <TextBlock Text="Save session dates, model IDs, word counts, and timing. Audio and transcripts are not saved."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="UsagePathText" FontSize="12" TextTrimming="CharacterEllipsis"
                               IsTextSelectionEnabled="True" Foreground="{ThemeResource SecondaryTextBrush}"
                               AutomationProperties.Name="Usage statistics file" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
