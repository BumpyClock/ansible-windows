<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1052" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="36,28,36,36" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Recognition, shortcut, dictionary, and privacy options."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" Closing="StatusInfoClosing" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Recognition" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Speech model" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="The model used for dictation and file transcription."
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ModelBox" Grid.Column="1" MinWidth="320" VerticalAlignment="Center"
                                          AutomationProperties.Name="Speech model"
                                          SelectionChanged="ModelChanged" PlaceholderText="No installed models" />
                            </Grid>
                            <Border Height="1" Margin="0,12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Language hint" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Leave blank to use the model default."
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <TextBox x:Name="LanguageBox" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                         AutomationProperties.Name="Language hint" PlaceholderText="Model default"
                                         TextChanged="LanguageChanged" />
                            </Grid>
                            <Border Height="1" Margin="0,12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Expander Header="Model details" AutomationProperties.AutomationId="ModelDetails"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
                                    <Thickness x:Key="ExpanderContentPadding">0,12,0,0</Thickness>
                                </Expander.Resources>
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ModelsFolderBox" Header="Model folder" IsReadOnly="True" />
                                        <Button x:Name="ConnectButton" Grid.Column="1" Content="Load models" Click="ConnectClicked"
                                                VerticalAlignment="Bottom" MinHeight="36" />
                                    </Grid>
                                    <TextBlock Text="Change the folder in Speech models." Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="BackendText" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Dictation shortcut" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Activation mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="On: hold the shortcut while you speak. Off: press it once to start and again to finish."
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PushToTalkToggle" Grid.Column="1" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="PushToTalkToggle"
                                              AutomationProperties.Name="Activation mode"
                                              OnContent="Push-to-talk (hold)" OffContent="Toggle (press twice)"
                                              Toggled="DictationModeChanged" />
                            </Grid>
                            <Border Height="1" Margin="0,12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Shortcut" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ShortcutHint" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox x:Name="HotkeyCaptureBox" AutomationProperties.AutomationId="HotkeyCaptureBox"
                                             AutomationProperties.Name="Shortcut" MinWidth="200" MaxWidth="280"
                                             IsReadOnly="True" KeyDown="ShortcutKeyDown"
                                             KeyUp="ShortcutKeyUp"
                                             LostFocus="ShortcutLostFocus" />
                                    <Button x:Name="ChangeShortcutButton" AutomationProperties.AutomationId="ChangeShortcutButton"
                                            Content="Change shortcut" Click="ChangeShortcutClicked" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Check the destination before dictating. Cancel cannot undo inserted text."
                                       Margin="0,16,0,0" Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Custom dictionary" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Add one name, word, or phrase per line. Supported models use these as recognition hints, not replacement rules."
                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox x:Name="DictionaryBox" AutomationProperties.AutomationId="DictionaryBox"
                                     AutomationProperties.Name="Custom dictionary entries"
                                     Header="Words and phrases" PlaceholderText="Contoso&#x0a;WinUI&#x0a;audio.cpp"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="200"
                                     MaxLength="8192" TextChanged="DictionaryChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="DictionarySupportText" Style="{StaticResource CaptionSecondaryStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="SaveDictionaryButton" AutomationProperties.AutomationId="SaveDictionaryButton"
                                        Content="Save dictionary" Click="SaveDictionaryClicked" />
                                <TextBlock x:Name="DictionaryDraftText" Text="Unsaved dictionary changes"
                                           VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="Up to 100 entries, 100 characters per entry, and 4 KB total. Save an empty list to clear it."
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Privacy" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Local usage statistics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Saves session dates, model IDs, word counts, and timing. Audio and transcripts are never saved."
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="UsageToggle" Grid.Column="1" VerticalAlignment="Center"
                                              AutomationProperties.Name="Local usage statistics" Toggled="UsageToggled" />
                            </Grid>
                            <TextBlock x:Name="UsagePathText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True" Style="{StaticResource CaptionSecondaryStyle}"
                                       AutomationProperties.Name="Usage statistics file" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Expander Header="Recognition tools" AutomationProperties.AutomationId="RecognitionTools"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="ModelNote" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="RecordButton" Content="Start dictation" Click="RecordClicked"
                                    Style="{StaticResource AccentButtonStyle}" MinHeight="44" />
                            <Button x:Name="FileButton" Content="Transcribe WAV" Click="FileClicked" MinHeight="44" />
                            <Button x:Name="ReplayButton" Content="Replay WAV live" Click="ReplayClicked" MinHeight="44" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SampleButton" Content="Verify public sample" Click="SampleClicked" MinHeight="40" />
                            <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked" MinHeight="40" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsText" Text="0 words / 00:00" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <Button x:Name="CopyButton" Grid.Column="1" Content="Copy transcript" Click="CopyClicked" />
                        </Grid>
                        <TextBox x:Name="TranscriptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="180" MaxHeight="300" FontSize="16"
                                 AutomationProperties.Name="Verification transcript"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
