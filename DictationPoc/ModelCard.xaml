<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="DictationPoc.ModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DictationPoc"
             HorizontalAlignment="Stretch">
    <Border x:Name="CardBorder" Style="{StaticResource CardStyle}" Padding="20">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="IconImage" Width="28" Height="28" Stretch="Uniform"
                               Visibility="Collapsed" ImageOpened="IconOpened" ImageFailed="IconFailed" />
                        <TextBlock x:Name="Monogram" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="VariantText" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock x:Name="BehaviorText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="LanguageText" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Download" Style="{StaticResource CaptionSecondaryStyle}" />
                    <TextBlock x:Name="DownloadSizeText" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Memory" Style="{StaticResource CaptionSecondaryStyle}"
                               ToolTipService.ToolTip="Admission estimate used before loading, not measured usage." />
                    <TextBlock x:Name="MemoryText" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="License" Style="{StaticResource CaptionSecondaryStyle}" />
                    <TextBlock x:Name="LicenseText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>


            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed"
                         AutomationProperties.Name="Model download progress" />
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Visibility="Collapsed"
                       Style="{StaticResource CaptionSecondaryStyle}" />

            <InfoBar x:Name="ErrorInfo" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="This model needs attention" />

            <local:ActionWrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                <Button x:Name="DiscardButton" Content="Discard" MinHeight="36" Click="DiscardClicked"
                        Visibility="Collapsed" />
                <Button x:Name="PauseButton" Content="Pause" MinHeight="36" Click="PauseClicked"
                        Visibility="Collapsed" />
                <Button x:Name="RemoveButton" Content="Remove" MinHeight="36" Click="RemoveClicked"
                        Visibility="Collapsed" />
                <Button x:Name="DetailsButton" Content="Details" MinHeight="36">
                    <Button.Flyout>
                        <Flyout>
                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" MaxWidth="360">
                                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CapabilityText" TextWrapping="Wrap" />
                                    <TextBlock Text="Pause keeps partial files for Resume. Dictation can continue during downloads; installation waits until dictation finishes."
                                               TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock x:Name="LicenseDetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="SourceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="IntegrityText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="UseButton" Content="Use" MinHeight="36" Click="UseClicked"
                        Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                <Button x:Name="PrimaryButton" Content="Download" MinHeight="36" Click="PrimaryClicked"
                        Style="{StaticResource AccentButtonStyle}" />
            </local:ActionWrapPanel>
        </StackPanel>
    </Border>
</UserControl>
