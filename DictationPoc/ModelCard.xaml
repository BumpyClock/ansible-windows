<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="DictationPoc.ModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DictationPoc"
             HorizontalAlignment="Stretch">
    <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="IconImage" Width="28" Height="28" Stretch="Uniform"
                               Visibility="Collapsed" ImageOpened="IconOpened" ImageFailed="IconFailed" />
                        <TextBlock x:Name="Monogram" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="VariantText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock x:Name="BehaviorText" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="LanguageText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel Spacing="2">
                    <TextBlock Text="Download" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="DownloadSizeText" FontSize="16" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Memory estimate" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="MemoryText" FontSize="16" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StateText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed"
                         AutomationProperties.Name="Model download progress" />
            <TextBlock x:Name="ProgressText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource SecondaryTextBrush}" />

            <InfoBar x:Name="ErrorInfo" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="This model needs attention" />

            <local:ActionWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                <Border MinHeight="40">
                    <TextBlock x:Name="LicenseText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </Border>
                <Button x:Name="DiscardButton" Content="Discard" MinHeight="40" Click="DiscardClicked"
                        Visibility="Collapsed" />
                <Button x:Name="PauseButton" Content="Pause" MinHeight="40" Click="PauseClicked"
                        Visibility="Collapsed" />
                <Button x:Name="RemoveButton" Content="Remove" MinHeight="40" Click="RemoveClicked"
                        Visibility="Collapsed" />
                <Button x:Name="DetailsButton" Content="Details" MinHeight="40">
                    <Button.Flyout>
                        <Flyout>
                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" MaxWidth="360">
                                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CapabilityText" TextWrapping="Wrap" />
                                    <TextBlock Text="Pause keeps partial files for Resume. Dictation can continue during downloads; installation waits until dictation finishes."
                                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="LicenseDetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="SourceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="IntegrityText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="PrimaryButton" Content="Download" MinHeight="40" Click="PrimaryClicked"
                        Style="{StaticResource AccentButtonStyle}" />
            </local:ActionWrapPanel>
        </StackPanel>
    </Border>
</UserControl>
