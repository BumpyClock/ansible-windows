<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DictationPoc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Local Voice">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Local Voice" Height="48" Background="Transparent">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE720;" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid Grid.Row="1" ColumnSpacing="16" Padding="16,8,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="Sidebar" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="12,8,8,32" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Border Width="4" Height="14" CornerRadius="2" Background="{ThemeResource AccentBrush}" />
                            <Border Width="4" Height="27" CornerRadius="2" Background="{ThemeResource AccentBrush}" />
                            <Border Width="4" Height="20" CornerRadius="2" Background="{ThemeResource AccentBrush}" />
                            <Border Width="4" Height="32" CornerRadius="2" Background="{ThemeResource AccentBrush}" />
                        </StackPanel>
                        <TextBlock Text="Local Voice" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button x:Name="InsightsNav" Tag="insights" Click="NavigateClicked" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE9D9;" FontSize="19" />
                            <TextBlock Text="Insights" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DictationNav" Tag="dictation" Click="NavigateClicked" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE720;" FontSize="19" />
                            <TextBlock Text="Dictation" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Tag="settings" Click="NavigateClicked" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE713;" FontSize="19" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModelsNav" Tag="models" Click="NavigateClicked" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE896;" FontSize="19" />
                            <TextBlock Text="Speech models" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SidebarStatus" Grid.Row="2" Text="Preparing speech models" FontSize="12"
                           Margin="12,16,12,0" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection>
                            <ContentThemeTransition HorizontalOffset="0" VerticalOffset="12" />
                        </TransitionCollection>
                    </ContentControl.ContentTransitions>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
