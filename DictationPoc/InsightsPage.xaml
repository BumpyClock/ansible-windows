<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DictationPoc.InsightsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1252" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="36,28,36,36" Spacing="20">
                <TextBlock Text="Insights" Style="{StaticResource PageTitleStyle}" />
                <InfoBar x:Name="UsageErrorBar" IsOpen="False" IsClosable="False" Severity="Warning" Visibility="Collapsed" />
                <TextBlock x:Name="IntroText" Visibility="Collapsed" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" />

                <Grid x:Name="SummaryGrid" ColumnSpacing="20" RowSpacing="20" SizeChanged="LayoutChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="PaceCard" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PaceText" Text="--" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Average words per minute" Style="{StaticResource CaptionSecondaryStyle}" />
                            <Grid Width="160" Height="100" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Path Stroke="{ThemeResource InactiveChartBrush}" StrokeThickness="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,78 A68,68 0 0 1 148,78" />
                                <Path x:Name="PaceArc" Stroke="{ThemeResource AccentGraphicBrush}" StrokeThickness="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Spacing="4">
                                    <TextBlock x:Name="PaceCaption" Text="No dictations yet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SessionsCard" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="SessionsText" Text="0" Style="{StaticResource TitleTextBlockStyle}"
                                       ToolTipService.ToolTip="Only completed sessions count." />
                            <TextBlock Text="Completed sessions" Style="{StaticResource CaptionSecondaryStyle}" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                            <TextBlock x:Name="DictationsText" Text="0 dictations" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="VerificationsText" Text="0 file verifications" Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WordsCard" Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="TotalWordsText" Text="0" Style="{StaticResource TitleTextBlockStyle}"
                                       ToolTipService.ToolTip="Excludes sessions with unknown word counts." />
                            <TextBlock Text="Recognized words" Style="{StaticResource CaptionSecondaryStyle}" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                            <Grid x:Name="WordsShareBar" Height="12" Margin="0,8,0,0" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="DictationShare" Width="*" /><ColumnDefinition x:Name="FileShare" Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource AccentGraphicBrush}" CornerRadius="4" />
                                <Border Grid.Column="1" Background="{ThemeResource AccentSoftBrush}" CornerRadius="4" />
                            </Grid>
                            <TextBlock x:Name="WordsSplitText" Text="No recognized words yet"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock x:Name="WordsCaveatText" Visibility="Collapsed" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DetailGrid" ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="ModelsCard" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Sessions by model" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       ToolTipService.ToolTip="Up to five models, ranked by completed sessions." />
                            <StackPanel x:Name="ModelRows" Spacing="16" MinHeight="160" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ActivityCard" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="StreakText" Text="0 day streak" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LongestText" Grid.Column="1" Text="Best: 0 days"
                                           VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" Margin="12,0,0,0" />
                            </Grid>
                            <Grid x:Name="HeatmapGrid" MinHeight="180" AutomationProperties.Name="Local session activity calendar" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Less" Style="{StaticResource CaptionSecondaryStyle}" Margin="0,0,8,0" />
                                <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource InactiveChartBrush}" />
                                <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource ActivityLowBrush}" />
                                <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource ActivityMediumBrush}" />
                                <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource AccentGraphicBrush}" />
                                <TextBlock Text="More" Style="{StaticResource CaptionSecondaryStyle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ActivityCaption" Text="No activity recorded yet." TextWrapping="Wrap"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
